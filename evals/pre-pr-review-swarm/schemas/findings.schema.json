{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "summary", "location", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "location": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
