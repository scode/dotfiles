{
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo build)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(dprint check:*)",
      "Bash(dprint fmt:*)",
      "Bash(gt add:*)",
      "Bash(gt create:*)",
      "Bash(gt log:*)",
      "Bash(gt restack:*)",
      "Bash(gt submit:*)",
      "Bash(gt sync:*)",
      "Skill(scode-graphite)"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "enabled": true
  }
}
