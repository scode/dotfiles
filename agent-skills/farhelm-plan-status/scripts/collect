#!/usr/bin/env -S deno run -A
// Read-only status collector for the farhelm plan queue: the queue on GitHub main, its recent events and claim times,
// and for the landing monitor and every executor slot the agent session driving it (Claude Code or Codex), whether a
// live process backs it, its turn state, the claims it mentions, and its latest messages and tool calls. Judgment is
// left to the reader.
//
// It never touches a checkout: queue state comes from GitHub main, session state from the harness transcripts under
// ~/.claude/projects and ~/.codex/sessions, and liveness from /proc. All times print in the host's local zone, and
// every claim and monitor round carries its elapsed time, so the report does no clock arithmetic of its own.
//
// Slots on other hosts: every agent-records commit names the slot that pushed it and, in a `Host: <login>@<tailnet
// name>` trailer, the machine it pushed from. The collector keeps a fetch-only clone of agent-records for itself, takes
// each slot's newest Host, and for a slot on another machine runs this same script there over ssh in `--slot` mode,
// printing that output as the slot's section. Its transcript paths then read `<login>@<host>:<path>`, so the reader
// knows to read them over ssh.
//
// Usage: collect            full report input
//        collect --states   one line per session with its state (no GitHub calls; for confirming a nudge took)
//        collect --slot <slot> [--claims <id>=<plan>,...] [--states]
//                           one slot's section only, for this host's own checkout of that slot (what the
//                           orchestrating collector runs over ssh on a remote slot's host)

import $ from "jsr:@david/dax@0.50.1";

const HOME = Deno.env.get("HOME")!;
/**
 * Where the checkouts live: executors are `~/git/farhelm-fh-exec-N`, and the landing (completion) monitor, which is not
 * an executor, is `~/git/farhelm-fh-complete-monitor`.
 */
const CHECKOUT_DIR = `${HOME}/git`;
const CHECKOUT_PREFIX = "farhelm-fh-";
const REPO = "scode/farhelm";
/**
 * The landing monitor's round log: its `landing` record in the monitor slot's clone of Farhelm's agent-records
 * repository, which on this host is the live copy (Farhelm's `.agents/agent-records.md`). It used to sit beside the
 * checkouts as `farhelm-plans-monitor-log.md`; only the file is read here, never git in the clone, which is the records
 * tool's.
 */
const MONITOR_LOG = `${HOME}/.fh-records/clones/landing/farhelm/landing/log.md`;
/**
 * The records tool's host files (Farhelm's `.agents/agent-records.md`, "Host files"): `config` names the records
 * remote, the repo token file and this host's slots and their checkouts.
 */
const RECORDS_CONFIG = `${HOME}/.fh-records/config`;
/**
 * This collector's own clone of agent-records: bare and fetch-only. Never a slot's clone, which belongs to the records
 * tool, and never pushed from.
 */
const STATUS_CLONE = `${HOME}/.fh-records/clones/status`;
/** A slot whose newest records commit is older than this is not looked for on another host (a retired VM, say). */
const HOST_WINDOW_DAYS = 7;
/** This script on a remote slot's host, where the dotfiles installer links the skill (expanded by the remote shell). */
const REMOTE_COLLECT = "~/.claude/skills/farhelm-plan-status/scripts/collect";
/** Only this much of a transcript's end is read; recent state is all the report needs. */
const TAIL_BYTES = 4 << 20;
/**
 * How far back the queue history is paged: far enough for a day of landings and for claim commits that a busy day has
 * pushed past the first page. One page is 100 commits, and a busy day writes about 200.
 */
const HISTORY_MS = 24 * 3600_000;
const MAX_HISTORY_PAGES = 5;

/** A harness session for one checkout. `live` means an interactive process of that harness runs in the checkout. */
type Session = { harness: "claude" | "codex"; id: string; path: string; mtime: Date; live: boolean };
type Procs = { claude: string[]; codex: Map<string, string[]> };

// ---- Formatting

const fmt = new Intl.DateTimeFormat("sv-SE", {
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hourCycle: "h23",
});
/** "MM-DD HH:MM" in the host's local zone, for an ISO timestamp or Date. */
export function local(t: string | Date): string {
  const p = Object.fromEntries(fmt.formatToParts(new Date(t)).map((x) => [x.type, x.value]));
  return `${p.month}-${p.day} ${p.hour}:${p.minute}`;
}
const zone = new Intl.DateTimeFormat("en-US", { timeZoneName: "short" }).formatToParts(new Date())
  .find((p) => p.type === "timeZoneName")?.value ?? "";
const oneLine = (s: string, n: number) => s.replace(/\s+/g, " ").trim().slice(0, n);

/** A duration as the report writes it: `13m`, `2h10m`, `1d3h`. Negative durations (clock skew) print as `0m`. */
export function elapsed(ms: number): string {
  const m = Math.max(0, Math.floor(ms / 60000));
  if (m < 60) return `${m}m`;
  if (m < 24 * 60) return `${Math.floor(m / 60)}h${String(m % 60).padStart(2, "0")}m`;
  return `${Math.floor(m / 1440)}d${Math.floor((m % 1440) / 60)}h`;
}
const since = (t: string | Date) => `${local(t)} (${elapsed(Date.now() - new Date(t).getTime())} ago)`;

// ---- Turn state and recent activity, per harness

function parse(lines: string[]): any[] {
  return lines.flatMap((l) => {
    try {
      return [JSON.parse(l)];
    } catch {
      return []; // the first line of a tail is usually cut mid-record
    }
  });
}

/**
 * State of a Codex session from its newest turn boundary: `running`, `idle`, `aborted at …`, `error=<kind> at …`, or
 * `unknown` when the tail holds no boundary. Codex does not retry a failed turn, so an error state means the executor
 * is stalled until something messages it.
 */
export function codexState(events: any[]): string {
  for (let i = events.length - 1; i >= 0; i--) {
    const e = events[i], t = e.payload?.type;
    if (e.type !== "event_msg") continue;
    if (t === "task_started") return "running";
    if (t === "turn_aborted") return `aborted at ${local(e.timestamp)}`;
    if (t !== "task_complete") continue;
    const info = e.payload?.error?.codex_error_info;
    if (!info) return "idle";
    return `error=${typeof info === "string" ? info : Object.keys(info)[0]} at ${local(e.timestamp)}`;
  }
  return "unknown";
}

/**
 * State of a Claude Code session from its newest user or assistant entry: `idle` after an end_turn reply,
 * `error=<kind> at …` after an API error reply, `aborted at …` after an Esc interrupt (Claude writes a user entry
 * "[Request interrupted by user…" and nothing more), `unknown` when the tail has no entry, and otherwise `running`.
 *
 * A compaction summary is not a turn boundary. Claude Code writes it as a user entry (`isCompactSummary`), and it also
 * compacts sessions that sit idle ("Compacted while idle, before the prompt cache expired"), so an executor waiting on
 * its queue watcher would otherwise read as `running` from then on. The state comes from the last entry before it.
 */
export function claudeState(events: any[]): string {
  const last = events.findLast((e) => (e.type === "user" && !e.isCompactSummary) || e.type === "assistant");
  if (!last) return "unknown";
  if (last.type === "user") {
    const c = last.message?.content;
    const text = typeof c === "string" ? c : (c ?? []).map((x: any) => x.text ?? "").join(" ");
    return text.startsWith("[Request interrupted by user") ? `aborted at ${local(last.timestamp)}` : "running";
  }
  if (last.isApiErrorMessage) return `error=${last.error ?? "api_error"} at ${local(last.timestamp)}`;
  return last.message?.stop_reason === "end_turn" ? "idle" : "running";
}

/** Latest assistant texts and tool calls, as "HH:MM text" lines. */
function recent(harness: Session["harness"], events: any[]): { messages: string[]; tools: string[] } {
  const messages: string[] = [], tools: string[] = [];
  for (const e of events) {
    const at = e.timestamp ? local(e.timestamp).slice(6) : "?";
    if (harness === "codex" && e.type === "response_item") {
      const p = e.payload;
      if (p.type === "message" && p.role === "assistant") {
        messages.push(`${at} ${oneLine(p.content.map((c: any) => c.text ?? "").join(" "), 400)}`);
      } else if (p.type === "function_call" || p.type === "custom_tool_call") {
        tools.push(`${at} ${p.name} ${oneLine(String(p.arguments ?? p.input ?? ""), 160)}`);
      }
    } else if (harness === "claude" && e.type === "assistant") {
      for (const c of e.message?.content ?? []) {
        if (c.type === "text" && c.text.trim()) messages.push(`${at} ${oneLine(c.text, 400)}`);
        if (c.type === "tool_use") {
          const i = c.input ?? {};
          tools.push(
            `${at} ${c.name} ${oneLine(String(i.description ?? i.command ?? i.prompt ?? JSON.stringify(i)), 160)}`,
          );
        }
      }
    }
  }
  return { messages: messages.slice(-4), tools: tools.slice(-3) };
}

// ---- Finding sessions and processes

/** The last `bytes` of a file (all of it for Infinity), split into lines. */
async function readTail(path: string, bytes = TAIL_BYTES): Promise<string[]> {
  using f = await Deno.open(path);
  const size = (await f.stat()).size;
  await f.seek(Math.max(0, size - Math.min(bytes, size)), Deno.SeekMode.Start);
  const buf = new Uint8Array(Math.min(bytes, size));
  let off = 0;
  for (let n; off < buf.length && (n = await f.read(buf.subarray(off))) !== null;) off += n;
  return new TextDecoder().decode(buf.subarray(0, off)).split("\n");
}

/** A file's first line, read in chunks: Codex's session_meta line embeds the instructions and can run to megabytes. */
async function firstLine(path: string): Promise<string> {
  using f = await Deno.open(path);
  const chunks: Uint8Array<ArrayBuffer>[] = [];
  for (let total = 0; total < 32 << 20;) {
    const buf = new Uint8Array(1 << 20);
    const n = await f.read(buf);
    if (n === null) break;
    const nl = buf.subarray(0, n).indexOf(10);
    chunks.push(buf.subarray(0, nl < 0 ? n : nl));
    total += n;
    if (nl >= 0) break;
  }
  return new TextDecoder().decode(await new Blob(chunks).bytes());
}

/** A Codex rollout's session_meta payload, or undefined when the file is gone or still being written. */
async function codexMeta(path: string): Promise<any> {
  try {
    return JSON.parse(await firstLine(path)).payload ?? {};
  } catch (e) {
    if (e instanceof SyntaxError || e instanceof Deno.errors.NotFound) return undefined;
    throw e;
  }
}

/** Claude Code's project directory for a cwd: it replaces every character other than a letter or digit with `-`. */
export function claudeProjectDir(cwd: string): string {
  return `${HOME}/.claude/projects/${cwd.replace(/[^a-zA-Z0-9]/g, "-")}`;
}

/**
 * The newest interactive Claude Code session for a checkout, by last write; `claude -p` delegates (entrypoint
 * sdk-cli) share the directory and are skipped. Claude does not hold its transcript open, so unlike Codex a live
 * process cannot be tied to one file; a short side session started in the checkout would win here.
 */
async function claudeSession(cwd: string, live: boolean): Promise<Session | undefined> {
  const dir = claudeProjectDir(cwd);
  const files: { path: string; mtime: Date }[] = [];
  try {
    for await (const d of Deno.readDir(dir)) {
      if (!d.name.endsWith(".jsonl")) continue;
      try {
        files.push({ path: `${dir}/${d.name}`, mtime: (await Deno.stat(`${dir}/${d.name}`)).mtime! });
      } catch (e) {
        if (!(e instanceof Deno.errors.NotFound)) throw e;
      }
    }
  } catch (e) {
    if (e instanceof Deno.errors.NotFound) return undefined;
    throw e;
  }
  for (const f of files.sort((a, b) => b.mtime.getTime() - a.mtime.getTime())) {
    let text;
    try {
      using h = await Deno.open(f.path);
      const head = new Uint8Array(256 << 10);
      text = new TextDecoder().decode(head.subarray(0, (await h.read(head)) ?? 0));
    } catch (e) {
      if (e instanceof Deno.errors.NotFound) continue;
      throw e;
    }
    if (parse(text.split("\n")).find((e) => e.entrypoint)?.entrypoint !== "cli") continue;
    return {
      harness: "claude",
      id: f.path.split("/").pop()!.replace(/\.jsonl$/, ""),
      path: f.path,
      mtime: f.mtime,
      live,
    };
  }
}

/**
 * Codex sessions for a checkout. A live interactive Codex process holds its own rollout open, so its sessions are read
 * from /proc/<pid>/fd whatever their age; sub-agent rollouts it also holds carry a non-"cli" source and are skipped.
 * Only without a live process does this fall back to the newest-started interactive rollout of the last four days,
 * which is then marked not live.
 */
async function codexSessions(cwd: string, procs: Procs, recentByCwd: Map<string, string>): Promise<Session[]> {
  const out: Session[] = [];
  for (const paths of procs.codex.values()) {
    for (const path of paths) {
      const meta = await codexMeta(path);
      if (meta?.source !== "cli" || meta.cwd !== cwd || out.some((s) => s.id === meta.id)) continue;
      out.push({ harness: "codex", id: meta.id, path, mtime: (await Deno.stat(path)).mtime!, live: true });
    }
  }
  const fallback = recentByCwd.get(cwd);
  if (out.length === 0 && fallback) {
    const meta = await codexMeta(fallback);
    if (meta) {
      out.push({
        harness: "codex",
        id: meta.id,
        path: fallback,
        mtime: (await Deno.stat(fallback)).mtime!,
        live: false,
      });
    }
  }
  return out;
}

/** Newest-started interactive Codex rollout per cwd among rollouts written in the last four days. */
async function recentCodexRollouts(): Promise<Map<string, string>> {
  const best = new Map<string, { path: string; started: string }>();
  const cutoff = Date.now() - 4 * 86400_000;
  async function* walk(dir: string): AsyncGenerator<string> {
    let entries;
    try {
      entries = await Array.fromAsync(Deno.readDir(dir));
    } catch (e) {
      if (e instanceof Deno.errors.NotFound) return;
      throw e;
    }
    for (const d of entries) {
      if (d.isDirectory) yield* walk(`${dir}/${d.name}`);
      else if (d.name.startsWith("rollout-") && d.name.endsWith(".jsonl")) yield `${dir}/${d.name}`;
    }
  }
  for await (const path of walk(`${HOME}/.codex/sessions`)) {
    let mtime;
    try {
      mtime = (await Deno.stat(path)).mtime!;
    } catch (e) {
      if (e instanceof Deno.errors.NotFound) continue;
      throw e;
    }
    if (mtime.getTime() < cutoff) continue;
    const meta = await codexMeta(path);
    if (meta?.source !== "cli" || !meta.cwd) continue;
    const prev = best.get(meta.cwd);
    if (!prev || prev.started < meta.timestamp) best.set(meta.cwd, { path, started: meta.timestamp });
  }
  return new Map([...best].map(([cwd, v]) => [cwd, v.path]));
}

/** Whether an agent process's argv is a one-shot delegate or service rather than an interactive worker. */
export function isDelegate(comm: string, argv: string[]): boolean {
  if (comm === "claude") return argv.includes("-p") || argv.includes("--print");
  return argv.slice(1).some((a) => a === "exec" || a === "app-server" || a === "mcp-server");
}

/** Live interactive agent processes whose cwd is the checkout, with the Codex rollouts each holds open. */
async function liveProcs(cwd: string): Promise<Procs> {
  const res: Procs = { claude: [], codex: new Map() };
  for await (const d of Deno.readDir("/proc")) {
    if (!/^\d+$/.test(d.name)) continue;
    try {
      const comm = (await Deno.readTextFile(`/proc/${d.name}/comm`)).trim();
      if ((comm !== "claude" && comm !== "codex") || (await Deno.readLink(`/proc/${d.name}/cwd`)) !== cwd) continue;
      if (isDelegate(comm, (await Deno.readTextFile(`/proc/${d.name}/cmdline`)).split("\0"))) continue;
      if (comm === "claude") {
        res.claude.push(d.name);
        continue;
      }
      const rollouts: string[] = [];
      for await (const fd of Deno.readDir(`/proc/${d.name}/fd`)) {
        const target = await Deno.readLink(`/proc/${d.name}/fd/${fd.name}`).catch(() => "");
        if (/\/rollout-[^/]*\.jsonl$/.test(target)) rollouts.push(target);
      }
      res.codex.set(d.name, rollouts);
    } catch {
      continue; // the process exited meanwhile or belongs to another user
    }
  }
  return res;
}

// ---- Slots on other hosts

/**
 * The tailnet DNS name from `tailscale status --self --json` output, without its trailing dot, or undefined. This, not
 * the OS hostname, is what ssh over the tailnet reaches (Tailscale may suffix `-1`, or the machine be renamed in the
 * admin console), and it is what Farhelm's records tool writes into the `Host:` trailer.
 */
export function tailnetName(json: string): string | undefined {
  try {
    const name = JSON.parse(json)?.Self?.DNSName;
    if (typeof name !== "string" || !/^[A-Za-z0-9._-]+\.?$/.test(name)) return undefined;
    return name.replace(/\.$/, "") || undefined;
  } catch {
    return undefined;
  }
}

/** This machine as a `Host:` trailer names it (`<login>@<tailnet name>`), or undefined without a login or Tailscale. */
async function localIdentity(): Promise<string | undefined> {
  const login = Deno.env.get("USER") ?? Deno.env.get("LOGNAME");
  if (!login) return undefined;
  const out = await $`tailscale status --self --json`.stdout("piped").stderr("null").noThrow().timeout("5s");
  const name = out.code === 0 ? tailnetName(out.stdout) : undefined;
  return name ? `${login}@${name}` : undefined;
}

/** The `[[slot]]` entries of a records config, as slot name -> checkout path. Only the keys this script reads. */
export function configSlots(config: string): Map<string, string> {
  const out = new Map<string, string>();
  for (const block of config.split(/^\[\[slot\]\]\s*$/m).slice(1)) {
    const name = block.match(/^name\s*=\s*"([^"]+)"/m)?.[1];
    const checkout = block.match(/^checkout\s*=\s*"([^"]+)"/m)?.[1];
    if (name && checkout) out.set(name, checkout);
  }
  return out;
}

/** Where a slot last pushed from: its newest commit's `Host:` trailer (undefined when that commit has none). */
type SlotHost = { host?: string; at: string };

/**
 * Each slot's newest commit, from `git log` lines of `<Slot>\x1f<Host>\x1f<committer date>`, newest first. Only the
 * newest commit counts: a slot moved to another machine names its new host on its first push there, and a slot whose
 * newest commit has no Host (pushed by a records tool from before the trailer) has no known host.
 */
export function slotHosts(lines: string[]): Map<string, SlotHost> {
  const out = new Map<string, SlotHost>();
  for (const line of lines) {
    const [slot, host, at] = line.split("\x1f");
    if (!slot || !at || out.has(slot)) continue;
    out.set(slot, { host: /^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$/.test(host) ? host : undefined, at });
  }
  return out;
}

/**
 * Brings this collector's clone of agent-records up to date and returns each recently active slot's newest host, or an
 * error line. The repo token goes to git as an `Authorization: Bearer` header in the child's environment, the way the
 * records tool sends it, so it never reaches a command line or the clone's config; error text is cut short and has the
 * account id (the remote URL's 32-hex label) redacted.
 */
async function recordHosts(): Promise<Map<string, SlotHost> | string> {
  let config;
  try {
    config = await Deno.readTextFile(RECORDS_CONFIG);
  } catch (e) {
    if (e instanceof Deno.errors.NotFound) return `no ${RECORDS_CONFIG.replace(HOME, "~")}`;
    throw e;
  }
  const remote = config.match(/^remote\s*=\s*"([^"]+)"/m)?.[1];
  const tokenFile = config.match(/^token_file\s*=\s*"([^"]+)"/m)?.[1];
  if (!remote || !tokenFile) return "records config has no remote or token_file";
  const token = (await Deno.readTextFile(tokenFile)).trim();
  const env = {
    GIT_CONFIG_NOSYSTEM: "1",
    GIT_CONFIG_COUNT: "1",
    GIT_CONFIG_KEY_0: "http.extraHeader",
    GIT_CONFIG_VALUE_0: `Authorization: Bearer ${token}`,
    GIT_TERMINAL_PROMPT: "0",
  };
  const redact = (s: string) =>
    oneLine(s.replaceAll(remote, "<records remote>").replace(/[0-9a-f]{32}/g, "<acct>"), 200);
  const exists = await Deno.stat(`${STATUS_CLONE}/HEAD`).then(() => true, () => false);
  const sync = exists
    ? $`git -C ${STATUS_CLONE} fetch -q ${remote} +refs/heads/main:refs/heads/main`
    : $`git clone -q --bare ${remote} ${STATUS_CLONE}`;
  const r = await sync.env(env).stdout("null").stderr("piped").noThrow().timeout("60s");
  if (r.code !== 0) return `records fetch failed: ${redact(r.stderr)}`;
  const log = await $`git -C ${STATUS_CLONE} log --since=${`${HOST_WINDOW_DAYS}.days`} ${
    "--format=%(trailers:key=Slot,valueonly,separator=)%x1f%(trailers:key=Host,valueonly,separator=)%x1f%cI"
  } main`.stdout("piped").stderr("piped").noThrow();
  if (log.code !== 0) return `records log failed: ${redact(log.stderr)}`;
  return slotHosts(log.stdout.split("\n"));
}

/**
 * Runs this script on a remote slot's host for that slot alone and returns its output. ssh never prompts (BatchMode),
 * so an unreachable or unauthorized host fails fast instead of hanging the report.
 */
async function collectRemote(
  slot: string,
  host: string,
  claims: Map<string, string>,
  statesOnly: boolean,
): Promise<string> {
  const claimArg = [...claims].map(([id, plan]) => `${id}=${plan}`).join(",");
  const cmd = [
    REMOTE_COLLECT,
    "--slot",
    slot,
    ...(claimArg ? ["--claims", claimArg] : []),
    ...(statesOnly ? ["--states"] : []),
  ].join(" ");
  const r = await $`ssh -o BatchMode=yes -o ConnectTimeout=10 ${host} ${cmd}`.stdout("piped").stderr("piped").noThrow()
    .timeout("120s");
  const out = r.stdout.trimEnd();
  if (r.code === 0) return out;
  const failed = `${slot} remote collection on ${host} failed (exit ${r.code}): ${oneLine(r.stderr, 300)}`;
  return out ? `${out}\n${failed}` : statesOnly ? failed : `\n######## ${slot}\n${failed}`;
}

/** `--claims` as the orchestrating collector passes it; malformed pairs are dropped rather than trusted. */
export function parseClaims(arg: string | undefined): Map<string, string> {
  const out = new Map<string, string>();
  for (const pair of (arg ?? "").split(",")) {
    const m = pair.match(/^([0-9a-f]{6,})=([A-Za-z0-9._-]+)$/);
    if (m) out.set(m[1], m[2]);
  }
  return out;
}

// ---- Queue on GitHub main

/** In-flight or landing claims from INDEX.md lines, as claim id -> plan name. */
export function activeClaims(index: string): Map<string, string> {
  const out = new Map<string, string>();
  for (const m of index.matchAll(/^- \[(?:in-flight|landing) ([0-9a-f]{6,})\] `([^`]+)\.md`/gm)) out.set(m[1], m[2]);
  return out;
}

/** A queue commit as GitHub's commit list returns it, reduced to what the report reads. */
type QueueCommit = { commit: { message: string; committer: { date: string } } };

/** The commit that claimed `plan` under claim id `id`, if the fetched history reaches back that far. */
function claimCommit(commits: QueueCommit[], id: string, plan: string): QueueCommit | undefined {
  return commits.find((c) => c.commit.message.includes(`claim ${plan}`) && c.commit.message.includes(id));
}

/**
 * Landings recorded at or after `sinceMs`, newest first, read from the monitor's "record the landing of <plan>" queue
 * commits. A plan counts when its landing is recorded, not when its PRs merge, which is what the queue shows too.
 */
export function landings(commits: QueueCommit[], sinceMs: number): { at: string; plan: string }[] {
  return commits.flatMap((c) => {
    const m = c.commit.message.match(/^chore\(plans\): record the landing of (\S+)/);
    return m && new Date(c.commit.committer.date).getTime() >= sinceMs
      ? [{ at: c.commit.committer.date, plan: m[1] }]
      : [];
  });
}

/** Prints the queue and its recent events; returns the active claims, or an empty map when GitHub is unreachable. */
async function printQueue(): Promise<Map<string, string>> {
  try {
    const index = await $`gh api repos/${REPO}/contents/plans/queue/INDEX.md -H ${"Accept: application/vnd.github.raw"}`
      .text();
    const claims = activeClaims(index);
    // Page back until the history covers both the last day and every active claim's commit; a claim from a long-running
    // plan can sit hundreds of commits deep on a busy day.
    const cutoff = Date.now() - HISTORY_MS;
    const commits: QueueCommit[] = [];
    for (let page = 1; page <= MAX_HISTORY_PAGES; page++) {
      const batch: QueueCommit[] =
        await $`gh api ${`repos/${REPO}/commits?path=plans/queue/INDEX.md&per_page=100&page=${page}`}`.json();
      commits.push(...batch);
      const oldest = commits.at(-1);
      const coversDay = !oldest || new Date(oldest.commit.committer.date).getTime() < cutoff;
      if (batch.length < 100 || (coversDay && [...claims].every(([id, plan]) => claimCommit(commits, id, plan)))) break;
    }
    console.log("== QUEUE (main)");
    for (const l of index.split("\n")) if (l.startsWith("- [")) console.log(oneLine(l, 220));
    console.log("== ACTIVE CLAIMS (claim time)");
    for (const [id, plan] of claims) {
      const c = claimCommit(commits, id, plan);
      console.log(`${id} ${plan} claimed ${c ? since(c.commit.committer.date) : "before the fetched queue history"}`);
    }
    console.log("== QUEUE EVENTS (newest first)");
    for (const c of commits.slice(0, 15)) {
      console.log(`${local(c.commit.committer.date)} ${c.commit.message.split("\n")[0]}`);
    }
    const midnight = new Date();
    midnight.setHours(0, 0, 0, 0);
    const day = landings(commits, cutoff);
    const today = landings(commits, midnight.getTime()).length;
    console.log(`== LANDINGS (last 24h: ${day.length}, since local midnight: ${today}; newest first)`);
    for (const l of day) console.log(`${local(l.at)} ${l.plan}`);
    return claims;
  } catch (e) {
    console.log(`== QUEUE unavailable: ${oneLine(String(e), 300)}`);
    return new Map();
  }
}

// ---- Main

/** A checkout to report on; the monitor's carries the path of its round log. */
type Checkout = { label: string; cwd: string; log?: string };

/**
 * The landing monitor's checkout, if there is one, then every executor checkout in number order. The monitor is
 * reported first and labelled `landing`: it lands completed plans and never claims one, so it is not an executor.
 */
async function checkouts(): Promise<Checkout[]> {
  let names: string[];
  try {
    names = (await Array.fromAsync(Deno.readDir(CHECKOUT_DIR))).map((d) => d.name);
  } catch (e) {
    if (e instanceof Deno.errors.NotFound) return [];
    throw e;
  }
  const monitors: Checkout[] = names.includes(`${CHECKOUT_PREFIX}complete-monitor`)
    ? [{
      label: "landing",
      cwd: `${CHECKOUT_DIR}/${CHECKOUT_PREFIX}complete-monitor`,
      log: MONITOR_LOG,
    }]
    : [];
  const execs = names.flatMap((name) => {
    const m = name.match(new RegExp(`^${CHECKOUT_PREFIX}exec-(\\d+)$`));
    return m ? [{ label: `exec-${m[1]}`, cwd: `${CHECKOUT_DIR}/${name}`, n: Number(m[1]) }] : [];
  });
  return [...monitors, ...execs.sort((a, b) => a.n - b.n)];
}

/**
 * The landing monitor's current round from its log: the newest `rN start`/`rN started` or `rN end`/`rN ended`/`rN done`
 * entry. Farhelm's `landing.py` now writes `rN started, head <sha>` and `rN ended` itself.
 * The log's wording has drifted between those forms, so both are accepted. A round whose newest entry is a start is
 * still under way; otherwise the monitor is between rounds. Undefined when no round entry is in the log.
 */
export function monitorRound(lines: string[]): { round: number; underway: boolean; at: string } | undefined {
  for (let i = lines.length - 1; i >= 0; i--) {
    const m = lines[i].match(/^- (\S+): (?:- )?r(\d+) (start|started|end|ended|done)\b/);
    if (m) return { round: Number(m[2]), underway: m[3].startsWith("start"), at: m[1] };
  }
}

/** The sessions worth showing: every live one, else only the most recently written candidate (marked not live). */
export function driving(found: Session[]): Session[] {
  const live = found.filter((s) => s.live);
  return live.length > 0 ? live : found.sort((a, b) => b.mtime.getTime() - a.mtime.getTime()).slice(0, 1);
}

/** Where a slot is reported from: a checkout on this host, another host over ssh, or nowhere known. */
export type Placement =
  | { label: string; kind: "local"; checkout: Checkout }
  | { label: string; kind: "remote"; host: string }
  | { label: string; kind: "unknown"; at: string };

/** Report order: the landing monitor, then executors by number, then anything else by name. */
function slotOrder(label: string): [number, number, string] {
  if (label === "landing") return [0, 0, label];
  const m = label.match(/^exec-(\d+)$/);
  return m ? [1, Number(m[1]), label] : [2, 0, label];
}

/**
 * Decides where each slot is reported from. A slot's newest records commit names its current host. When that host is
 * another machine, the slot is collected there, even if an old checkout of it is still here (the slot moved). A local
 * checkout is otherwise reported locally, including when the records say nothing (no Host yet, records unavailable, or
 * this host's own name unknown, which makes "another machine" undecidable). A slot recently active in the records with
 * no local checkout and no Host is listed as unknown, so the report says so instead of leaving it out.
 */
export function placements(
  local: Checkout[],
  hosts: Map<string, SlotHost>,
  me: string | undefined,
): Placement[] {
  const out = new Map<string, Placement>();
  for (const c of local) out.set(c.label, { label: c.label, kind: "local", checkout: c });
  for (const [label, { host, at }] of hosts) {
    if (!/^[a-z0-9][a-z0-9-]*$/.test(label)) continue; // a slot name goes into the remote shell command
    const elsewhere = host !== undefined && host !== me && (me !== undefined || !out.has(label));
    if (elsewhere) out.set(label, { label, kind: "remote", host });
    else if (!out.has(label) && host === undefined) out.set(label, { label, kind: "unknown", at });
  }
  return [...out.values()].sort((a, b) => {
    const [x, y] = [slotOrder(a.label), slotOrder(b.label)];
    return x[0] - y[0] || x[1] - y[1] || x[2].localeCompare(y[2]);
  });
}

/**
 * Prints one checkout's section: its live processes, the sessions driving it with state, claim mentions and recent
 * activity, and for the monitor its round. `where` is set when this runs on a slot's remote host for the orchestrating
 * collector: transcript paths then print as `<where>:<absolute path>` so the reader reads them over ssh.
 */
async function report(
  { label, cwd, log: monitorLog }: Checkout,
  claims: Map<string, string>,
  statesOnly: boolean,
  recentCodex: Map<string, string>,
  where?: string,
) {
  const procs = await liveProcs(cwd);
  const claude = await claudeSession(cwd, procs.claude.length > 0);
  const found = [...(claude ? [claude] : []), ...await codexSessions(cwd, procs, recentCodex)];
  const shown = (p: string) => where ? `${where}:${p}` : p.replace(HOME, "~");
  if (!statesOnly) {
    const role = monitorLog ? " (completion monitor, not an executor)" : "";
    console.log(`\n######## ${label}${role}  ${shown(cwd)}`);
    console.log(
      `live: claude pids ${procs.claude.join(" ") || "none"} | codex pids ${
        [...procs.codex.keys()].join(" ") || "none"
      }`,
    );
  }
  if (found.length === 0) console.log(`${statesOnly ? `${label} ` : ""}no session found`);
  for (const s of driving(found)) {
    // A long turn can push its own start out of the default tail; read the whole file before calling it unknown.
    const stateOf = (ev: any[]) => s.harness === "codex" ? codexState(ev) : claudeState(ev);
    const tail = await readTail(s.path);
    const events = parse(tail);
    let state = stateOf(events);
    if (state === "unknown") {
      state = stateOf(parse(await readTail(s.path, Infinity)));
    }
    const ago = Math.round((Date.now() - s.mtime.getTime()) / 60000);
    const liveness = s.live ? "live" : "NO LIVE PROCESS";
    console.log(
      `${statesOnly ? `${label} ` : ""}[${s.harness}] ${s.id} state=${state} ${liveness} last write ${ago}m ago`,
    );
    if (statesOnly) continue;
    console.log(`transcript ${shown(s.path)}`);
    // Other executors name a claim in passing ("another executor holds …"); its owner names it constantly. Counted over
    // the same fixed tail for every session, so the counts compare.
    const text = tail.join("\n");
    const held = [...claims].map(([id, plan]) => [`${id} (${plan})`, text.split(id).length - 1] as const)
      .filter(([, n]) => n > 0).map(([c, n]) => `${c} x${n}`);
    if (held.length > 0) console.log(`mentions active claims: ${held.join(", ")}`);
    const r = recent(s.harness, events);
    for (const m of r.messages) console.log(`  msg ${m}`);
    for (const t of r.tools) console.log(`  tool ${t}`);
  }
  if (!statesOnly && monitorLog) {
    try {
      const log = (await Deno.readTextFile(monitorLog)).split("\n").filter((l) => l.startsWith("- "));
      const r = monitorRound(log);
      if (r) console.log(`round r${r.round} ${r.underway ? "started" : "ended"} ${since(r.at)}`);
      for (const l of log.slice(-4)) console.log(`  log ${oneLine(l, 700)}`);
    } catch (e) {
      if (!(e instanceof Deno.errors.NotFound)) throw e;
      // Said out loud rather than skipped: the landing clone exists only once the landing slot has used the records
      // tool, and a silently missing round line would read as "between rounds".
      console.log(`monitor log not found: ${shown(monitorLog)}`);
    }
  }
}

/**
 * `--slot` mode, run over ssh by the orchestrating collector: this host's checkout of one slot, found in the records
 * config (or among the usual checkout names when the config does not list it).
 */
async function slotMode(slot: string, claims: Map<string, string>, statesOnly: boolean) {
  const me = await localIdentity();
  let cwd: string | undefined;
  try {
    cwd = configSlots(await Deno.readTextFile(RECORDS_CONFIG)).get(slot);
  } catch (e) {
    if (!(e instanceof Deno.errors.NotFound)) throw e;
  }
  cwd ??= (await checkouts()).find((c) => c.label === slot)?.cwd;
  if (!cwd) {
    const where = me ?? "this host";
    const line = `no checkout for this slot on ${where}`;
    console.log(statesOnly ? `${slot} ${line}` : `\n######## ${slot}\n${line}`);
    return;
  }
  const checkout = { label: slot, cwd, ...(slot === "landing" ? { log: MONITOR_LOG } : {}) };
  await report(checkout, claims, statesOnly, await recentCodexRollouts(), me ?? Deno.hostname());
}

if (import.meta.main) {
  const statesOnly = Deno.args.includes("--states");
  const argAfter = (flag: string) => {
    const i = Deno.args.indexOf(flag);
    return i >= 0 ? Deno.args[i + 1] : undefined;
  };
  const slot = argAfter("--slot");
  if (slot !== undefined) {
    await slotMode(slot, parseClaims(argAfter("--claims")), statesOnly);
  } else {
    console.log(`NOW ${local(new Date())} ${zone}`);
    const claims = statesOnly ? new Map<string, string>() : await printQueue();
    const [hosts, me, recentCodex] = await Promise.all([recordHosts(), localIdentity(), recentCodexRollouts()]);
    if (typeof hosts === "string") console.log(`== RECORDS unavailable (slots on other hosts not shown): ${hosts}`);
    for (const p of placements(await checkouts(), typeof hosts === "string" ? new Map() : hosts, me)) {
      if (p.kind === "local") {
        await report(p.checkout, claims, statesOnly, recentCodex);
      } else if (p.kind === "remote") {
        const out = await collectRemote(p.label, p.host, claims, statesOnly);
        const lead = out.startsWith("\n") ? "" : "\n";
        console.log(statesOnly ? out : `${lead}${out}\n(slot ${p.label} runs on ${p.host})`);
      } else {
        const line = `no checkout here, and its newest records commit (${since(p.at)}) names no host: ` +
          "it was pushed by a records tool from before the Host trailer";
        console.log(statesOnly ? `${p.label} ${line}` : `\n######## ${p.label}\n${line}`);
      }
    }
  }
}

// ---- Tests

const T = "2026-01-01T00:00:00Z";

Deno.test("codexState reads the newest turn boundary", () => {
  const ev = (p: object) => ({ timestamp: T, type: "event_msg", payload: p });
  const overloaded = ev({ type: "task_complete", error: { codex_error_info: "server_overloaded" } });
  const cases: [any[], RegExp][] = [
    [[ev({ type: "task_started" }), overloaded, ev({ type: "token_count" })], /^error=server_overloaded at /],
    [[overloaded, ev({ type: "task_started" })], /^running$/],
    [[ev({ type: "task_complete" })], /^idle$/],
    [[ev({ type: "task_complete", error: { codex_error_info: { http_connection_failed: {} } } })], /^error=http_conn/],
    [[ev({ type: "turn_aborted" })], /^aborted at /],
    [[], /^unknown$/],
  ];
  for (const [events, want] of cases) {
    const got = codexState(events);
    if (!want.test(got)) throw new Error(`got ${got}, want ${want}`);
  }
});

Deno.test("claudeState distinguishes idle, running, interrupts and API errors, and sees through compactions", () => {
  const a = (extra: object) => ({ type: "assistant", timestamp: T, ...extra });
  const u = (content: unknown) => ({ type: "user", timestamp: T, message: { content } });
  const cases: [any[], RegExp][] = [
    [[a({ message: { stop_reason: "end_turn" } }), { type: "system" }], /^idle$/],
    [[a({ message: { stop_reason: "tool_use" } })], /^running$/],
    [[a({ message: { stop_reason: "end_turn" } }), u([{ type: "tool_result" }])], /^running$/],
    [[u([{ type: "text", text: "[Request interrupted by user for tool use]" }])], /^aborted at /],
    [[u("[Request interrupted by user]")], /^aborted at /],
    [[a({ isApiErrorMessage: true, error: "server_error", message: {} })], /^error=server_error at /],
    // Compacted while idle, and compacted mid-turn: the summary entry says nothing about the turn.
    [[a({ message: { stop_reason: "end_turn" } }), { ...u("summary"), isCompactSummary: true }], /^idle$/],
    [[a({ message: { stop_reason: "tool_use" } }), { ...u("summary"), isCompactSummary: true }], /^running$/],
    [[{ ...u("summary"), isCompactSummary: true }], /^unknown$/],
    [[], /^unknown$/],
  ];
  for (const [events, want] of cases) {
    const got = claudeState(events);
    if (!want.test(got)) throw new Error(`got ${got}, want ${want}`);
  }
});

Deno.test("claudeProjectDir replaces every non-alphanumeric character", () => {
  const got = claudeProjectDir("/x/my_git/farhelm-fh-exec-1");
  if (!got.endsWith("/.claude/projects/-x-my-git-farhelm-fh-exec-1")) throw new Error(got);
});

Deno.test("isDelegate skips one-shot and service invocations only", () => {
  const cases: [string, string[], boolean][] = [
    ["claude", ["claude", "--resume", "x"], false],
    ["claude", ["claude", "-p", "hi"], true],
    ["claude", ["claude", "--print", "hi"], true],
    ["codex", ["codex", "--yolo", "-c", "x=1"], false],
    ["codex", ["codex", "-m", "m", "exec", "hi"], true],
    ["codex", ["codex", "app-server"], true],
  ];
  for (const [comm, argv, want] of cases) if (isDelegate(comm, argv) !== want) throw new Error(argv.join(" "));
});

Deno.test("activeClaims reads in-flight and landing lines only", () => {
  const index = "- [in-flight 9648c5] `a.md` — x\n- [landing 036692] `b.md` — y\n- [pending] `c.md` — z\n";
  const got = JSON.stringify([...activeClaims(index)]);
  if (got !== '[["9648c5","a"],["036692","b"]]') throw new Error(got);
});

Deno.test("elapsed prints minutes, hours with padded minutes, and days", () => {
  const cases: [number, string][] = [
    [-5000, "0m"],
    [13 * 60000, "13m"],
    [130 * 60000, "2h10m"],
    [125 * 60000, "2h05m"],
    [27 * 3600_000, "1d3h"],
  ];
  for (const [ms, want] of cases) if (elapsed(ms) !== want) throw new Error(`${ms}: ${elapsed(ms)}`);
});

Deno.test("landings reads recorded landings at or after the cutoff only", () => {
  const c = (date: string, message: string): QueueCommit => ({ commit: { message, committer: { date } } });
  const commits = [
    c("2026-01-02T10:00:00Z", "chore(plans): record the landing of b\n\nbody"),
    c("2026-01-02T09:00:00Z", "chore(plans): start landing b"),
    c("2026-01-02T08:00:00Z", "chore(plans): record the landing of a"),
    c("2026-01-01T08:00:00Z", "chore(plans): record the landing of old"),
  ];
  const got = landings(commits, Date.parse("2026-01-02T00:00:00Z")).map((l) => l.plan).join(",");
  if (got !== "b,a") throw new Error(got);
});

Deno.test("monitorRound takes the newest round entry in either wording", () => {
  const log = [
    "- 2026-01-01T07:27Z: - r313 started",
    "- 2026-01-01T08:14Z: - r313 done",
    "- 2026-01-01T13:18Z: r318 start",
    "- 2026-01-01T13:20Z: tailscale merged #1",
  ];
  const underway = JSON.stringify(monitorRound(log));
  if (underway !== '{"round":318,"underway":true,"at":"2026-01-01T13:18Z"}') throw new Error(underway);
  const ended = monitorRound([...log, "- 2026-01-01T13:57Z: r318 end 2026-01-01: landed x"]);
  if (ended?.underway !== false || ended.round !== 318) throw new Error(JSON.stringify(ended));
  const scripted = monitorRound([...log, "- 2026-01-01T14:00Z: r319 started, head 1234abcd", "- 2026-01-01T15:00Z: r319 ended"]);
  if (scripted?.round !== 319 || scripted.underway) throw new Error(`scripted entries: ${JSON.stringify(scripted)}`);
  if (monitorRound(["- 2026-01-01T00:00Z: idle watcher restarted"]) !== undefined) throw new Error("no round");
});

Deno.test("driving prefers live sessions and otherwise shows only the newest", () => {
  const s = (id: string, live: boolean, t: number): Session => ({
    harness: "codex",
    id,
    path: id,
    mtime: new Date(t),
    live,
  });
  const ids = (x: Session[]) => x.map((v) => v.id).join(",");
  if (ids(driving([s("old", false, 1), s("live", true, 0)])) !== "live") throw new Error("live first");
  if (ids(driving([s("old", false, 1), s("new", false, 2)])) !== "new") throw new Error("newest fallback");
});

/**
 * The Host trailer and the ssh target both come from this: a wrong parse sends the collector to the wrong machine or
 * makes it treat its own slots as remote. Tailscale prints the DNS name fully qualified with a trailing dot.
 */
Deno.test("tailnetName strips the trailing dot and rejects anything unusable", () => {
  const cases: [string, string | undefined][] = [
    ['{"Self":{"DNSName":"host-a.example.ts.net."}}', "host-a.example.ts.net"],
    ['{"Self":{"DNSName":"host-a.example.ts.net"}}', "host-a.example.ts.net"],
    ['{"Self":{"DNSName":""}}', undefined],
    ['{"Self":{"DNSName":"."}}', undefined],
    ['{"Self":{"DNSName":"bad name;rm"}}', undefined],
    ['{"Self":{}}', undefined],
    ["not json", undefined],
  ];
  for (const [json, want] of cases) if (tailnetName(json) !== want) throw new Error(`${json}: ${tailnetName(json)}`);
});

/** `--slot` mode finds a remote slot's checkout through the host's records config; only name and checkout matter. */
Deno.test("configSlots reads each [[slot]]'s name and checkout and skips incomplete ones", () => {
  const config = [
    'remote = "https://example.invalid/git/records/agent-records.git"',
    'token_file = "/home/agent/.fh-records/agent-records_token"',
    "",
    "[[slot]]",
    'name = "exec-7"',
    'checkout = "/home/agent/git/farhelm-fh-exec-7"',
    "",
    "[[slot]]",
    'name = "exec-8"',
    "",
  ].join("\n");
  const got = JSON.stringify([...configSlots(config)]);
  if (got !== '[["exec-7","/home/agent/git/farhelm-fh-exec-7"]]') throw new Error(got);
});

/**
 * Only a slot's newest commit names where it runs now; an older commit from another machine must not win, and a newest
 * commit without a (valid) Host leaves the host unknown rather than falling back to an older one.
 */
Deno.test("slotHosts takes each slot's newest commit only", () => {
  const l = (slot: string, host: string, at: string) => [slot, host, at].join("\x1f");
  const got = slotHosts([
    l("exec-7", "agent@host-b.example.ts.net", "2026-01-02T10:00:00Z"),
    l("exec-7", "agent@host-a.example.ts.net", "2026-01-02T09:00:00Z"),
    l("exec-8", "", "2026-01-02T08:00:00Z"),
    l("exec-8", "agent@host-a.example.ts.net", "2026-01-01T08:00:00Z"),
    l("exec-9", "agent@host-c.example.ts.net; rm -rf", "2026-01-01T07:00:00Z"),
    "",
  ]);
  const want = JSON.stringify([
    ["exec-7", { host: "agent@host-b.example.ts.net", at: "2026-01-02T10:00:00Z" }],
    ["exec-8", { at: "2026-01-02T08:00:00Z" }],
    ["exec-9", { at: "2026-01-01T07:00:00Z" }],
  ]);
  if (JSON.stringify([...got]) !== want) throw new Error(JSON.stringify([...got]));
});

/** Claims ride into the remote shell command, so anything but `<hex id>=<plan slug>` is dropped. */
Deno.test("parseClaims keeps well-formed pairs only", () => {
  const got = JSON.stringify([...parseClaims("9648c5=a-plan,zz=x,036692=b;rm,abcdef12=c.d_e")]);
  if (got !== '[["9648c5","a-plan"],["abcdef12","c.d_e"]]') throw new Error(got);
  if (parseClaims(undefined).size !== 0) throw new Error("undefined");
});

/**
 * The placement rule decides which slots the report shows and where from; getting it wrong either hides a remote
 * executor (the bug this exists for) or ssh-es to a machine for a slot that runs here.
 */
Deno.test("placements put each slot where its newest Host says, defaulting to local checkouts", () => {
  const me = "agent@host-a.example.ts.net";
  const c = (label: string): Checkout => ({ label, cwd: `/home/agent/git/farhelm-fh-${label}` });
  const h = (host?: string): SlotHost => ({ host, at: "2026-01-02T10:00:00Z" });
  const local = [c("exec-1"), c("exec-2"), c("exec-3"), { ...c("landing"), log: "x" }];
  const hosts = new Map<string, SlotHost>([
    ["exec-1", h(me)], // here, and the records agree
    ["exec-2", h()], // here, pushed by an old records tool
    ["exec-3", h("agent@host-b.example.ts.net")], // moved to another machine; the old checkout stays behind
    ["exec-10", h("agent@host-c.example.ts.net")], // only on another machine
    ["exec-11", h()], // no checkout here and no host on record
    ["Bad Slot", h("agent@host-c.example.ts.net")], // not a slot name; never reaches a shell
  ]);
  const show = (ps: Placement[]) => ps.map((p) => `${p.label}:${p.kind}`).join(" ");
  const got = show(placements(local, hosts, me));
  if (got !== "landing:local exec-1:local exec-2:local exec-3:remote exec-10:remote exec-11:unknown") {
    throw new Error(got);
  }
  // Without this host's own name, a local checkout cannot be told apart from a moved slot, so it stays local.
  const blind = show(placements(local, hosts, undefined));
  if (blind !== "landing:local exec-1:local exec-2:local exec-3:local exec-10:remote exec-11:unknown") {
    throw new Error(`blind: ${blind}`);
  }
  // Records unavailable: exactly today's local-only report.
  if (show(placements(local, new Map(), me)) !== "landing:local exec-1:local exec-2:local exec-3:local") {
    throw new Error("no records");
  }
});
