#!/usr/bin/env -S deno run -A
/**
 * The executable half of the jjstack skill: deterministic stack operations an agent would otherwise transcribe from
 * shell snippets.
 *
 * Usage: `jjstack <command> [--dir <checkout>] [--repo owner/name] [--remote origin] [--top <rev>] [options]`
 *
 * - `init`: set up a checkout for the other commands (jj, identity, author) and run their shared checks. See "Setting
 *   up a checkout".
 * - `status`: print what `submit` would do for each PR, without doing it.
 * - `submit [--update-text] [--partial]`: make GitHub show the local stack. See "Syncing the stack to GitHub".
 * - `new-pr --bookmark <name> --message-file <file> [paths...]`: commit working-copy changes as the next PR and submit.
 *   See "Making a PR".
 * - `amend --bookmark <name> [--message-file <file>] [paths...]`: fold working-copy changes into an existing PR's
 *   commit, optionally reword it, and submit. See "Updating a PR".
 * - `sync`: bring the stack along after PRs merged outside the script or the default branch moved, and submit. See
 *   "Bringing the stack along".
 * - `publish [--prs 12,13]`: mark the stack's PRs (or the listed ones) ready for review. See "Publishing PRs".
 * - `land [--through <PR-or-bookmark>] [--expect 12,13] [--plan-only] [--resume] [--no-cleanup] [--check-timeout <min>]
 *   [--allow-no-checks] [--ignore-check <names>]`: CI-gated landing, one squash commit per PR, bottom-up. See "CI-gated
 *   landing".
 * - `fast-land [--expect 12,13,14] [--plan-only] [--no-cleanup] [--resume]`: landing without waiting for CI. See "Fast
 *   landing".
 * - `stop`: ask a running `land` or `fast-land` in the same checkout to stop at its next safe point. See "Stop
 *   requests".
 *
 * Every command runs in `--dir`, a colocated jj checkout (for `init`, any Git checkout, which it sets up), so the
 * caller's working directory does not matter. "The stack" is always the linear ancestry chain from the remote default
 * branch to `--top` (default `@`).
 *
 * NOTE: Failure reporting is part of the interface, not decoration. Every way this script can stop has its own error
 * code, and each code appears exactly once in this file as a quoted literal (a test enforces that), so the `grep` the
 * report prints lands on the one line that raised it. Helpers that several call sites share take the code from their
 * caller for the same reason. On failure the script prints `JJSTACK_ERROR code=<code> phase=<phase>
 * mutated=<no|sync|yes>` and exits 3 when it wrote nothing (`sync` means it only imported remote state or let jj
 * snapshot the working copy), 4 when it had already started writing to jj, Git, or GitHub, 2 for a usage error, and 1
 * for an unexpected crash (a bug; the stack trace follows). The skill tells the agent to read the code around the
 * raising line before improvising a recovery, so messages say what was checked and what was found rather than what to
 * do. Every run also writes a timestamped log of each command it executes to `.jj/jjstack-logs`, announced by a
 * `JJSTACK_LOG` line at startup and named again in the error report. Nobody has to read it; it is there for checking on
 * a long landing in progress, and for the stops the error and the ledger do not explain.
 *
 * Lines starting with `JJSTACK_` on stdout are the machine-readable ledger; everything else is narration.
 */
import $, { type CommandBuilder, type CommandResult, KillController } from "jsr:@david/dax@0.50.1";
import { parseArgs } from "jsr:@std/cli@1.0.32/parse-args";
import { assert, assertEquals, assertRejects, assertThrows } from "jsr:@std/assert@1.0.19";

// ---------------------------------------------------------------------------------------------------------------------
// Failure reporting and process plumbing
// ---------------------------------------------------------------------------------------------------------------------

/**
 * A stop with a code that names its raising site. Raised only through `fail`, `usage`, and the command helpers, so the
 * code-uniqueness test can find every site by scanning for quoted literals.
 */
class JjstackError extends Error {
  constructor(readonly code: string, message: string, readonly exitCode?: number) {
    super(message);
  }
}

function fail(code: string, message: string): never {
  throw new JjstackError(code, message);
}

function usage(code: string, message: string): never {
  throw new JjstackError(code, message, 2);
}

/**
 * How far this process got in changing things outside itself, for the report's `mutated=`. `sync` is set before the
 * first jj command that may import remote state or snapshot the working copy, `yes` before the first write, and the
 * level never goes down, so a report cannot claim less than happened.
 */
let mutated: "no" | "sync" | "yes" = "no";

function markSync() {
  if (mutated === "no") mutated = "sync";
}

function markWrite() {
  mutated = "yes";
}

/** Coarse location for error reports (`plan`, `land #175`, `cleanup`), complementing the code's exact line. */
let phase = "startup";

/**
 * Children inherit no signal forwarding from dax, so a SIGTERM to this script alone would orphan a running `gh pr
 * merge` or `jj git push`. Every child runs under this controller, which the signal listeners in `main` trigger.
 */
const kill = new KillController();

/**
 * Multiplier for every wait in this script: poll intervals, grace and settle periods, heartbeats, retry backoff. It is 1
 * in real use. The end-to-end tests (`tests/e2e.test.ts`) set `JJSTACK_TIME_SCALE` in the environment of the script's
 * process, so a landing against their fake GitHub, whose checks finish instantly, takes seconds instead of minutes. Only
 * values in (0, 1] count; anything else is ignored, so a stray setting can shorten waits but never stretch them.
 */
const TIME_SCALE = (() => {
  const v = Number(Deno.env.get("JJSTACK_TIME_SCALE") ?? "1");
  return Number.isFinite(v) && v > 0 && v <= 1 ? v : 1;
})();

/** `ms` milliseconds, scaled by `TIME_SCALE`. */
function scaled(ms: number): number {
  return ms * TIME_SCALE;
}

/** The pause, in seconds, before each successive poll or retry; the last entry repeats. */
const BACKOFF_SEC = [1, 2, 3, 5, 7, 10, 15, 20, 30, 45, 60];

/**
 * The scaled pause before poll or retry number `n` (0 for the first). Every repeated read in this script waits on this
 * schedule rather than a fixed interval: GitHub usually converges within a few seconds, so the first polls come quickly,
 * and a state that is legitimately slow (a long CI run) is read at most once a minute instead of being hammered.
 */
function backoff(n: number): number {
  return scaled(1000 * BACKOFF_SEC[Math.min(n, BACKOFF_SEC.length - 1)]);
}

/**
 * The run log: every command this run executes, oldest first, with its call-site code, exit status, and duration, and
 * its output when it failed or changed state, interleaved with the ledger and narration lines, each line timestamped.
 * Writes and fetches also get a line when they start, so a tail shows a slow push or fetch in flight, not only the step
 * before it.
 *
 * Once `openCtx` has found the checkout, the log streams to a file of its own under `.jj/jjstack-logs`, and the path is
 * printed as a `JJSTACK_LOG` line. That is what makes a landing running in the background observable: an agent asked
 * how it is going reads the tail of the file, and nobody has to read it otherwise. Lines from before that point wait in
 * `early` and are written first; a run that stops before it found the checkout writes them to a temporary file, so
 * every failure still has a log.
 *
 * Logging must never break a run, so nothing here throws. If appending fails midway (a full disk, say), the log moves
 * to a temporary file whose first line names the original, and a new `JJSTACK_LOG` line announces the move. The file is
 * capped at `LOG_CAP_BYTES`; past that, one line says so and the rest is dropped.
 */
const early: string[] = [];
let earlyDropped = 0;
let logPath: string | undefined;
let logBroken = false;
let logBytes = 0;
const LOG_CAP_BYTES = 20 * 1024 * 1024;
/** The phase the last log line was written under; a phase change ends any run of compacted polls. */
let notedPhase = "";
/** Set while `flushRepeats` writes, so its own lines do not trigger another flush. */
let flushing = false;

function stampLine(line: string): string {
  return `${new Date().toISOString()} [${phase}] ${line}`;
}

function note(line: string) {
  if (phase !== notedPhase && !flushing) {
    notedPhase = phase;
    flushRepeats();
  }
  const stamped = stampLine(line) + "\n";
  if (logPath !== undefined && !logBroken) {
    if (logBytes >= LOG_CAP_BYTES) return;
    try {
      const capped = logBytes + stamped.length >= LOG_CAP_BYTES;
      const text = capped ? stampLine(`(log reached ${LOG_CAP_BYTES} bytes; later lines are dropped)`) + "\n" : stamped;
      Deno.writeTextFileSync(logPath, text, { append: true });
      logBytes = capped ? LOG_CAP_BYTES : logBytes + text.length;
      return;
    } catch (err) {
      moveLog(err);
      if (logPath !== undefined && !logBroken) {
        try {
          Deno.writeTextFileSync(logPath, stamped, { append: true });
          logBytes += stamped.length;
          return;
        } catch {
          logBroken = true;
        }
      }
    }
  }
  early.push(stamped.trimEnd());
  if (early.length > 5000) {
    early.splice(0, 1000);
    earlyDropped += 1000;
  }
}

/** The log file that stopped accepting appends, kept so the error report can name both halves of the timeline. */
let logMovedFrom: string | undefined;

/** Moves the log to a temporary file after an append failure; on failure of that too, falls back to memory. */
function moveLog(err: unknown) {
  const from = logPath;
  logPath = undefined;
  try {
    const to = Deno.makeTempFileSync({ prefix: "jjstack-", suffix: ".log" });
    const why = err instanceof Error ? err.message : String(err);
    Deno.writeTextFileSync(to, stampLine(`(continued from ${from}, where appending failed: ${why})`) + "\n");
    logPath = to;
    logBytes = 0;
    logMovedFrom = from;
    console.log(`JJSTACK_LOG path=${to} previous=${from}`);
  } catch {
    logBroken = true;
    logMovedFrom = from;
  }
}

/**
 * Starts streaming the log to a new file in `dir` and writes what was noted so far. The name carries a random part
 * and is created exclusively, so two runs starting in the same millisecond cannot share or truncate a file. Old logs
 * are pruned best-effort afterwards, keeping the 20 newest and anything modified in the last hour: a landing that has
 * been running for a while must not lose its log because other commands ran meanwhile. Returns the path, or undefined
 * if the file cannot be created (the run goes on, logging to memory).
 */
function openLog(dir: string, command: string): string | undefined {
  let path: string;
  try {
    Deno.mkdirSync(dir, { recursive: true });
    const stamp = new Date().toISOString().replace(/[:.]/g, "-");
    path = `${dir}/${stamp}-${command || "jjstack"}-${crypto.randomUUID().slice(0, 8)}.log`;
    const head = earlyDropped > 0 ? [`(${earlyDropped} older entries dropped)`] : [];
    const text = [...head, ...early].map((l) => l + "\n").join("");
    Deno.writeTextFileSync(path, text, { createNew: true });
    logBytes = text.length;
  } catch {
    return undefined;
  }
  early.length = 0;
  earlyDropped = 0;
  logPath = path;
  try {
    const hourAgo = Date.now() - 60 * 60 * 1000;
    const logs = [...Deno.readDirSync(dir)].filter((f) => f.isFile && f.name.endsWith(".log")).map((f) => f.name)
      .sort();
    for (const name of logs.slice(0, -20)) {
      try {
        if ((Deno.statSync(`${dir}/${name}`).mtime?.getTime() ?? 0) < hourAgo) Deno.removeSync(`${dir}/${name}`);
      } catch {
        // Another run pruned it first, or it is not ours to remove; either way, retention is best-effort.
      }
    }
  } catch {
    // Same: a failed prune never costs the run its log.
  }
  return path;
}

/**
 * For `report`: the log to name, after flushing pending repeat counts. That is the streamed log when it is healthy,
 * else the lines held in memory written to a temporary file whose first line names the file that holds the earlier
 * part of the timeline.
 */
function finalLog(): string | undefined {
  flushRepeats();
  if (logPath !== undefined && !logBroken) return logPath;
  if (early.length === 0) return logMovedFrom;
  try {
    const path = Deno.makeTempFileSync({ prefix: "jjstack-", suffix: ".log" });
    const head = [
      ...(logMovedFrom ? [`(earlier lines of this run are in ${logMovedFrom})`] : []),
      ...(earlyDropped > 0 ? [`(${earlyDropped} older entries dropped)`] : []),
    ];
    Deno.writeTextFileSync(path, [...head, ...early].map((l) => l + "\n").join(""));
    return path;
  } catch {
    return undefined;
  }
}

/**
 * Polling would drown the log: a half-hour CI wait reads GitHub every few seconds. A read marked `poll` whose result
 * is the same as the previous run of the same call is not logged again; the log says how often it repeated, and when,
 * once the result changes or the sequence ends, and gets a heartbeat line every five minutes while it does not change,
 * so a tail shows the wait is alive. Only polls compact: a fetch or any other command is always logged. A sequence
 * ends at a failure, at any write, and at a phase change, so a summary never spans one of those. Holds a fingerprint
 * of each result, not the result, for at most `MAX_POLLS` distinct calls.
 */
const lastReads = new Map<
  string,
  { fp: string; repeats: number; first: number; last: number; beat: number; phase: string }
>();
const HEARTBEAT_MS = scaled(5 * 60 * 1000);
const MAX_POLLS = 200;

/** A short fingerprint of a command result (FNV-1a over the text plus its length); collisions only cost a log line. */
function fingerprint(text: string): string {
  let h = 0x811c9dc5;
  for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 0x01000193) >>> 0;
  return `${h.toString(16)}:${text.length}`;
}

/** Writes the pending repeat count of one poll sequence, with the time span it covers. */
function summarize(key: string, e: { repeats: number; first: number; last: number; phase: string }) {
  if (e.repeats === 0) return;
  const span = `${new Date(e.first).toISOString()} to ${new Date(e.last).toISOString()}`;
  note(`${key} (repeated ${e.repeats} more times with the same result, ${span}, during ${JSON.stringify(e.phase)})`);
}

/** Ends every poll sequence, writing their pending counts. */
function flushRepeats() {
  if (flushing) return;
  flushing = true;
  try {
    for (const [key, e] of lastReads) summarize(key, e);
    lastReads.clear();
  } finally {
    flushing = false;
  }
}

/** Logs one finished command, compacting repeated polls; see `lastReads`. */
function noteCommand(
  code: string,
  text: string,
  r: CommandResult,
  ms: number,
  opts: { write?: boolean; combined?: boolean; poll?: boolean },
) {
  const key = `${code} ${text}`;
  if (opts.poll && r.code === 0) {
    const now = Date.now();
    const fp = fingerprint(`${r.stdout}\0${r.stderr}`);
    const prev = lastReads.get(key);
    if (prev && prev.fp === fp) {
      if (prev.repeats === 0) prev.first = now;
      prev.repeats++;
      prev.last = now;
      if (now - prev.beat >= HEARTBEAT_MS) {
        note(`${code} unchanged, ${prev.repeats} repeats since ${new Date(prev.first).toISOString()}: ${text}`);
        prev.beat = now;
      }
      return;
    }
    if (prev) summarize(key, prev);
    lastReads.delete(key);
    lastReads.set(key, { fp, repeats: 0, first: now, last: now, beat: now, phase });
    if (lastReads.size > MAX_POLLS) {
      const [oldest, e] = lastReads.entries().next().value!;
      summarize(oldest, e);
      lastReads.delete(oldest);
    }
  } else if (r.code !== 0 || opts.write) flushRepeats();
  note(`${code} exit=${r.code} ${ms}ms${opts.write ? " write" : ""}: ${text}`);
  if (r.code !== 0 || opts.write) {
    const clip = (t: string) => t.length > 4000 ? `${t.slice(0, 4000)}... (${t.length - 4000} more chars)` : t;
    const out = opts.combined ? r.combined : [r.stdout, r.stderr].filter((t) => t.trim() !== "").join("\n--- stderr\n");
    if (out.trim() !== "") note(`  output: ${clip(out.trim()).replaceAll("\n", "\n    ")}`);
  }
}

/** The text of every command a `shellIn` tag built, for the log; dax builders do not expose their command line. */
const commandText = new WeakMap<CommandBuilder, string>();

/** Quotes one argument the way a shell would need it, only when it has to. */
function quoteArg(a: string): string {
  return /^[\w@%+=:,./-]+$/.test(a) ? a : `'${a.replaceAll("'", `'\\''`)}'`;
}

/** Renders a dax template and its values as one readable command line. */
function renderCommand(strings: TemplateStringsArray, vals: unknown[]): string {
  let out = strings[0];
  vals.forEach((v, i) => {
    const parts = Array.isArray(v) ? v.map(String) : [String(v)];
    out += parts.map(quoteArg).join(" ") + strings[i + 1];
  });
  return out.replace(/\\\n/g, " ").replace(/\s+/g, " ").trim();
}

/**
 * A dax `$` tag whose commands run in `dir` and are recorded for the log. All commands go through one of these, so no
 * command depends on the caller's working directory and none is missing from the log.
 */
function shellIn(dir: string) {
  const base = $.build$({ commandBuilder: (b) => b.cwd(dir) });
  // dax types template values as its own `TemplateExpr`; they pass through unchanged, so `any` loses nothing here.
  // deno-lint-ignore no-explicit-any
  return (strings: TemplateStringsArray, ...vals: any[]): CommandBuilder => {
    const b = base(strings, ...vals);
    commandText.set(b, renderCommand(strings, vals));
    return b;
  };
}

/** The command being run, for naming the log file. */
let commandName = "";

/**
 * Passed to every jj invocation. By default jj abandons commits that only a now-deleted remote branch kept reachable,
 * and rebases their descendants away, even when the working copy or side work sits on top. Observed on jj 0.46: the
 * working copy ended up on an older default-branch commit, and side work built on a landed commit silently lost that
 * commit's content. That import happens on `jj git fetch`, but in a colocated repo also on any jj command after a plain
 * `git push` deleted a remote-tracking ref (cleanup's branch deletes), which is why it goes on every command rather
 * than only on fetches. A test enforces that every jj command in this file carries it.
 */
const JJ_SAFE = ["--config", "git.abandon-unreachable-commits=false"];

/** stderr patterns of `gh` failures worth one more try for a read: server errors, rate limits, dropped connections. */
const TRANSIENT_GH = /HTTP 5\d\d|HTTP 429|timed out|timeout|connection reset|unexpected EOF|TLS handshake/i;

/**
 * Runs one command and returns its result without judging the exit status, turning only a failure to start it into a
 * coded error. Stdin is closed (or fed `input`) because nothing here is interactive and some harnesses hand children a
 * pipe that never closes. `write` marks commands that change state, before they start.
 */
async function run(
  code: string,
  cmd: CommandBuilder,
  opts: { write?: boolean; input?: string; combined?: boolean; poll?: boolean; announce?: boolean } = {},
): Promise<CommandResult> {
  if (opts.write) markWrite();
  const text = commandText.get(cmd) ?? "(command text not recorded)";
  const withInput = opts.input === undefined ? cmd.stdin("null") : cmd.stdinText(opts.input);
  const piped = opts.combined ? withInput.captureCombined() : withInput.stdout("piped").stderr("piped");
  const started = Date.now();
  if (opts.write || opts.announce) note(`${code} start${opts.write ? " write" : ""}: ${text}`);
  // A command the log did not announce gets a line once it has run for 30 s, so a tail shows a slow read in flight.
  const slow = opts.write || opts.announce
    ? undefined
    : setTimeout(() => note(`${code} still running after 30s: ${text}`), scaled(30_000));
  let r: CommandResult;
  try {
    r = await piped.noThrow().signal(kill.signal);
  } catch (err) {
    clearTimeout(slow);
    const why = err instanceof Error ? err.message : String(err);
    note(
      kill.signal.aborted
        ? `${code} aborted by a signal mid-run (${why}): ${text}`
        : `${code} did not run (${why}): ${text}`,
    );
    // A signal to this script aborts the running child through `kill`; that is not a failure to start it.
    if (kill.signal.aborted) {
      fail(
        "E_KILLED",
        `interrupted by a signal while running a command (call site ${code}); that command may or may not have ` +
          `taken effect. For a clean stop at a safe point, use \`jjstack stop\` instead of a signal`,
      );
    }
    fail(code, `could not start the command: ${why}`);
  }
  clearTimeout(slow);
  // Logging must never turn a finished command into a reported failure, so a bug in it is noted and swallowed.
  try {
    noteCommand(code, text, r, Date.now() - started, opts);
  } catch (err) {
    try {
      note(`(could not log ${code}: ${err instanceof Error ? err.message : String(err)})`);
    } catch {
      // Nothing left to do.
    }
  }
  return r;
}

/**
 * Runs one command and returns its trimmed stdout, turning a non-zero exit into a coded error carrying the status and
 * output. `retry` (for reads only) repeats a command whose failure looks like a transient GitHub or network error, so
 * one HTTP 502 during a half-hour CI wait does not stop a landing.
 */
async function exec(
  code: string,
  cmd: CommandBuilder,
  opts: { write?: boolean; input?: string; retry?: boolean; poll?: boolean; announce?: boolean } = {},
): Promise<string> {
  for (let attempt = 1;; attempt++) {
    const r = await run(code, cmd, opts);
    if (r.code === 0) return r.stdout.trim();
    const detail = [r.stderr.trim(), r.stdout.trim()].filter(Boolean).join("\n") || "(no output)";
    if (opts.retry && attempt < 6 && TRANSIENT_GH.test(detail)) {
      console.log(`transient failure (${detail.split("\n")[0]}); retrying`);
      await $.sleep(backoff(attempt - 1));
      continue;
    }
    fail(code, `command exited ${r.code}:\n${detail}`);
  }
}

/** `exec` for commands that print JSON; unparsable output is its own failure under the same code. */
async function execJson<T>(
  code: string,
  cmd: CommandBuilder,
  opts: { retry?: boolean; poll?: boolean } = {},
): Promise<T> {
  const out = await exec(code, cmd, opts);
  try {
    return JSON.parse(out) as T;
  } catch {
    fail(code, `expected JSON, got: ${out.slice(0, 500)}`);
  }
}

/** Writes `content` to a fresh temporary file and returns its path; a full or unwritable temp dir is a coded stop. */
async function writeTemp(code: string, content: string): Promise<string> {
  try {
    const path = await Deno.makeTempFile({ prefix: "jjstack-" });
    await Deno.writeTextFile(path, content);
    return path;
  } catch (err) {
    fail(code, `could not write a temporary file: ${err instanceof Error ? err.message : String(err)}`);
  }
}

async function removeTemp(path: string) {
  await Deno.remove(path).catch(() => {});
}

/**
 * Prints the report described in the file header and exits. Unexpected errors keep their stack, since they are bugs in
 * this script rather than conditions it checked for.
 */
function report(err: unknown): never {
  const self = new URL(import.meta.url).pathname;
  const code = err instanceof JjstackError ? err.code : "E_UNEXPECTED";
  note(`stopped: ${code}: ${err instanceof Error ? err.message : String(err)}`);
  const log = finalLog();
  const logLine = log
    ? `log: ${log} (every command this run executed; read it if the lines above do not explain what happened)`
    : "";
  if (err instanceof JjstackError) {
    console.error(`JJSTACK_ERROR code=${err.code} phase=${JSON.stringify(phase)} mutated=${mutated}`);
    console.error(`error: ${err.message}`);
    console.error(`raised at: grep -n '"${err.code}"' ${self}`);
    if (logLine) console.error(logLine);
    Deno.exit(err.exitCode ?? (mutated === "yes" ? 4 : 3));
  }
  console.error(`JJSTACK_ERROR code=E_UNEXPECTED phase=${JSON.stringify(phase)} mutated=${mutated}`);
  console.error(err instanceof Error ? err.stack ?? err.message : String(err));
  console.error(`this is a bug in ${self}; read the stack trace above`);
  if (logLine) console.error(logLine);
  Deno.exit(mutated === "yes" ? 4 : 1);
}

/**
 * Polls `read` on the `backoff` schedule until `done` accepts its value or `seconds` pass; returns the last value
 * either way.
 */
async function pollUntil<T>(seconds: number, read: () => Promise<T>, done: (v: T) => boolean): Promise<T> {
  const deadline = Date.now() + scaled(seconds * 1000);
  let v = await read();
  for (let n = 0; !done(v) && Date.now() < deadline; n++) {
    await $.sleep(Math.max(0, Math.min(backoff(n), deadline - Date.now())));
    v = await read();
  }
  return v;
}

// ---------------------------------------------------------------------------------------------------------------------
// Stack model: jj commits, review units, and their PRs
// ---------------------------------------------------------------------------------------------------------------------

/** One commit of `<default>@<remote>..<top>` as jj reports it, bottom-up. */
type StackRow = {
  sha: string;
  changeId: string;
  empty: boolean;
  conflict: boolean;
  parents: string[];
  bookmarks: string[];
};

/** The subset of `gh pr list --json` the commands need. */
type OpenPr = {
  number: number;
  headRefName: string;
  baseRefName: string;
  headRefOid: string;
  isCrossRepository: boolean;
  isDraft: boolean;
};

type Mode = "github" | "restack" | "ci";

/**
 * One PR of a landing. `plannedSha` is the head GitHub showed when the landing was planned, the reviewed content every
 * later local commit for this PR must reproduce. `sha` is the head GitHub must show at merge time, updated whenever the
 * landing pushes a rebased commit. `tree` (fast landing only) is the simulation's prediction of the default branch's
 * tree right after this PR's squash lands. `landedSha` is filled exactly once, from the head the guarded merge pinned,
 * and is what cleanup compares refs against.
 */
type Entry = {
  pr: number;
  bookmark: string;
  changeId: string;
  plannedSha: string;
  sha: string;
  /** The local commit when the plan was made; differs from `sha` only when resuming a run that rebased locally. */
  localSha: string;
  parentSha: string;
  isDraft: boolean;
  mode: Mode;
  tree: string;
  landedSha?: string;
  /** Set right before `gh pr merge` runs: from then on, until `landedSha` is set, the outcome is unknown, not pending. */
  attempted?: boolean;
  /**
   * Local time of this run's latest retarget, push, or ready call for the PR: each can start new check runs, and the
   * CI wait's settle period never starts earlier than this. Unset when this run triggered nothing for the PR.
   */
  triggeredAt?: number;
};

/** A bookmarked commit of the stack: one review unit, before it is matched to its PR. */
type Unit = { sha: string; changeId: string; parentSha: string; bookmark: string };

/** jj template producing one space-separated `StackRow` per line; parsed by `parseStack`. */
const STACK_TEMPLATE = 'commit_id ++ " " ++ change_id ++ " " ++ if(empty, "empty", "nonempty") ++ " " ++ ' +
  'if(conflict, "conflict", "ok") ++ " " ++ parents.map(|c| c.commit_id()).join(",") ++ " " ++ ' +
  'local_bookmarks.map(|b| b.name()).join(",") ++ "\\n"';

/**
 * Parses `STACK_TEMPLATE` output. jj's bookmark grammar rejects whitespace and `,`, so splitting on both is exact; a
 * line with the wrong field count means the template and the parser disagree, which is a bug worth stopping on.
 */
function parseStack(code: string, text: string): StackRow[] {
  return text.split("\n").filter((l) => l.trim() !== "").map((line) => {
    const fields = line.split(" ");
    if (fields.length < 5 || fields.length > 6) fail(code, `unexpected jj log line: ${JSON.stringify(line)}`);
    const [sha, changeId, empty, conflict, parents, bookmarks = ""] = fields;
    return {
      sha,
      changeId,
      empty: empty === "empty",
      conflict: conflict === "conflict",
      parents: parents.split(",").filter(Boolean),
      bookmarks: bookmarks.split(",").filter(Boolean),
    };
  });
}

/**
 * Turns the stack rows into review units, enforcing the stack invariants every command depends on.
 *
 * The rows must form one chain, each the parent of the next: a `--top` revset with several heads (A←B and A←C) would
 * otherwise list a sibling as the PR below. The one unbookmarked commit a clean stack may contain is an empty one (the
 * working copy). A non-empty commit without a bookmark has no PR of its own, and GitHub's squash of the PR above it
 * would silently fold it in. Merge commits and conflicted commits have no single well-defined diff to review or land.
 */
function reviewUnits(rows: StackRow[]): Unit[] {
  const units = [];
  for (const [i, r] of rows.entries()) {
    if (r.parents.length !== 1) {
      fail("E_STACK_MERGE_COMMIT", `commit ${r.sha} has ${r.parents.length} parents; not stackable`);
    }
    if (i > 0 && r.parents[0] !== rows[i - 1].sha) {
      fail(
        "E_STACK_NOT_LINEAR",
        `commit ${r.sha} sits on ${r.parents[0]}, not on ${rows[i - 1].sha}; the range up to --top is not one chain`,
      );
    }
    if (r.conflict) fail("E_STACK_CONFLICTED", `commit ${r.sha} (change ${r.changeId}) has unresolved conflicts`);
    if (r.bookmarks.length === 0) {
      if (!r.empty) {
        fail(
          "E_STACK_UNBOOKMARKED",
          `non-empty commit ${r.sha} (change ${r.changeId}) has no bookmark and would be folded into the PR above`,
        );
      }
      continue;
    }
    if (r.bookmarks.length > 1) {
      fail("E_STACK_MULTI_BOOKMARK", `commit ${r.sha} carries several bookmarks (${r.bookmarks.join(",")})`);
    }
    units.push({ sha: r.sha, changeId: r.changeId, parentSha: r.parents[0], bookmark: r.bookmarks[0] });
  }
  if (units.length === 0) fail("E_STACK_EMPTY", "no bookmarked commits between the default branch and --top");
  return units;
}

/**
 * Pairs each review unit with its open same-repo PR and checks GitHub's base chain against jj ancestry.
 *
 * jj is the source of truth, so GitHub must show exactly the commit each local bookmark names. A mismatch is unpushed
 * local work or a stale checkout, and landing the GitHub copy would merge something other than what the user sees.
 * Fork PRs are excluded because `--head` style matching is by branch name across forks.
 *
 * `resumeBases` switches to resuming a landing that stopped partway. The lowest pending PR may then still be based on
 * the branch of the last landed PR (one of `resumeBases`), and local heads may legitimately differ from GitHub's
 * because the stopped run already rebased them locally. Each entry's `sha` is then GitHub's head, not the local one,
 * and the landing has to show that the local commit reproduces it before pushing anything.
 */
function matchPrs(units: Unit[], prs: OpenPr[], defaultBranch: string, resumeBases?: string[]): Entry[] {
  let expectedBases = [defaultBranch, ...(resumeBases ?? [])];
  return units.map((u) => {
    const matches = prs.filter((p) => !p.isCrossRepository && p.headRefName === u.bookmark);
    if (matches.length !== 1) {
      fail("E_MATCH_PR_COUNT", `expected exactly one open PR with head ${u.bookmark}, got ${matches.length}`);
    }
    const p = matches[0];
    if (!expectedBases.includes(p.baseRefName)) {
      fail(
        "E_MATCH_BASE_CHAIN",
        `PR #${p.number} (${u.bookmark}) is based on '${p.baseRefName}', expected '${expectedBases[0]}'`,
      );
    }
    expectedBases = [u.bookmark];
    if (!resumeBases && p.headRefOid !== u.sha) {
      fail(
        "E_MATCH_HEAD_DIFFERS",
        `PR #${p.number} head is ${p.headRefOid} but local ${u.bookmark} is ${u.sha}; GitHub does not show the local commit`,
      );
    }
    return {
      pr: p.number,
      ...u,
      plannedSha: p.headRefOid,
      sha: p.headRefOid,
      localSha: u.sha,
      isDraft: p.isDraft,
      mode: (resumeBases ? "restack" : "github") as Mode,
      tree: "",
    };
  });
}

/** The subset of `gh pr list --state merged --json` that resuming needs. */
type MergedPr = { number: number; headRefName: string; headRefOid: string };

/**
 * Finds the merged PR a stack commit already landed as, for `--resume`, or undefined if it has not landed.
 *
 * A matching head SHA alone is not enough: the same commit can be the head of an old merged PR and of a current open
 * one (a change that was reverted and is being reintroduced). So a commit whose bookmark is the head of an open PR is
 * never landed, a bookmarked commit must match a merged PR from that same branch, and an unbookmarked one (its branch
 * auto-deleted and the bookmark dropped by a fetch) must match exactly one merged PR.
 */
function landedAs(row: StackRow, merged: MergedPr[], open: OpenPr[]): MergedPr | undefined {
  if (row.bookmarks.some((b) => open.some((o) => o.headRefName === b && !o.isCrossRepository))) return undefined;
  const same = merged.filter((m) => m.headRefOid === row.sha);
  if (row.bookmarks.length > 0) return same.find((m) => row.bookmarks.includes(m.headRefName));
  return same.length === 1 ? same[0] : undefined;
}

/**
 * Whether every URL names `repo` (`owner/name`) on `host`, in https, ssh, or scp-like form, with or without `.git`.
 *
 * Every push goes through the jj/Git remote, while every guard reads GitHub through `gh -R repo`. A remote that
 * fetches from one repository but pushes elsewhere (a separate `pushurl`, a mirror, an Enterprise host with the same
 * `owner/name`) would have guards pass against one repository and a push or branch deletion land in another, so every
 * command refuses to start instead. An ssh host alias from `~/.ssh/config` does not name the host and is refused too;
 * that is the price of not guessing.
 */
function remoteNamesRepo(urls: string[], host: string, repo: string): boolean {
  const want = `${host}/${repo}`.toLowerCase();
  return urls.length > 0 && urls.every((u) => {
    const url = u.trim().toLowerCase().replace(/\/+$/, "").replace(/\.git$/, "");
    const m = url.match(/^(?:https?|ssh|git):\/\/(?:[^@/]+@)?([^/:]+)(?::\d+)?\/(.+)$/) ??
      url.match(/^(?:[^@/]+@)?([^/:]+):(.+)$/);
    return !!m && `${m[1]}/${m[2]}` === want;
  });
}

// ---------------------------------------------------------------------------------------------------------------------
// Context: one checkout, one repository
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Everything bound to one checkout and repository, plus the reads several commands share. Each method takes the error
 * code of its call site, so a failure in a shared read still points at the caller.
 */
class Ctx {
  /** Command tag for the checkout (see `shellIn`). */
  readonly sh: ReturnType<typeof shellIn>;

  constructor(
    readonly dir: string,
    readonly repo: string,
    readonly remote: string,
    readonly defaultBranch: string,
    readonly stopPath = "",
  ) {
    this.sh = shellIn(dir);
  }

  /** The remote default branch as a jj revset; quoted so unusual branch names stay one symbol. */
  get defaultRev() {
    return `${JSON.stringify(this.defaultBranch)}@${JSON.stringify(this.remote)}`;
  }

  /**
   * The remote as a jj string pattern. jj parses `--remote` and `--bookmark` values as pattern expressions, so an
   * unquoted name containing an operator (`a|b`) would select other remotes or bookmarks than the one checked.
   */
  get remotePattern() {
    return exactPattern(this.remote);
  }

  /** Resolves a revset that must name exactly one commit, returning `field` (`commit_id` or `change_id`). */
  async resolve(code: string, rev: string, field: "commit_id" | "change_id" = "commit_id"): Promise<string> {
    const out = await exec(code, this.sh`jj ${JJ_SAFE} log --no-graph -r ${rev} -T ${field + ' ++ "\\n"'}`);
    const lines = out.split("\n").filter(Boolean);
    if (lines.length !== 1) fail(code, `revision ${rev} resolves to ${lines.length} commits, expected one`);
    return lines[0];
  }
  async treeOf(code: string, sha: string): Promise<string> {
    return await exec(code, this.sh`git rev-parse ${sha + "^{tree}"}`);
  }
  /** One PR read; `poll` marks reads repeated in a loop, which the run log compacts (see `lastReads`). */
  async pr(code: string, n: number, fields: string, poll = false): Promise<Record<string, unknown>> {
    return await execJson(code, this.sh`gh pr view ${n} -R ${this.repo} --json ${fields}`, { retry: true, poll });
  }
  /** The stack rows from the remote default branch to `top`, bottom-up. */
  async stack(code: string, top: string): Promise<StackRow[]> {
    const range = `${this.defaultRev}..(${top})`;
    return parseStack(
      code,
      await exec(code, this.sh`jj ${JJ_SAFE} log --no-graph --reversed -r ${range} -T ${STACK_TEMPLATE}`),
    );
  }
  /** The local bookmarks of one commit. */
  async bookmarksOf(code: string, sha: string): Promise<string[]> {
    const out = await exec(
      code,
      this.sh`jj ${JJ_SAFE} log --no-graph -r ${sha} -T ${'local_bookmarks.map(|b| b.name()).join(",")'}`,
    );
    return out.split(",").filter(Boolean);
  }
  /**
   * Recently merged PRs into the default branch. Used only to recognize the already landed prefix when resuming;
   * 200 covers any realistic stack.
   */
  async mergedPrs(code: string): Promise<MergedPr[]> {
    return await execJson(
      code,
      this.sh`gh pr list -R ${this.repo} --state merged --base ${this.defaultBranch} --limit 200 \
        --json number,headRefName,headRefOid`,
      { retry: true },
    );
  }
  async openPrs(code: string): Promise<OpenPr[]> {
    return await execJson(
      code,
      this.sh`gh pr list -R ${this.repo} --state open --limit 1000 \
        --json number,headRefName,baseRefName,headRefOid,isCrossRepository,isDraft`,
      { retry: true },
    );
  }
  /**
   * Fetches from the remote without letting jj abandon anything (see `JJ_SAFE`). A fetch imports what the remote
   * already says, which can move or delete local bookmarks that track it, so it counts as `sync`, not as a write.
   */
  async fetch(code: string, defaultOnly = false) {
    markSync();
    const only = defaultOnly ? ["--branch", exactPattern(this.defaultBranch)] : [];
    await exec(code, this.sh`jj ${JJ_SAFE} git fetch --remote ${this.remotePattern} ${only}`, {
      retry: true,
      announce: true,
    });
  }
  /** The default branch's current commit as GitHub reports it, without going through a fetch. */
  async remoteTip(code: string): Promise<string> {
    return await exec(
      code,
      this.sh`gh api ${`repos/${this.repo}/git/ref/heads/${this.defaultBranch}`} --jq .object.sha`,
      { retry: true },
    );
  }
}

/**
 * Builds the context and runs the checks every command shares: the checkout is a colocated jj repo, the repository and
 * its default branch resolve, and the remote reads and writes that repository alone.
 *
 * Colocation matters because the script mixes jj with plain git (`merge-tree`, `rev-parse`, leased deletes): in a
 * non-colocated repo those git commands fail with misleading errors, or act on an enclosing Git repository.
 */
async function openCtx(args: { dir: string; repo?: string; remote: string }): Promise<Ctx> {
  phase = "startup";
  const dir = args.dir;
  await checkDir(dir);
  const sh = shellIn(dir);
  const rootRun = await run("E_JJ_ROOT", sh`jj ${JJ_SAFE} root`);
  if (rootRun.code !== 0) {
    fail(
      "E_JJ_NOT_A_REPO",
      `${dir} is not a jj checkout (jj root: ${rootRun.stderr.trim()}); \`jjstack init\` sets up a Git checkout`,
    );
  }
  const root = rootRun.stdout.trim();
  const log = openLog(`${root}/.jj/jjstack-logs`, commandName);
  if (log !== undefined) console.log(`JJSTACK_LOG path=${log}`);
  else console.log(`no run log file: cannot create one under ${root}/.jj/jjstack-logs; logging to memory only`);
  markSync();
  const jjGit = await exec("E_JJ_GIT_ROOT", sh`jj ${JJ_SAFE} git root`);
  const gitDir = await exec("E_GIT_DIR", sh`git rev-parse --absolute-git-dir`);
  const real = async (p: string) => await Deno.realPath(p).catch(() => p);
  if (await real(jjGit) !== await real(gitDir)) {
    fail("E_NOT_COLOCATED", `jj stores its Git repo at ${jjGit}, but git in ${dir} uses ${gitDir}; not colocated`);
  }
  const repo = args.repo ??
    await exec("E_GH_INFER_REPO", sh`gh repo view --json nameWithOwner --jq .nameWithOwner`, { retry: true });
  const info = await execJson<{ url: string; defaultBranchRef: { name: string } | null }>(
    "E_GH_REPO_INFO",
    sh`gh repo view ${repo} --json url,defaultBranchRef`,
    { retry: true },
  );
  const defaultBranch = info.defaultBranchRef?.name ?? "";
  if (!defaultBranch) fail("E_GH_NO_DEFAULT_BRANCH", `GitHub reports no default branch for ${repo}`);
  const host = info.url.match(/^https?:\/\/([^/]+)\//)?.[1];
  if (!host) fail("E_GH_REPO_HOST", `cannot read the host of ${repo} from its URL ${info.url}`);
  const ctx = new Ctx(dir, repo, args.remote, defaultBranch, stopPathOf(root));
  const urls = [
    ...(await exec("E_GIT_REMOTE_URL", ctx.sh`git remote get-url --all ${ctx.remote}`)).split("\n"),
    ...(await exec("E_GIT_REMOTE_PUSH_URL", ctx.sh`git remote get-url --push --all ${ctx.remote}`)).split("\n"),
  ].filter(Boolean);
  if (!remoteNamesRepo(urls, host, repo)) {
    fail(
      "E_REMOTE_NOT_REPO",
      `remote ${ctx.remote} (${urls.join(", ")}) does not fetch from and push to ${host}/${repo} alone`,
    );
  }
  return ctx;
}

/** Refuses a `--dir` that does not exist or is not a directory, before any command tries to run in it. */
async function checkDir(dir: string) {
  let stat;
  try {
    stat = await Deno.stat(dir);
  } catch {
    usage("E_USAGE_DIR_MISSING", `--dir ${dir} does not exist`);
  }
  if (!stat.isDirectory) usage("E_USAGE_DIR_NOT_DIR", `--dir ${dir} is not a directory`);
}

/** A jj string pattern matching exactly `name`, quoted so no character in it is read as pattern syntax. */
function exactPattern(name: string): string {
  return "exact:" + JSON.stringify(name);
}

/** Parses a comma-separated PR list such as `--expect 12,13`; anything else is a usage error. */
function parsePrList(code: string, text: string): number[] {
  const parts = text.split(",").map((s) => s.trim());
  if (parts.some((p) => !/^[1-9][0-9]*$/.test(p))) usage(code, `expected a comma-separated PR list, got '${text}'`);
  return parts.map(Number);
}

/**
 * Open-PR bookmarks on commits that build on the stack but are not ancestors of `top`: the stack continuing above it.
 *
 * Looking at descendants of `top` alone misses the most common shape. After `jj new <bookmark>`, an edit, and `jj
 * squash`, the working copy is an empty sibling of the rewritten PRs above, so they descend from the stack's bottom but
 * not from `@`.
 */
async function openAbove(ctx: Ctx, code: string, bottomSha: string, top: string, open: OpenPr[]): Promise<string[]> {
  const out = await exec(
    code,
    ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`(descendants(${bottomSha}) ~ ::(${top})) & bookmarks()`} \
      -T ${'local_bookmarks.map(|b| b.name()).join("\\n") ++ "\\n"'}`,
  );
  return out.split("\n").filter(Boolean).filter((b) => open.some((p) => !p.isCrossRepository && p.headRefName === b));
}

// ---------------------------------------------------------------------------------------------------------------------
// Setting up a checkout (`init`)
// ---------------------------------------------------------------------------------------------------------------------

/**
 * `jjstack init`: makes `dir` a checkout the other commands accept, runs their shared checks, and reports what it had
 * to change in a `JJSTACK_INIT` line. Idempotent: in a checkout that is already set up it changes nothing, so the skill
 * has agents run it once at the start of every session.
 *
 * - A plain Git checkout gets `jj git init --colocate`, always, without asking first; the user decided that setting up
 *   jj is never worth a question. It runs at the Git top level, because in a subdirectory jj 0.46 creates a new, empty
 *   Git repository there instead of using the enclosing one. A linked Git worktree needs nothing special: jj 0.46
 *   colocates there (with a warning) and the colocation check passes.
 * - A jj identity that is missing gets copied from Git into the repository's jj config. With neither set there is
 *   nothing to copy, and that is a refusal, decided before anything is written: the identity belongs to the user.
 * - A working-copy commit with an empty author, which includes the one `jj git init` just made when jj had no identity
 *   yet, gets `jj metaedit --update-author @`. Otherwise the first commit made from it inherits the empty author, and
 *   jj refuses to push a commit without one.
 *
 * Tool versions are not probed: a tool that cannot start fails at its first call with that call site's code, and
 * `gh repo view` in the shared checks fails when gh is not authenticated.
 */
async function init(args: { dir: string; repo?: string; remote: string }) {
  phase = "init";
  await checkDir(args.dir);
  const sh = shellIn(args.dir);
  const root = await run("E_INIT_JJ_ROOT", sh`jj ${JJ_SAFE} root`);
  let gitTop: string | undefined;
  if (root.code !== 0) {
    if (!/There is no jj repo/.test(root.stderr)) {
      fail("E_INIT_JJ_ROOT_FAILED", `jj root failed in ${args.dir}: ${root.stderr.trim()}`);
    }
    const top = await run("E_INIT_GIT_TOP", sh`git rev-parse --show-toplevel`);
    if (top.code !== 0) {
      fail("E_INIT_NOT_GIT", `${args.dir} is neither a jj nor a Git checkout: ${top.stderr.trim()}`);
    }
    gitTop = top.stdout.trim();
  }
  // Every refusal is decided before the first write. `jj config get` works before the jj repo exists (it reads the
  // user's config, and a repo created here would add nothing to it), so the identity is resolved up front.
  const toCopy: [string, string][] = [];
  for (const key of ["user.name", "user.email"]) {
    const jjValue = await run("E_INIT_JJ_IDENTITY_READ", sh`jj ${JJ_SAFE} config get ${key}`);
    if (jjValue.code === 0 && jjValue.stdout.trim() !== "") continue;
    const gitValue = await run("E_INIT_GIT_IDENTITY_READ", sh`git config ${key}`);
    const value = gitValue.code === 0 ? gitValue.stdout.trim() : "";
    if (value === "") fail("E_INIT_NO_IDENTITY", `neither jj nor git has ${key} configured for ${args.dir}`);
    toCopy.push([key, value]);
  }
  // Each change is narrated as it happens, so stdout records it even if the shared checks below then stop the run.
  if (gitTop !== undefined) {
    await exec("E_INIT_JJ_GIT_INIT", shellIn(gitTop)`jj ${JJ_SAFE} git init --colocate`, { write: true });
    console.log(`created a colocated jj repo at ${gitTop}`);
  }
  for (const [key, value] of toCopy) {
    // `jj config set` reads its value as a TOML expression; a JSON string is a valid TOML basic string, so a name
    // that happens to parse as TOML (`true`, `"Bob"`) is still stored as the literal text Git had.
    await exec("E_INIT_JJ_IDENTITY_SET", sh`jj ${JJ_SAFE} config set --repo ${key} ${JSON.stringify(value)}`, {
      write: true,
    });
    console.log(`copied ${key} from git into the repository's jj config`);
  }
  markSync();
  // Labelled fields, because `exec` trims its output and an empty name would otherwise shift the email into its place.
  const author = await exec(
    "E_INIT_AUTHOR_READ",
    sh`jj ${JJ_SAFE} log --no-graph -r @ -T ${'"name=" ++ author.name() ++ "\\temail=" ++ author.email()'}`,
  );
  const fixAuthor = !/^name=\S/.test(author) || !/\temail=\S/.test(author);
  if (fixAuthor) {
    await exec("E_INIT_AUTHOR_FIX", sh`jj ${JJ_SAFE} metaedit --update-author @`, { write: true });
    console.log("set the working-copy commit's author from the jj identity");
  }
  const ctx = await openCtx(args);
  const copied = toCopy.map(([key]) => key);
  console.log(
    `JJSTACK_INIT repo=${ctx.repo} default=${ctx.defaultBranch} jj=${gitTop !== undefined ? "created" : "existing"} ` +
      `identity=${copied.length > 0 ? `copied:${copied.join(",")}` : "ok"} author=${fixAuthor ? "fixed" : "ok"}`,
  );
}

// ---------------------------------------------------------------------------------------------------------------------
// Shared PR operations
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Edits the PR's base through REST (never `gh pr edit`, which is broken on `gh` before 2.82.1; see SPEC.md). A 422 can
 * mean GitHub already made the same retarget itself after deleting a merged parent's branch, so a failure only counts
 * if the base is still wrong afterwards.
 */
async function retarget(ctx: Ctx, code: string, pr: number, base: string) {
  const r = await run(
    code,
    ctx.sh`gh api -X PATCH ${`repos/${ctx.repo}/pulls/${pr}`} -f ${`base=${base}`} --jq .base.ref`,
    { write: true },
  );
  if (r.code === 0) return;
  const now = (await ctx.pr(code, pr, "baseRefName")).baseRefName;
  if (now !== base) fail(code, `could not retarget PR #${pr} to ${base} (base is ${now}): ${r.stderr.trim()}`);
}

/**
 * Pushes one bookmark and, when `pr` is given, waits until GitHub's PR head shows the pushed commit.
 *
 * GitHub's view of the head lags a push by a second or two, and mergeability or checks read in that window describe the
 * old head. A 32-PR landing on 2026-10-11 hit exactly that. Nothing downstream may read PR state until the head
 * converges, and a mismatch that outlasts the wait is someone else's push or a push that went elsewhere.
 */
async function pushBookmark(ctx: Ctx, code: string, bookmark: string, sha: string, pr?: number) {
  await exec(
    code,
    ctx.sh`jj ${JJ_SAFE} git push --remote ${ctx.remotePattern} --bookmark ${exactPattern(bookmark)}`,
    { write: true },
  );
  if (pr === undefined) return;
  const head = await pollUntil(
    60,
    async () => (await ctx.pr(code, pr, "headRefOid", true)).headRefOid,
    (h) => h === sha,
  );
  if (head !== sha) fail(code, `pushed ${bookmark} at ${sha}, but PR #${pr} head stayed ${head}`);
}

/**
 * Squash-merges one PR under the full guard. Returns the squash commit SHA, or `mergeable=<state>` when GitHub's
 * mergeability verdict is not MERGEABLE, so the caller can decide whether a conflict means "restack" or "stop".
 *
 * The guard is re-read on every attempt: state OPEN, base is the default branch, head is the expected bookmark at the
 * expected SHA, the default branch is still at `tip` (when given), `beforeAttempt` holds (the CI landing's check
 * verdict), and `--match-head-commit` pins the head at merge time. Only GitHub's known transient rejections are
 * retried, and only while every guard still holds: "Base branch was modified" after someone else's push must stop a
 * landing that pinned `tip`, not be retried onto a base nobody predicted. `gh pr ready` comes right before the merge
 * because GitHub refuses to merge drafts.
 */
async function guardedMerge(
  ctx: Ctx,
  e: Entry,
  tip: string | undefined,
  beforeAttempt?: () => Promise<void>,
): Promise<string> {
  const meta = await ctx.pr("E_MERGE_READ_TEXT", e.pr, "title,body");
  const bodyFile = await writeTemp("E_MERGE_BODY_FILE", String(meta.body ?? ""));
  try {
    for (let attempt = 1;; attempt++) {
      const m = String(
        await pollUntil(
          60,
          async () => (await ctx.pr("E_MERGE_READ_MERGEABLE", e.pr, "mergeable", true)).mergeable,
          (v) => v !== "UNKNOWN",
        ),
      );
      if (m !== "MERGEABLE") return `mergeable=${m}`;
      const p = await ctx.pr("E_MERGE_READ_GUARD", e.pr, "state,baseRefName,headRefName,headRefOid");
      if (p.state !== "OPEN") fail("E_MERGE_NOT_OPEN", `PR #${e.pr} is ${p.state}, not OPEN`);
      if (p.baseRefName !== ctx.defaultBranch) {
        fail("E_MERGE_BASE", `PR #${e.pr} base is '${p.baseRefName}', not ${ctx.defaultBranch}`);
      }
      if (p.headRefName !== e.bookmark) {
        fail("E_MERGE_HEAD_REF", `PR #${e.pr} head is '${p.headRefName}', not ${e.bookmark}`);
      }
      if (p.headRefOid !== e.sha) fail("E_MERGE_HEAD_MOVED", `PR #${e.pr} head moved from ${e.sha} to ${p.headRefOid}`);
      if (tip !== undefined) {
        const now = await ctx.remoteTip("E_MERGE_READ_TIP");
        if (now !== tip) {
          fail("E_MERGE_TIP_MOVED", `${ctx.defaultBranch} moved to ${now} outside this landing; expected ${tip}`);
        }
      }
      if (beforeAttempt) await beforeAttempt();
      if (e.isDraft) {
        await exec("E_MERGE_READY", ctx.sh`gh pr ready ${e.pr} -R ${ctx.repo}`, { write: true });
        e.isDraft = false;
      }
      e.attempted = true;
      const r = await run(
        "E_MERGE_START",
        ctx.sh`gh pr merge ${e.pr} -R ${ctx.repo} --squash --match-head-commit ${e.sha} \
          --subject ${`${meta.title} (#${e.pr})`} --body-file ${bodyFile}`,
        { write: true, combined: true },
      );
      if (r.code === 0) break;
      // "Base branch policy" and "not mergeable" follow a ready transition or base edit while GitHub recomputes
      // policy and mergeability. "Base branch was modified" can follow this landing's own previous squash. The next
      // attempt re-reads every guard, including the default-branch tip and the checks, so a retry merges the same
      // head onto the same base or not at all.
      const transient = /base branch policy prohibits the merge|Base branch was modified|not mergeable/i;
      if (!transient.test(r.combined)) {
        fail("E_MERGE_REJECTED", `gh pr merge of PR #${e.pr} failed: ${r.combined.trim()}`);
      }
      if (attempt === 6) fail("E_MERGE_RETRIES", `gh pr merge of PR #${e.pr} kept failing: ${r.combined.trim()}`);
      console.log(`PR #${e.pr}: GitHub has not converged (${r.combined.trim()}); retrying`);
      await $.sleep(backoff(attempt - 1));
    }
  } finally {
    await removeTemp(bodyFile);
  }
  // Merge queues and auto-merge make `gh pr merge` exit 0 without landing anything.
  const after = await ctx.pr("E_MERGE_READ_AFTER", e.pr, "state,mergeCommit");
  if (after.state !== "MERGED") {
    fail(
      "E_MERGE_NOT_MERGED",
      `PR #${e.pr} is ${after.state} after gh pr merge succeeded (merge queue or auto-merge?)`,
    );
  }
  const oid = (after.mergeCommit as { oid?: string } | null)?.oid;
  if (!oid) fail("E_MERGE_NO_COMMIT", `PR #${e.pr} is MERGED but GitHub reports no merge commit`);
  e.landedSha = e.sha;
  return oid;
}

/**
 * The stack's bottom commits that already landed, as landed entries, stopping at the first that did not. A landed
 * commit is one whose exact SHA is the head of a PR merged into the default branch (see `landedAs`); its content is on
 * the default branch now, so it only needs cleaning up. Used by a resumed landing and by `sync`.
 */
function landedPrefix(rows: StackRow[], merged: MergedPr[], open: OpenPr[]): Entry[] {
  const landed: Entry[] = [];
  for (const r of rows) {
    const m = landedAs(r, merged, open);
    if (!m) break;
    landed.push({
      pr: m.number,
      bookmark: m.headRefName,
      changeId: r.changeId,
      plannedSha: r.sha,
      sha: r.sha,
      localSha: r.sha,
      parentSha: r.parents[0],
      isDraft: false,
      mode: "github",
      tree: "",
      landedSha: r.sha,
    });
  }
  return landed;
}

/**
 * Plans a landing: the landed prefix (only with `resume`), the pending entries matched to their PRs, the change ID of
 * `--top`, and what sits directly on the top PR. Shared by both landing commands so they agree on what "the stack" and
 * "already landed" mean.
 *
 * `--top` is resolved to a change ID once, because landing rewrites commits and a `--top <sha>` would go stale. A stack
 * that continues above `--top` with open PRs is refused before anything merges: those PRs would be left on a rewritten
 * base, and the restack after a partial landing only covers what was planned.
 */
async function planLanding(ctx: Ctx, top: string, resume: boolean) {
  phase = "plan";
  await ctx.fetch("E_PLAN_FETCH");
  const topChange = await ctx.resolve("E_PLAN_RESOLVE_TOP", top, "change_id");
  const rows = await ctx.stack("E_PLAN_STACK", topChange);
  // A resumed landing may start with a prefix an earlier run already squashed: local commits whose exact SHA is the
  // head of a PR merged into the default branch. Their content is on the default branch, so they leave the plan and
  // only come back for cleanup. The prefix can be empty (the run stopped after rebasing a PR, which moves the pending
  // commits off the landed ones, or before its first merge) and so can the remainder (it stopped after the last merge,
  // in its tree check or cleanup).
  const merged = resume ? await ctx.mergedPrs("E_PLAN_LIST_MERGED") : [];
  const open = await ctx.openPrs("E_PLAN_LIST_OPEN");
  const landedBefore = resume ? landedPrefix(rows, merged, open) : [];
  let entries: Entry[] = [];
  const rest = rows.slice(landedBefore.length);
  // While resuming, the lowest pending PR may still be based on a landed PR's branch.
  const resumeBases = resume ? merged.map((m) => m.headRefName) : undefined;
  if (!resume || rest.some((r) => r.bookmarks.length > 0 || !r.empty)) {
    try {
      entries = matchPrs(reviewUnits(rest), open, ctx.defaultBranch, resumeBases);
    } catch (err) {
      // A stopped run leaves landed commits without open PRs at the bottom; say so instead of only "got 0".
      if (!resume && err instanceof JjstackError) {
        err.message += " (if an earlier landing stopped partway, rerun with --resume)";
      }
      throw err;
    }
  } else if (landedBefore.length === 0) fail("E_RESUME_NOTHING", "--resume found nothing landed and nothing to land");
  const bottom = landedBefore[0]?.localSha ?? entries[0]?.localSha;
  if (bottom !== undefined) {
    const above = await openAbove(ctx, "E_PLAN_ABOVE_QUERY", bottom, topChange, open);
    if (above.length > 0) {
      fail("E_LAND_STACK_ABOVE_TOP", `the stack continues above --top with open PRs for ${above.join(", ")}`);
    }
  }
  if (resume) {
    for (const e of entries) e.parentSha = await exec("E_PLAN_GH_PARENT", ctx.sh`git rev-parse ${e.sha + "^"}`);
  }
  // Whatever sits directly on the top PR (normally the empty working copy) follows the landing onto the default
  // branch. Recorded by change ID because rebases rewrite the commits.
  const last = [...landedBefore, ...entries].at(-1)!;
  const carry = (await exec(
    "E_PLAN_CARRY",
    ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`children(${last.changeId})`} -T ${'change_id ++ "\\n"'}`,
  )).split("\n").filter(Boolean);
  return { landedBefore, entries, carry, topChange };
}

/**
 * Refuses a plan that differs from the PR list the agent announced, the guard between two separate invocations, and
 * returns the PRs an earlier run already landed that the plan no longer shows.
 *
 * Rerunning the same command with `--resume` must keep passing the same `--expect`. The landed prefix still in the
 * stack is part of `planned`, but a stopped run rebases the next PR off the commit it just landed, which removes that
 * commit from the stack. So when resuming, `--expect` may start with PRs the plan does not show; each is accepted only
 * if GitHub shows it MERGED into the default branch from this repo, and comes back as a landed entry so cleanup covers
 * its branch and local commit too.
 */
async function resolveExpect(
  ctx: Ctx,
  codes: { mismatch: string; prefix: string },
  planned: Entry[],
  expect: string | undefined,
  resume: boolean,
): Promise<Entry[]> {
  if (expect === undefined) return [];
  const want = parsePrList("E_USAGE_EXPECT", expect);
  const got = planned.map((e) => e.pr);
  const extra = want.length - got.length;
  if (extra < 0 || want.slice(extra).join(",") !== got.join(",") || (extra > 0 && !resume)) {
    fail(codes.mismatch, `planned PRs ${got.join(",") || "(none)"} differ from --expect ${want.join(",")}`);
  }
  const landed: Entry[] = [];
  for (const n of want.slice(0, extra)) {
    const p = await ctx.pr(codes.prefix, n, "state,baseRefName,headRefName,headRefOid,isCrossRepository");
    if (p.state !== "MERGED" || p.baseRefName !== ctx.defaultBranch || p.isCrossRepository) {
      fail(
        codes.prefix,
        `--expect starts with PR #${n}, which is not in the stack and not merged into ${ctx.defaultBranch} from ` +
          `this repo (state ${p.state}, base ${p.baseRefName})`,
      );
    }
    const oid = String(p.headRefOid);
    landed.push({
      pr: n,
      bookmark: String(p.headRefName),
      changeId: "",
      plannedSha: oid,
      sha: oid,
      localSha: oid,
      parentSha: "",
      isDraft: false,
      mode: "github",
      tree: "",
      landedSha: oid,
    });
  }
  return landed;
}

/** Prints the `JJSTACK_STOPPED` ledger line that splits the stack into landed, unknown, and pending PRs. */
function printStopped(at: Entry, all: Entry[]) {
  // A merge whose outcome was never confirmed is neither landed nor pending: the call may have succeeded with the
  // confirming read failing, or failed after GitHub executed it.
  const list = (f: (x: Entry) => boolean) => all.filter(f).map((x) => x.pr).join(",") || "none";
  console.log(
    `JJSTACK_STOPPED at=${at.pr} landed=${list((x) => !!x.landedSha)} ` +
      `unknown=${list((x) => !x.landedSha && !!x.attempted)} pending=${list((x) => !x.landedSha && !x.attempted)}`,
  );
}

function planOf(entries: Entry[]): string {
  return entries.map((e) => e.pr).join(",") || "none";
}

// ---------------------------------------------------------------------------------------------------------------------
// Stop requests (`stop`)
// ---------------------------------------------------------------------------------------------------------------------
//
// A landing can run for many minutes, and the user often changes course while it waits on CI: stop waiting for CI for
// the rest, or slip a PR in below the next merge. Killing the process works but stops it wherever it happens to be,
// possibly mid-command. `jjstack stop` instead leaves a request file the running landing checks at its safe points:
// before it starts each PR, and between polls while it waits on checks. Neither point is inside a merge. The landing
// then stops with `E_STOP_REQUESTED` and a `JJSTACK_STOPPED` line, and `--resume` (of either landing command) continues
// from there. The file lives in `.jj`, which neither jj nor Git tracks.

/** The stop-request file of the checkout whose jj workspace root is `root`. */
function stopPathOf(root: string): string {
  return `${root}/.jj/jjstack-stop`;
}

async function stopRequested(path: string): Promise<boolean> {
  try {
    await Deno.stat(path);
    return true;
  } catch (err) {
    if (err instanceof Deno.errors.NotFound) return false;
    fail(
      "E_STOP_STAT",
      `could not check the stop request ${path}: ${err instanceof Error ? err.message : String(err)}`,
    );
  }
}

/**
 * Clears a stop request left over from before this landing started. A request only means something to the landing
 * that was running when it was made; a stale one would stop a new landing at its first safe point.
 */
async function clearStaleStop(ctx: Ctx) {
  if (!(await stopRequested(ctx.stopPath))) return;
  await Deno.remove(ctx.stopPath).catch(() => {});
  console.log(`cleared a stop request left over from an earlier run (${ctx.stopPath})`);
}

/** Stops the landing here if a stop was requested, consuming the request. `where` says what state the stop leaves. */
async function honorStop(ctx: Ctx, where: string) {
  if (!(await stopRequested(ctx.stopPath))) return;
  await Deno.remove(ctx.stopPath).catch(() => {});
  fail("E_STOP_REQUESTED", `stopped on request (jjstack stop) ${where}; rerun with --resume to continue`);
}

/** `jjstack stop`: leaves the request for a running landing in this checkout, and nothing else. */
async function requestStop(dir: string) {
  const root = await exec("E_STOP_JJ_ROOT", shellIn(dir)`jj ${JJ_SAFE} root`);
  const path = stopPathOf(root);
  try {
    await Deno.writeTextFile(path, `${new Date().toISOString()}\n`);
  } catch (err) {
    fail(
      "E_STOP_WRITE",
      `could not write the stop request ${path}: ${err instanceof Error ? err.message : String(err)}`,
    );
  }
  console.log(`JJSTACK_STOP_REQUESTED path=${path}`);
  console.log("a running land or fast-land in this checkout stops at its next safe point and exits E_STOP_REQUESTED");
}

// ---------------------------------------------------------------------------------------------------------------------
// Cleanup after a landing
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Moves work that sat on top of the stack onto the landed default branch, deletes landed branches, and hides landed
 * local commits, keeping anything whose evidence does not line up.
 *
 * A branch is deleted only if its PR is MERGED from this repo into the default branch at exactly the landed head, no
 * open PR still uses it as base or head, and the remote ref (when it still exists) is still at the landed head when
 * the delete executes. Repos with automatic head-branch deletion answer most reads with 404, the one read failure that
 * proves absence. Landed local commits are abandoned rather than left as stray heads in `jj log`: their content is on
 * the default branch now, and abandoning also drops a local bookmark still pointing at them.
 */
async function cleanup(ctx: Ctx, landed: Entry[], carry: string[]) {
  phase = "cleanup";
  await ctx.fetch("E_CLEANUP_FETCH_DEFAULT", true);
  for (const c of carry) {
    await exec("E_CLEANUP_CARRY", ctx.sh`jj ${JJ_SAFE} rebase -s ${c} -d ${ctx.defaultRev}`, { write: true });
  }
  // When the working copy was itself a landed PR's commit, give it a fresh one on the landed default branch first.
  // Otherwise abandoning that commit (here or by jj's fetch) recreates the working copy on the stack's old base.
  const landedChanges = landed.map((e) => e.landedSha).join(" | ");
  const wcLanded = await exec(
    "E_CLEANUP_WC_CHECK",
    ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`@ & (${landedChanges})`} -T commit_id`,
  );
  if (wcLanded !== "") {
    await exec("E_CLEANUP_NEW_WC", ctx.sh`jj ${JJ_SAFE} new ${ctx.defaultRev}`, { write: true });
  }

  const open = await ctx.openPrs("E_CLEANUP_LIST_OPEN");
  const abandon: string[] = [];
  const landedChangeIds: string[] = [];
  for (const e of landed) {
    const keep = (why: string) => console.log(`JJSTACK_KEPT pr=${e.pr} bookmark=${e.bookmark} reason=${why}`);
    const p = await ctx.pr("E_CLEANUP_READ_PR", e.pr, "state,baseRefName,headRefName,headRefOid,isCrossRepository");
    if (p.state !== "MERGED" || p.baseRefName !== ctx.defaultBranch || p.headRefName !== e.bookmark) {
      keep("pr-state-changed");
      continue;
    }
    if (p.headRefOid !== e.landedSha || p.isCrossRepository) {
      keep("pr-head-mismatch");
      continue;
    }
    if (open.some((o) => o.baseRefName === e.bookmark || (o.headRefName === e.bookmark && !o.isCrossRepository))) {
      keep("open-pr-references-branch");
      continue;
    }
    const ref = await run(
      "E_CLEANUP_READ_REF",
      ctx.sh`gh api ${`repos/${ctx.repo}/git/ref/heads/${e.bookmark}`} --jq .object.sha`,
    );
    if (ref.code === 0) {
      if (ref.stdout.trim() !== e.landedSha) {
        keep("remote-moved");
        continue;
      }
      // GitHub's ref DELETE takes no expected SHA, so a push to the branch between the read above and the DELETE
      // would lose that work. A Git push with an explicit lease deletes the ref only if it is still at the landed head.
      const del = await run(
        "E_CLEANUP_DELETE",
        ctx.sh`git push ${ctx.remote} ${`--force-with-lease=refs/heads/${e.bookmark}:${e.landedSha}`} \
          ${`:refs/heads/${e.bookmark}`}`,
        { write: true, combined: true },
      );
      if (del.code !== 0) {
        console.log(del.combined.trim());
        keep("delete-refused");
        continue;
      }
    } else if (!/HTTP 404/.test(ref.stderr)) {
      fail("E_CLEANUP_REF_UNREADABLE", `could not read remote ref ${e.bookmark}: ${ref.stderr.trim()}`);
    }
    // Abandoning a commit deletes every local bookmark on it, so a commit that is also an open PR's head stays.
    const bookmarks = await ctx.bookmarksOf("E_CLEANUP_BOOKMARKS_OF", e.landedSha!);
    if (bookmarks.some((b) => open.some((o) => o.headRefName === b && !o.isCrossRepository))) {
      console.log(`keeping landed commit ${e.landedSha} of PR #${e.pr}: an open PR's bookmark points at it`);
      continue;
    }
    abandon.push(e.landedSha!);
    if (e.changeId) landedChangeIds.push(e.changeId);
  }

  // A full fetch now imports the deletions, dropping local bookmarks that never moved locally.
  await ctx.fetch("E_CLEANUP_FETCH_ALL");
  // Other visible versions of a landed change are leftovers too: a reworded or rebased copy that stays visible because
  // a remote branch once pointed at it, and that the no-abandon setting on every jj call (see `JJ_SAFE`) keeps
  // around after the branch is gone. They go through the same descendants check below, so nothing built on one is lost.
  if (landedChangeIds.length > 0) {
    const copies = (await exec(
      "E_CLEANUP_COPIES",
      ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`(${
        landedChangeIds.map((c) => `change_id(${c})`).join(" | ")
      }) ~ ::${ctx.defaultRev}`} -T ${'commit_id ++ "\n"'}`,
    )).split("\n").filter(Boolean);
    for (const c of copies) if (!abandon.includes(c)) abandon.push(c);
  }
  if (abandon.length === 0) return;
  // A landed commit that other local work still builds on (side work outside the stack) stays, so that work keeps
  // the content it was written against. Everything else is a duplicate of the default branch now.
  const set = `(${abandon.join(" | ")})`;
  const doomed = (await exec(
    "E_CLEANUP_DOOMED",
    ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`${set} ~ ::(descendants(${set}) ~ ${set})`} -T ${'commit_id ++ "\\n"'}`,
  )).split("\n").filter(Boolean);
  const kept = abandon.filter((c) => !doomed.includes(c));
  if (kept.length > 0) console.log(`keeping landed commits that other local work builds on: ${kept.join(" ")}`);
  if (doomed.length > 0) await exec("E_CLEANUP_ABANDON", ctx.sh`jj ${JJ_SAFE} abandon ${doomed}`, { write: true });
}

// ---------------------------------------------------------------------------------------------------------------------
// Syncing the stack to GitHub (`submit`, `status`)
// ---------------------------------------------------------------------------------------------------------------------
//
// `submit` makes GitHub show the local stack: every bookmark pushed, every review unit with an open draft PR, and every
// PR based on the bookmark below it (the bottom one on the default branch). It is idempotent, so the same command
// covers "make a PR", "make the next PR", "update the PR", inserting a PR mid-stack, and pushing after a restack.
// `status` computes the same plan and prints it without acting.
//
// Everything that can refuse is checked before the first write, so a refusal never leaves a half-synced stack. Writes
// then go bottom-up, and within one PR in this order: retarget, push, create. Retargeting before pushing matters
// because the push starts CI for the new head, and a base-dependent check must see the final base; once a stale-base
// run is attached to a head, rerunning it reuses the old event payload and cannot fix it. Bottom-up matters because a
// PR can only be based on a branch that already exists on GitHub.

/** One remote's view of a bookmark, from `jj bookmark list --all-remotes`. */
type BookmarkRef = { local?: string; remote?: string; tracked: boolean; conflict: boolean };

/** One line per (bookmark, remote) pair: name, remote or `-` for local, tracking, conflict, target or `-`. */
const BOOKMARK_TEMPLATE = 'name ++ " " ++ if(remote, remote, "-") ++ " " ++ if(tracked, "tracked", "untracked") ++ ' +
  '" " ++ if(conflict, "conflict", "ok") ++ " " ++ if(normal_target, normal_target.commit_id(), "-") ++ "\\n"';

/** Parses `BOOKMARK_TEMPLATE` output into local and `remote` views per name; other remotes (such as `git`) are ignored. */
function parseBookmarks(text: string, remote: string): Map<string, BookmarkRef> {
  const refs = new Map<string, BookmarkRef>();
  for (const line of text.split("\n").filter((l) => l.trim() !== "")) {
    const fields = line.split(" ");
    if (fields.length !== 5) fail("E_BOOKMARK_PARSE", `unexpected jj bookmark line: ${JSON.stringify(line)}`);
    const [name, where, tracked, conflict, target] = fields;
    const ref = refs.get(name) ?? { tracked: false, conflict: false };
    const sha = target === "-" ? undefined : target;
    if (where === "-") {
      ref.local = sha;
      ref.conflict = conflict === "conflict";
    } else if (where === remote) {
      ref.remote = sha;
      ref.tracked = tracked === "tracked";
      if (conflict === "conflict") ref.conflict = true;
    } else continue;
    refs.set(name, ref);
  }
  return refs;
}

/** Splits a commit description into a PR title (first line) and body (everything after the first blank line). */
function splitDescription(text: string): { title: string; body: string } {
  const lines = text.replace(/\s+$/, "").split("\n");
  const title = lines[0].trim();
  const rest = lines.slice(1);
  while (rest.length > 0 && rest[0].trim() === "") rest.shift();
  return { title, body: rest.join("\n") };
}

/** One review unit and everything `submit` will do for it, in execution order. */
type SubmitStep = {
  unit: Unit;
  base: string;
  pr?: OpenPr;
  title: string;
  body: string;
  /** The PR exists but is based elsewhere; retarget before pushing. */
  retarget: boolean;
  /** The remote branch is missing or at another commit. */
  push: boolean;
  /** No open PR for this bookmark yet; create a draft after pushing. */
  create: boolean;
  /** `--update-text` and the PR's title or body differ from the commit description. */
  retext: boolean;
};

/**
 * Computes the submit plan, running every check that can refuse. Nothing here writes, so `status` can call it too, and
 * `new-pr` runs it on the existing stack before committing. `fetch` is false only for a caller that has just fetched.
 *
 * Refuses: a stack shape `reviewUnits` rejects; the stack continuing above `--top` with open PRs (unless `partial`); a
 * conflicted bookmark; a bookmark with an untracked remote branch of the same name (jj would refuse the push midway); a
 * bookmark with two open PRs; a bookmark whose only PRs are closed or merged, because creating a second PR for a landed
 * or abandoned branch is almost never what was meant; and a commit with no description when its PR has to be created
 * or retexted.
 */
async function planSubmit(ctx: Ctx, top: string, updateText: boolean, partial: boolean, fetch = true) {
  phase = "plan";
  if (fetch) await ctx.fetch("E_SUBMIT_FETCH");
  const topChange = await ctx.resolve("E_SUBMIT_RESOLVE_TOP", top, "change_id");
  const units = reviewUnits(await ctx.stack("E_SUBMIT_STACK", topChange));
  const refs = parseBookmarks(
    await exec("E_SUBMIT_BOOKMARK_LIST", ctx.sh`jj ${JJ_SAFE} bookmark list --all-remotes -T ${BOOKMARK_TEMPLATE}`),
    ctx.remote,
  );
  const open = await ctx.openPrs("E_SUBMIT_LIST_OPEN");
  // After a mid-stack edit jj has already rebased everything above it, so syncing only up to `--top` would leave
  // those PRs showing heads that are no longer the local commits.
  const above = await openAbove(ctx, "E_SUBMIT_ABOVE_QUERY", units[0].sha, topChange, open);
  if (above.length > 0 && !partial) {
    fail(
      "E_SUBMIT_STACK_ABOVE_TOP",
      `the stack continues above --top (${top}) with open PRs for ${above.join(", ")}; ` +
        `pass the top bookmark as --top, or --partial to sync only up to ${top}`,
    );
  }
  const steps: SubmitStep[] = [];
  for (const [i, unit] of units.entries()) {
    const ref = refs.get(unit.bookmark);
    if (!ref || ref.local !== unit.sha) {
      fail("E_SUBMIT_BOOKMARK_STATE", `bookmark ${unit.bookmark} does not resolve to ${unit.sha} in jj bookmark list`);
    }
    if (ref.conflict) {
      fail("E_SUBMIT_BOOKMARK_CONFLICT", `bookmark ${unit.bookmark} is conflicted locally or on the remote`);
    }
    if (ref.remote !== undefined && !ref.tracked) {
      fail(
        "E_SUBMIT_UNTRACKED_REMOTE",
        `${unit.bookmark}@${ctx.remote} exists but is not tracked, so jj would refuse to push ${unit.bookmark}`,
      );
    }
    const prs = open.filter((p) => !p.isCrossRepository && p.headRefName === unit.bookmark);
    if (prs.length > 1) {
      fail(
        "E_SUBMIT_PR_DUPLICATE",
        `bookmark ${unit.bookmark} has ${prs.length} open PRs: ${prs.map((p) => p.number)}`,
      );
    }
    const pr = prs[0];
    if (!pr) {
      const all = await execJson<{ number: number; state: string; isCrossRepository: boolean }[]>(
        "E_SUBMIT_LIST_ALL_HEAD",
        ctx.sh`gh pr list -R ${ctx.repo} --state all --head ${unit.bookmark} --json number,state,isCrossRepository`,
        { retry: true },
      );
      const old = all.filter((p) => !p.isCrossRepository);
      if (old.length > 0) {
        fail(
          "E_SUBMIT_PR_NOT_OPEN",
          `bookmark ${unit.bookmark} already had PR(s) ${old.map((p) => `#${p.number} ${p.state}`).join(", ")}; ` +
            `refusing to open another for the same branch`,
        );
      }
    }
    const base = i === 0 ? ctx.defaultBranch : units[i - 1].bookmark;
    let title = "";
    let body = "";
    if (!pr || updateText) {
      ({ title, body } = splitDescription(
        await exec("E_SUBMIT_DESCRIPTION", ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${unit.changeId} -T description`),
      ));
      if (title === "") fail("E_SUBMIT_NO_DESCRIPTION", `commit ${unit.sha} (${unit.bookmark}) has no description`);
    }
    let retext = false;
    if (pr && updateText) {
      const cur = await ctx.pr("E_SUBMIT_READ_TEXT", pr.number, "title,body");
      retext = cur.title !== title || String(cur.body ?? "").trim() !== body.trim();
    }
    steps.push({
      unit,
      base,
      pr,
      title,
      body,
      retarget: !!pr && pr.baseRefName !== base,
      push: ref.remote !== unit.sha,
      create: !pr,
      retext,
    });
  }
  // PRs based on a stack bookmark whose head is not in the stack are left alone, but worth knowing about: a PR for a
  // review unit that was dropped from the stack keeps showing a stale diff.
  const inStack = new Set(units.map((u) => u.bookmark));
  const warnings = open.filter((p) => inStack.has(p.baseRefName) && !inStack.has(p.headRefName));
  return { steps, warnings };
}

/** Prints the plan, one line per PR, with what `submit` does (or would do) for it. */
function printSubmitPlan(steps: SubmitStep[], warnings: OpenPr[], verb: "would" | "will") {
  for (const s of steps) {
    const what = [s.retarget && "retarget", s.push && "push", s.create && "create-draft", s.retext && "retext"]
      .filter(Boolean).join(",") || "nothing";
    const pr = s.pr ? `#${s.pr.number}` : "(new)";
    const draft = s.pr ? (s.pr.isDraft ? " draft" : " ready") : "";
    console.log(`  ${pr} ${s.unit.bookmark} ${s.unit.sha.slice(0, 12)} base=${s.base}${draft}: ${verb} ${what}`);
  }
  for (const w of warnings) {
    console.log(
      `JJSTACK_WARN pr=${w.number} head=${w.headRefName} base=${w.baseRefName} reason=based-on-stack-bookmark-outside-stack`,
    );
  }
}

async function status(ctx: Ctx, top: string) {
  const { steps, warnings } = await planSubmit(ctx, top, false, true);
  console.log(`stack of ${ctx.repo} onto ${ctx.defaultBranch}, bottom-up:`);
  printSubmitPlan(steps, warnings, "would");
  for (const s of steps) {
    console.log(
      `JJSTACK_STATUS bookmark=${s.unit.bookmark} pr=${s.pr?.number ?? "none"} base=${s.pr?.baseRefName ?? "none"} ` +
        `expected_base=${s.base} draft=${s.pr ? (s.pr.isDraft ? "yes" : "no") : "none"} ` +
        `pushed=${s.push ? "no" : "yes"} in_sync=${!s.retarget && !s.push && !s.create ? "yes" : "no"}`,
    );
  }
}

async function submit(ctx: Ctx, top: string, updateText: boolean, partial: boolean) {
  const { steps, warnings } = await planSubmit(ctx, top, updateText, partial);
  console.log(`submitting ${ctx.repo} onto ${ctx.defaultBranch}, bottom-up:`);
  printSubmitPlan(steps, warnings, "will");
  for (const s of steps) {
    phase = `submit ${s.unit.bookmark}`;
    let pr = s.pr?.number;
    if (s.retarget) await retarget(ctx, "E_SUBMIT_RETARGET", pr!, s.base);
    if (s.push) await pushBookmark(ctx, "E_SUBMIT_PUSH", s.unit.bookmark, s.unit.sha, pr);
    if (s.create) pr = await createDraft(ctx, s);
    if (s.retext) await retext(ctx, pr!, s.title, s.body);
    const did = [s.retarget && "retargeted", s.push && "pushed", s.create && "created", s.retext && "retexted"]
      .filter(Boolean).join(",") || "unchanged";
    console.log(`JJSTACK_SUBMITTED pr=${pr} bookmark=${s.unit.bookmark} base=${s.base} actions=${did}`);
  }
  phase = "done";
}

// ---------------------------------------------------------------------------------------------------------------------
// Making a PR (`new-pr`)
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Reads a commit message from `file`, refusing one it cannot read (`code`) or one without a title (`emptyCode`). The
 * message becomes a PR's title (its first line) and body through `submit`, so an empty first line would open a PR with
 * no title.
 */
async function readMessage(code: string, emptyCode: string, file: string): Promise<string> {
  let text;
  try {
    text = await Deno.readTextFile(file);
  } catch (err) {
    fail(code, `cannot read the message file ${file}: ${err instanceof Error ? err.message : String(err)}`);
  }
  if (splitDescription(text).title === "") fail(emptyCode, `the message file ${file} has no title (empty first line)`);
  return text;
}

/** `paths` as jj filesets that each match exactly that file or directory, relative to `--dir`. */
function pathFilesets(paths: string[]): string[] {
  // A bare path is parsed as a fileset expression, so a name with `(`, `|`, or `~` in it would mean something else.
  return paths.map((p) => `file:${JSON.stringify(p)}`);
}

/**
 * `jjstack new-pr`: turns working-copy changes into the next PR on top of the stack, in one call. It commits them (all
 * of them, or only `paths`) with the message file as the description, bookmarks the new commit, and runs `submit` up to
 * it, which pushes it and opens a draft PR based on the PR below (or on the default branch for the first one). Changes
 * left out of `paths` stay in the working copy.
 *
 * Everything that can refuse is checked before the commit, so a refusal leaves the working copy as it was:
 *
 * - a missing message file or one without a title;
 * - a bookmark name that is not a valid branch name, that already exists locally or on the remote, or that an earlier
 *   PR used (`submit` will not open a second PR for a branch, and landed branches are deleted, so a reused name is
 *   only visible as an old PR);
 * - nothing to commit, or a working copy that already carries a bookmark or a conflict (the commit would keep the
 *   bookmark next to the new one, or carry the conflict into the PR);
 * - open PRs above the working copy's parent, where the new commit would land mid-stack;
 * - anything else `submit` would refuse about the stack below, by running its plan up to that parent first;
 * - non-empty commits without a bookmark below the working copy when nothing below has one yet (the plan needs at least
 *   one bookmark to run, and `submit` would refuse those commits).
 *
 * Only a failure while writing (a push or GitHub call failing) can stop the run after the commit. The
 * `JJSTACK_COMMITTED` line says the commit and bookmark exist, and the way on is to run `submit`, not `new-pr` again,
 * which would refuse the now-existing bookmark.
 */
async function newPr(ctx: Ctx, bookmark: string, messageFile: string, paths: string[]) {
  phase = "plan";
  const message = await readMessage("E_NEWPR_MESSAGE_READ", "E_NEWPR_MESSAGE_EMPTY", messageFile);
  // jj parses the name only when the bookmark is created, after the commit, so a name it rejects is refused here. The
  // character set is the one branch names on GitHub need in practice; Git's own rules cover the rest.
  const nameOk = /^[A-Za-z0-9][A-Za-z0-9._\/-]*$/.test(bookmark) &&
    (await run("E_NEWPR_NAME_CHECK", ctx.sh`git check-ref-format --branch ${bookmark}`)).code === 0;
  if (!nameOk) fail("E_NEWPR_BOOKMARK_NAME", `'${bookmark}' is not usable as a bookmark and branch name`);
  await ctx.fetch("E_NEWPR_FETCH");
  const refs = parseBookmarks(
    await exec("E_NEWPR_BOOKMARK_LIST", ctx.sh`jj ${JJ_SAFE} bookmark list --all-remotes -T ${BOOKMARK_TEMPLATE}`),
    ctx.remote,
  );
  const existing = refs.get(bookmark);
  if (existing && (existing.local !== undefined || existing.remote !== undefined || existing.conflict)) {
    fail("E_NEWPR_BOOKMARK_EXISTS", `bookmark ${bookmark} already exists locally or on ${ctx.remote}`);
  }
  const earlier = await execJson<{ number: number; state: string; isCrossRepository: boolean }[]>(
    "E_NEWPR_LIST_ALL_HEAD",
    ctx.sh`gh pr list -R ${ctx.repo} --state all --head ${bookmark} --json number,state,isCrossRepository`,
    { retry: true },
  );
  const used = earlier.filter((p) => !p.isCrossRepository);
  if (used.length > 0) {
    fail(
      "E_NEWPR_NAME_USED",
      `branch ${bookmark} already had PR(s) ${used.map((p) => `#${p.number} ${p.state}`).join(", ")}`,
    );
  }
  const filesets = pathFilesets(paths);
  const changed = await exec("E_NEWPR_DIFF", ctx.sh`jj ${JJ_SAFE} diff --name-only -r @ ${filesets}`);
  if (changed === "") {
    fail(
      "E_NEWPR_NOTHING",
      paths.length > 0 ? `no changes in the working copy under ${paths.join(" ")}` : "the working copy has no changes",
    );
  }
  // Labelled fields, because `exec` trims its output and an empty bookmark list would otherwise vanish.
  const template =
    '"bookmarks=" ++ local_bookmarks.map(|b| b.name()).join(",") ++ " " ++ if(conflict, "conflict", "ok")';
  const wc = await exec("E_NEWPR_WC", ctx.sh`jj ${JJ_SAFE} log --no-graph -r @ -T ${template}`);
  const wcBookmarks = wc.match(/^bookmarks=(\S*) /)?.[1] ?? "";
  if (wcBookmarks !== "") fail("E_NEWPR_WC_BOOKMARKED", `the working-copy commit already carries ${wcBookmarks}`);
  if (wc.endsWith(" conflict")) fail("E_NEWPR_WC_CONFLICTED", "the working-copy commit has unresolved conflicts");
  const below = await ctx.stack("E_NEWPR_STACK", "@-");
  if (below.some((r) => r.bookmarks.length > 0)) {
    // Open PRs above `@-` mean the working copy is not on top: the new commit would land in the middle of the stack.
    // Checked here rather than left to `planSubmit`, whose refusal for it suggests `--top` and `--partial`, which are
    // the wrong way out for `new-pr`; the plan then runs with `partial` so it does not repeat the check.
    const bottom = reviewUnits(below)[0].sha;
    const above = await openAbove(ctx, "E_NEWPR_ABOVE", bottom, "@-", await ctx.openPrs("E_NEWPR_LIST_OPEN"));
    if (above.length > 0) {
      fail(
        "E_NEWPR_NOT_ON_TOP",
        `the working copy's parent is not the top of the stack: open PRs for ${above.join(", ")} sit above it`,
      );
    }
    // Every other refusal `submit` would make about the existing stack, made now instead of after the commit.
    await planSubmit(ctx, "@-", false, true, false);
  } else if (below.some((r) => !r.empty)) {
    fail(
      "E_NEWPR_UNBOOKMARKED_BELOW",
      `the working copy sits on unbookmarked, non-empty commits (${below.map((r) => r.changeId).join(", ")})`,
    );
  }
  phase = `new-pr ${bookmark}`;
  await exec("E_NEWPR_COMMIT", ctx.sh`jj ${JJ_SAFE} commit ${filesets} -m ${message}`, { write: true });
  const change = await ctx.resolve("E_NEWPR_RESOLVE", "@-", "change_id");
  await exec("E_NEWPR_BOOKMARK", ctx.sh`jj ${JJ_SAFE} bookmark create ${bookmark} -r ${change}`, { write: true });
  const sha = await ctx.resolve("E_NEWPR_RESOLVE_SHA", change);
  console.log(`JJSTACK_COMMITTED bookmark=${bookmark} change=${change} commit=${sha}`);
  await submit(ctx, change, false, false);
}

// ---------------------------------------------------------------------------------------------------------------------
// Updating a PR (`amend`)
// ---------------------------------------------------------------------------------------------------------------------

/**
 * `jjstack amend`: folds working-copy changes (all of them, or only `paths`) into the commit an existing PR's bookmark
 * points at, optionally rewords that commit from a message file, and submits the stack, which pushes the amended PR and
 * every PR above it that the rewrite moved. A reword submits with `--update-text`, so every PR in the stack, not only
 * the amended one, gets its title and body reset from its commit message, as `submit --update-text` always does.
 *
 * The working copy can sit anywhere above the bookmarked commit: on top of the stack, where an agent usually works, or
 * directly on the commit after `jj new <bookmark>`, which is how to edit against the PR's own tree when the edit
 * touches lines that PRs higher up also change. Either way the changes come from `@`, jj rebases everything above the
 * amended commit, and the submit covers the stack up to its topmost bookmark.
 *
 * Refused before anything is written: an unreadable or untitled message file; a bookmark that does not exist locally,
 * is conflicted, or does not point at a commit in the stack below the working copy; nothing to fold in and no new
 * message; a working copy with conflicts (they would move into the PR) or with a bookmark of its own (then it is a PR's
 * commit, and folding it would move that whole PR into this one); and bookmarks above the amended commit that fork
 * into more than one head, where there is no single stack to submit.
 *
 * The amended commit, or commits above it, can come out conflicted. That is the normal cost of changing a lower layer,
 * so it is not refused up front, and neither is anything else `submit` refuses about the stack (its conflict refusal
 * would stop every amend made to resolve one). `submit` then stops after the amend was made, the `JJSTACK_AMENDED`
 * line says the amend is done, and the way on is to fix the cause (for conflicts, resolve them bottom-up) and run
 * `submit`, with `--update-text` when the amend reworded the commit, since that is what carries the new text to the PR.
 */
async function amend(ctx: Ctx, bookmark: string, messageFile: string | undefined, paths: string[]) {
  phase = "plan";
  const message = messageFile === undefined
    ? undefined
    : await readMessage("E_AMEND_MESSAGE_READ", "E_AMEND_MESSAGE_EMPTY", messageFile);
  await ctx.fetch("E_AMEND_FETCH");
  const ref = parseBookmarks(
    await exec("E_AMEND_BOOKMARK_LIST", ctx.sh`jj ${JJ_SAFE} bookmark list --all-remotes -T ${BOOKMARK_TEMPLATE}`),
    ctx.remote,
  ).get(bookmark);
  if (ref?.local === undefined) fail("E_AMEND_NO_BOOKMARK", `there is no local bookmark ${bookmark}`);
  if (ref.conflict) fail("E_AMEND_BOOKMARK_CONFLICT", `bookmark ${bookmark} is conflicted locally or on the remote`);
  const target = (await ctx.stack("E_AMEND_STACK", "@-")).find((r) => r.sha === ref.local);
  if (!target) {
    fail(
      "E_AMEND_NOT_BELOW",
      `bookmark ${bookmark} (${ref.local}) is not in the stack below the working copy, between ` +
        `${ctx.defaultBranch} and @-`,
    );
  }
  const filesets = pathFilesets(paths);
  const changed = await exec("E_AMEND_DIFF", ctx.sh`jj ${JJ_SAFE} diff --name-only -r @ ${filesets}`);
  if (changed === "" && message === undefined) {
    fail(
      "E_AMEND_NOTHING",
      paths.length > 0
        ? `no changes in the working copy under ${paths.join(" ")}, and no --message-file`
        : "the working copy has no changes, and no --message-file",
    );
  }
  // Labelled fields, because `exec` trims its output and an empty bookmark list would otherwise vanish.
  const template =
    '"bookmarks=" ++ local_bookmarks.map(|b| b.name()).join(",") ++ " " ++ if(conflict, "conflict", "ok")';
  const wc = await exec("E_AMEND_WC", ctx.sh`jj ${JJ_SAFE} log --no-graph -r @ -T ${template}`);
  const wcBookmarks = wc.match(/^bookmarks=(\S*) /)?.[1] ?? "";
  if (wcBookmarks !== "") fail("E_AMEND_WC_BOOKMARKED", `the working-copy commit is bookmarked (${wcBookmarks})`);
  if (wc.endsWith(" conflict")) fail("E_AMEND_WC_CONFLICTED", "the working-copy commit has unresolved conflicts");
  // The stack to submit ends at the topmost bookmark above the amended commit; jj keeps change IDs across the rewrite.
  const heads = (await exec(
    "E_AMEND_HEADS",
    ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`heads(descendants(${target.changeId}) & bookmarks())`} \
      -T ${'change_id ++ "\\n"'}`,
  )).split("\n").filter(Boolean);
  if (heads.length !== 1) {
    fail("E_AMEND_FORKED", `bookmarks above ${bookmark} fork into ${heads.length} heads: ${heads.join(", ")}`);
  }
  phase = `amend ${bookmark}`;
  // One jj operation when there is something to fold in: the squash sets the new message itself when there is one.
  if (changed !== "") {
    const describe = message === undefined ? ["--use-destination-message"] : ["-m", message];
    await exec(
      "E_AMEND_SQUASH",
      ctx.sh`jj ${JJ_SAFE} squash --from @ --into ${target.changeId} ${describe} ${filesets}`,
      { write: true },
    );
  } else {
    await exec("E_AMEND_DESCRIBE", ctx.sh`jj ${JJ_SAFE} describe -r ${target.changeId} -m ${message!}`, {
      write: true,
    });
  }
  const sha = await ctx.resolve("E_AMEND_RESOLVE", target.changeId);
  console.log(`JJSTACK_AMENDED bookmark=${bookmark} change=${target.changeId} commit=${sha}`);
  await submit(ctx, heads[0], message !== undefined, false);
}

// ---------------------------------------------------------------------------------------------------------------------
// Bringing the stack along (`sync`)
// ---------------------------------------------------------------------------------------------------------------------

/**
 * `jjstack sync`: brings the local stack up to date after things happened outside the script, typically PRs at the
 * bottom merged in the web UI, or the default branch moving under the stack, and submits the result.
 *
 * It fetches and recognizes the landed PRs at the bottom of the stack with the same matching a resumed landing uses
 * (`landedPrefix`). When some landed, `cleanup` moves whatever sat on the last of them (the rest of the stack, or the
 * working copy) onto the default branch, deletes their branches under its usual evidence checks, and abandons their
 * local commits. When none landed, the stack's bottom is rebased onto the default branch if it is not already on its
 * tip. Then `submit` retargets the new bottom PR to the default branch and pushes everything that moved.
 *
 * Unlike `land --resume`, it does not prove that the rebased commits still match what GitHub showed (`verifyContent`):
 * bringing local work along, pushed or not, is the point, and the submit makes it the PRs' new heads.
 *
 * Refused before anything is written: an empty stack, open PRs above `--top`, which would be left on a rewritten base,
 * and a remaining stack `submit` would refuse for its shape (an unbookmarked commit, typically uncommitted work in the
 * working copy, which `--top <top-bookmark>` leaves out). Other `submit` refusals, and commits that come out of the
 * rebase conflicted, stop the run in `submit` after the rebase; the way on is to fix the cause (resolve conflicts
 * bottom-up) and run `submit`.
 *
 * A PR merged with a merge commit is not recognized as landed: its commit is already an ancestor of the default branch,
 * so it is no longer in the stack, and its branch and bookmark are left for the user. The rest of the stack is still
 * rebased and submitted.
 */
async function sync(ctx: Ctx, top: string) {
  phase = "plan";
  await ctx.fetch("E_SYNC_FETCH");
  const topChange = await ctx.resolve("E_SYNC_RESOLVE_TOP", top, "change_id");
  const rows = await ctx.stack("E_SYNC_STACK", topChange);
  if (rows.length === 0) fail("E_SYNC_EMPTY", `there is nothing between ${ctx.defaultBranch} and --top (${top})`);
  const open = await ctx.openPrs("E_SYNC_LIST_OPEN");
  const above = await openAbove(ctx, "E_SYNC_ABOVE", rows[0].sha, topChange, open);
  if (above.length > 0) {
    fail("E_SYNC_STACK_ABOVE_TOP", `the stack continues above --top (${top}) with open PRs for ${above.join(", ")}`);
  }
  const landed = landedPrefix(rows, await ctx.mergedPrs("E_SYNC_LIST_MERGED"), open);
  // The stack shape `submit` will need, checked before the first write rather than after the rebase: an unbookmarked,
  // non-empty commit (uncommitted work in the working copy, with the default `--top @`) or a merge would otherwise stop
  // the run only once the stack had been moved.
  const rest = rows.slice(landed.length);
  if (rest.some((r) => r.bookmarks.length > 0)) reviewUnits(rest);
  let rebased = false;
  if (landed.length > 0) {
    // An open PR still based on a landed branch would make `cleanup` keep that branch and its commit (an open PR uses
    // it), and on a repo that keeps merged branches nothing would ever clean them up: the next sync no longer sees the
    // landed commit in the stack. So those PRs move to the default branch first, as a landing does before cleanup.
    const landedBranches = landed.map((e) => e.bookmark);
    const restBookmarks = rest.flatMap((r) => r.bookmarks);
    for (const pr of open) {
      if (pr.isCrossRepository || !restBookmarks.includes(pr.headRefName)) continue;
      if (landedBranches.includes(pr.baseRefName)) await retarget(ctx, "E_SYNC_RETARGET", pr.number, ctx.defaultBranch);
    }
    // Whatever sits directly on the last landed commit follows it onto the default branch, recorded by change ID
    // because the rebase rewrites it.
    const carry = (await exec(
      "E_SYNC_CARRY",
      ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${`children(${landed.at(-1)!.changeId})`} -T ${'change_id ++ "\\n"'}`,
    )).split("\n").filter(Boolean);
    await cleanup(ctx, landed, carry);
    rebased = carry.length > 0;
  } else {
    const tip = await ctx.resolve("E_SYNC_TIP", ctx.defaultRev);
    if (rows[0].parents[0] !== tip) {
      phase = "rebase";
      await exec("E_SYNC_REBASE", ctx.sh`jj ${JJ_SAFE} rebase -s ${rows[0].changeId} -d ${tip}`, { write: true });
      rebased = true;
    }
  }
  console.log(`JJSTACK_SYNCED landed=${planOf(landed)} rebased=${rebased ? "yes" : "no"}`);
  if (rest.some((r) => r.bookmarks.length > 0)) await submit(ctx, topChange, false, false);
  else console.log("nothing left to submit");
}

// ---------------------------------------------------------------------------------------------------------------------
// Publishing PRs (`publish`)
// ---------------------------------------------------------------------------------------------------------------------

/**
 * The submit-plan steps a command acts on, bottom-up: every step, or only those whose PR numbers `prs` lists (a list
 * naming a PR that is not in the stack is refused). Every step up to the topmost selected one must already be a PR that
 * GitHub shows with the local head and base, because acting on a PR GitHub shows stale (publishing it, which starts CI
 * on draft-gated repos, or dispatching CI for it) would run CI on a version of the code the local stack no longer has.
 * The PRs below a selected one count too, since a PR's diff and CI on GitHub build on the branches below it. `submit`
 * brings GitHub in line first. Pure, so it is tested.
 */
function selectSynced(
  codes: { list: string; missing: string; unsynced: string },
  steps: SubmitStep[],
  prs: string | undefined,
): SubmitStep[] {
  const want = prs === undefined ? undefined : parsePrList(codes.list, prs);
  const inStack = steps.flatMap((st) => st.pr === undefined ? [] : [st.pr.number]);
  const missing = (want ?? []).filter((n) => !inStack.includes(n));
  if (missing.length > 0) fail(codes.missing, `PR(s) ${missing.map((n) => `#${n}`).join(", ")} are not in the stack`);
  const chosen = want === undefined ? steps : steps.filter((st) => st.pr !== undefined && want.includes(st.pr.number));
  const checked = steps.slice(0, steps.indexOf(chosen.at(-1)!) + 1);
  const stale = checked.filter((st) =>
    st.pr === undefined || st.push || st.retarget || st.pr.headRefOid !== st.unit.sha
  );
  if (stale.length > 0) {
    fail(
      codes.unsynced,
      `GitHub does not show the local stack for ${stale.map((st) => st.unit.bookmark).join(", ")}; run submit first`,
    );
  }
  return chosen;
}

/**
 * `jjstack publish`: marks the stack's PRs, or only those `prs` lists, ready for review, bottom-up, with a
 * `JJSTACK_PUBLISHED` line per PR saying whether it was marked ready or already was. It changes nothing else: a PR
 * stays where it is, and later PRs are still created as drafts.
 */
async function publish(ctx: Ctx, top: string, prs: string | undefined) {
  const { steps } = await planSubmit(ctx, top, false, false);
  const chosen = selectSynced(
    { list: "E_USAGE_PUBLISH_PRS", missing: "E_PUBLISH_NOT_IN_STACK", unsynced: "E_PUBLISH_UNSYNCED" },
    steps,
    prs,
  );
  for (const st of chosen) {
    const pr = st.pr!;
    phase = `publish #${pr.number}`;
    let action = "already-ready";
    if (pr.isDraft) {
      await exec("E_PUBLISH_READY", ctx.sh`gh pr ready ${pr.number} -R ${ctx.repo}`, { write: true });
      action = "ready";
    }
    console.log(`JJSTACK_PUBLISHED pr=${pr.number} bookmark=${st.unit.bookmark} action=${action}`);
  }
  phase = "done";
}

/**
 * Opens a draft PR for a just-pushed bookmark and confirms GitHub recorded the intended head commit, base, and draft
 * state. Always a draft: ready is the user's switch (or a landing's, right before a merge), because on repos that gate
 * CI on draft status every push of a ready PR starts a run.
 */
async function createDraft(ctx: Ctx, s: SubmitStep): Promise<number> {
  const bodyFile = await writeTemp("E_CREATE_BODY_FILE", s.body);
  let out;
  try {
    out = await exec(
      "E_CREATE_PR",
      ctx.sh`gh pr create -R ${ctx.repo} --draft --base ${s.base} --head ${s.unit.bookmark} --title ${s.title} \
        --body-file ${bodyFile}`,
      { write: true },
    );
  } finally {
    await removeTemp(bodyFile);
  }
  const m = out.match(/\/pull\/(\d+)\s*$/);
  if (!m) fail("E_CREATE_NO_URL", `gh pr create did not print a PR URL: ${out}`);
  const pr = Number(m[1]);
  const p = await pollUntil(
    60,
    async () => await ctx.pr("E_CREATE_VERIFY_READ", pr, "headRefName,baseRefName,isDraft,headRefOid", true),
    (v) => v.headRefOid === s.unit.sha,
  );
  if (
    p.headRefName !== s.unit.bookmark || p.baseRefName !== s.base || p.isDraft !== true || p.headRefOid !== s.unit.sha
  ) {
    fail(
      "E_CREATE_VERIFY",
      `PR #${pr} was created as head=${p.headRefName}@${p.headRefOid} base=${p.baseRefName} draft=${p.isDraft}, ` +
        `expected ${s.unit.bookmark}@${s.unit.sha} on ${s.base} as a draft`,
    );
  }
  return pr;
}

/** Sets a PR's title and body from the commit description, through REST like every other PR edit (see SPEC.md). */
async function retext(ctx: Ctx, pr: number, title: string, body: string) {
  const bodyFile = await writeTemp("E_RETEXT_BODY_FILE", body);
  try {
    await exec(
      "E_RETEXT",
      ctx.sh`gh api -X PATCH ${`repos/${ctx.repo}/pulls/${pr}`} -f ${`title=${title}`} -F ${`body=@${bodyFile}`} \
        --jq .number`,
      { write: true },
    );
  } finally {
    await removeTemp(bodyFile);
  }
}

// ---------------------------------------------------------------------------------------------------------------------
// CI-gated landing (`land`)
// ---------------------------------------------------------------------------------------------------------------------
//
// Lands the stack bottom-up, one squash commit per PR, merging each only after its checks passed on the exact head
// that merges. Per PR: retarget to the default branch (once the parent has landed), rebase onto the landed default
// branch when its parent is not already part of it, prove the rebased commit is still the reviewed change, push only
// it, mark it ready, wait for checks, then the guarded squash `fast-land` uses, with the check verdict re-read before
// every merge attempt. Unlike `fast-land` there is no simulation and no pinned default-branch tip: the checks are the
// verdict, and a default branch that moves mid-landing is merged onto like any other squash.
//
// Only the PR about to merge is pushed, as in `fast-land`. The rebase rewrites every PR above it locally too, but
// pushing them all on every cycle costs a CI run per open PR per landed PR on repos that run CI for drafts, which is
// quadratic in the stack size and was the main source of wasted CI in real landings. Each PR is pushed once, on its own
// turn, and the PRs above `--through` once more at the end. Until then they show a stale, messy diff on GitHub; nobody
// reviews them mid-landing.

/**
 * Proves that `local` is the reviewed change `e.plannedSha`, possibly rebased: replaying the planned commit onto
 * `local`'s parent must give exactly `local`'s tree. Byte-exact on purpose (a whitespace-insensitive patch-id would
 * accept an unreviewed re-indent), and it is what stops a local edit, made during a long CI wait or left behind by a
 * stopped run, from being pushed and merged as if it had been reviewed.
 */
async function verifyContent(ctx: Ctx, code: string, e: Entry, local: string) {
  if (local === e.plannedSha) return;
  const plannedParent = await exec(code, ctx.sh`git rev-parse ${e.plannedSha + "^"}`);
  const localParent = await exec(code, ctx.sh`git rev-parse ${local + "^"}`);
  const r = await run(
    code,
    ctx.sh`git merge-tree --write-tree --name-only --no-messages --merge-base ${plannedParent} ${localParent} \
      ${e.plannedSha}`,
  );
  if (r.code !== 0) {
    fail(
      code,
      `PR #${e.pr}: cannot replay the reviewed commit ${e.plannedSha} onto ${localParent}: ${r.stdout.trim()}`,
    );
  }
  const want = r.stdout.trim().split("\n")[0];
  const have = await ctx.treeOf(code, local);
  if (want !== have) {
    fail(
      code,
      `local ${e.bookmark} (${local}) is not the change PR #${e.pr} showed when the landing was planned ` +
        `(${e.plannedSha}): replaying it gives tree ${want}, the local commit has ${have}`,
    );
  }
}

/** One entry of `statusCheckRollup`: a CheckRun (Actions, apps) or a StatusContext (commit statuses). */
type Check = {
  __typename?: string;
  name?: string;
  context?: string;
  workflowName?: string;
  status?: string;
  conclusion?: string;
  state?: string;
  startedAt?: string;
  completedAt?: string;
};

type Verdict = "none" | "pending" | "failed" | "passed" | "stale-skipped";

const isStatus = (c: Check) => c.__typename === "StatusContext" || (c.status === undefined && c.state !== undefined);
const checkName = (c: Check) => isStatus(c) ? `status:${c.context}` : `${c.workflowName ?? ""}/${c.name ?? "?"}`;

/**
 * Keeps the newest entry per Actions job and per status context. The raw rollup lists runs from every check suite on
 * the head, so a superseded run (a re-run flake, a run cancelled by a newer one, the draft-time skip of a workflow that
 * ran again on ready) sits next to its replacement, and classifying the raw list would block correctly configured
 * repos forever. A run that has not finished counts as newest; otherwise the later start wins.
 *
 * Only runs that are provably the same check are collapsed: an Actions job is identified by workflow name plus job
 * name. Checks from other apps carry no workflow name in `gh`'s export (as of 2.45.0 it omits the app), so two apps
 * posting a check with the same name would be indistinguishable; those are never collapsed, which means a superseded
 * app run can block, and a stop is the right failure there. Two Actions workflows sharing one `name:` and one job name
 * are still treated as one check, a residual limit of what the rollup exposes.
 */
function latestChecks(rollup: Check[]): Check[] {
  const rank = (c: Check) =>
    !isStatus(c) && c.status !== "COMPLETED" ? Infinity : Date.parse(c.startedAt ?? c.completedAt ?? "") || 0;
  const best = new Map<string, Check>();
  for (const [i, c] of rollup.entries()) {
    const key = isStatus(c) || c.workflowName ? checkName(c) : `app#${i}`;
    const cur = best.get(key);
    if (!cur || rank(c) >= rank(cur)) best.set(key, c);
  }
  return [...best.values()];
}

/** What the check-suite API says about a head beyond the rollup. */
type Suites = {
  /** Suites not yet completed: Actions suites even before their first job attaches, other apps only once they have runs. */
  running: string[];
  /** Whether an Actions suite on the head was created after the PR last left draft. */
  postReady: boolean;
  /** When the newest suite of any app on the head was created (GitHub's clock), if it has any. */
  latestCreated?: number;
};

/**
 * The latest event GitHub shows that can still attach new check runs to the head, or undefined when it shows none.
 * Pure, so it is tested.
 *
 * Every workflow run gets a check suite of its own when GitHub starts it, and other apps get theirs when the head is
 * pushed, so the newest suite marks the latest trigger GitHub has acted on; the PR leaving draft (`readyAt`) is the
 * other. A trigger GitHub has not attached anything for yet is invisible here, and commit statuses create no suite at
 * all, which is why `settleStart` also counts from this run's own pushes and ready calls. Both times are GitHub's, so a
 * local clock running ahead of GitHub's shortens a window measured only from them.
 */
function lastTrigger(readyAt: number | undefined, suites: Suites): number | undefined {
  const times = [readyAt, suites.latestCreated].filter((t): t is number => t !== undefined && !Number.isNaN(t));
  return times.length > 0 ? Math.max(...times) : undefined;
}

/**
 * Where the CI wait's settle period starts: the later of `lastTrigger` and this run's own last retarget, push, or ready
 * call (`own`, local clock), or the start of the wait when neither is known. Pure, so it is tested.
 *
 * Measuring from the trigger rather than from the first passing read is what makes the settle period free in the
 * usual case, since CI that ran longer than it is already past it. `own` keeps the period intact when GitHub shows no
 * fresh trigger: right after this run's push, before any suite exists, the newest thing GitHub shows can be a ready
 * event from days ago, and a fast commit status could otherwise pass before slower CI posts anything. A resumed run
 * that triggered nothing itself relies on GitHub's times alone.
 */
function settleStart(github: number | undefined, own: number | undefined, waitStart: number): number {
  const known = [github, own].filter((t): t is number => t !== undefined);
  return known.length > 0 ? Math.max(...known) : waitStart;
}

/**
 * Classifies a PR's checks for its current head. Pure, so the edge cases are tested.
 *
 * `suites.running` names check suites on the head that have not completed. A job with `needs:` gets no check run
 * until its dependencies finish, and a workflow queued behind a concurrency group has no runs at all yet, so the rollup
 * alone can look complete and passing while a suite is still working. `ignore` drops checks the user declared optional
 * (matched by job name, status context, or `workflow/job`), so their failures do not block.
 *
 * `none` covers an empty rollup and one where every check was skipped: neither is a verdict on the code. `readyAt` is
 * when GitHub recorded the PR's latest transition out of draft. A skipped check is a draft-time leftover, not a
 * verdict, when its newest run started before that, or when no Actions suite was created after it at all (a run
 * triggered while the PR was a draft can execute after the ready event, still seeing the draft payload). It counts as
 * pending until a newer run replaces it, and once `graceOver` it is reported as `stale-skipped`, because a repo whose
 * workflows skip drafts but do not list `ready_for_review` among their `pull_request` types never starts the real run.
 *
 * A run that ended `CANCELLED` or `STALE` less than `replaceSec` before `now` is pending, not failed. GitHub cancels a
 * run when a concurrency group or a newer event supersedes it, and the replacement can take a while to attach; a 2026-10
 * landing of 19 PRs stopped on exactly that. Once the newer run attaches, `latestChecks` keeps it instead. A
 * cancellation that nothing replaced within `replaceSec` is a real failure.
 */
function checkVerdict(
  rollup: Check[],
  suites: Suites,
  readyAt: number | undefined,
  graceOver: boolean,
  ignore: string[] = [],
  now = Date.now(),
  replaceSec = 120,
): { v: Verdict; detail: string } {
  const bad = new Set(["FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE", "ERROR"]);
  const superseded = new Set(["CANCELLED", "STALE"]);
  const ignored = (c: Check) => ignore.some((n) => n === c.name || n === c.context || n === checkName(c));
  const checks = latestChecks(rollup).filter((c) => !ignored(c));
  const suitesRunning = suites.running;
  const outcome = (c: Check) => (isStatus(c) ? c.state : c.conclusion) ?? "";
  const ended = (c: Check) => Date.parse(c.completedAt ?? c.startedAt ?? "") || 0;
  const awaitingReplacement = checks.filter((c) => superseded.has(outcome(c)) && now - ended(c) < replaceSec * 1000);
  const failed = checks.filter((c) => bad.has(outcome(c)) && !awaitingReplacement.includes(c));
  if (failed.length > 0) {
    return {
      v: "failed",
      detail: failed.map((c) => `${checkName(c)}=${isStatus(c) ? c.state : c.conclusion}`).join(", "),
    };
  }
  const pending = checks.filter((c) => isStatus(c) ? c.state !== "SUCCESS" : c.status !== "COMPLETED");
  if (pending.length > 0) return { v: "pending", detail: `pending: ${pending.map(checkName).join(", ")}` };
  if (awaitingReplacement.length > 0) {
    return {
      v: "pending",
      detail: `cancelled, waiting for a replacement run: ${awaitingReplacement.map(checkName).join(", ")}`,
    };
  }
  if (suitesRunning.length > 0) return { v: "pending", detail: `suites still running: ${suitesRunning.join(", ")}` };
  if (checks.length === 0) return { v: "none", detail: "no checks attached" };
  const stale = readyAt === undefined ? [] : checks.filter((c) =>
    !isStatus(c) && c.conclusion === "SKIPPED" &&
    ((Date.parse(c.startedAt ?? c.completedAt ?? "") || 0) < readyAt || !suites.postReady)
  );
  if (stale.length > 0) {
    return {
      v: graceOver ? "stale-skipped" : "pending",
      detail: `skipped while draft: ${stale.map(checkName).join(", ")}`,
    };
  }
  if (checks.every((c) => !isStatus(c) && c.conclusion === "SKIPPED")) {
    return { v: "none", detail: `only skipped checks: ${checks.map(checkName).join(", ")}` };
  }
  return { v: "passed", detail: checks.map(checkName).join(", ") };
}

/**
 * When GitHub last recorded the PR leaving draft, from its issue events, or undefined if it never was a draft. Read
 * from GitHub rather than remembered, so a rerun or `--resume` after a refusal applies the same draft-skip rule as the
 * run that marked the PR ready, and the comparison uses GitHub's clock on both sides.
 */
async function readyEventTime(ctx: Ctx, code: string, pr: number): Promise<number | undefined> {
  const out = await exec(
    code,
    ctx.sh`gh api --paginate ${`repos/${ctx.repo}/issues/${pr}/events?per_page=100`} \
      --jq ${'.[] | select(.event == "ready_for_review") | .created_at'}`,
    { retry: true, poll: true },
  );
  const times = out.split("\n").filter(Boolean).map((t) => Date.parse(t)).filter((t) => !Number.isNaN(t));
  return times.length > 0 ? Math.max(...times) : undefined;
}

/**
 * Reads the head's check suites. Other apps' suites without runs are left out of `running`: GitHub creates a queued
 * suite for every installed app with checks permission, and one that never posts anything would otherwise hold every
 * landing until it times out. Actions suites always count, since a queued Actions suite is a workflow about to run.
 */
async function readSuites(ctx: Ctx, code: string, sha: string, readyAt: number | undefined): Promise<Suites> {
  const out = await exec(
    code,
    ctx.sh`gh api --paginate ${`repos/${ctx.repo}/commits/${sha}/check-suites?per_page=100`} \
      --jq ${'.check_suites[] | [.app.slug // "app", .status, (.latest_check_runs_count | tostring), .created_at] | @tsv'}`,
    { retry: true, poll: true },
  );
  const rows = out.split("\n").filter(Boolean).map((l) => l.split("\t"));
  const running = rows.filter(([app, status, runs]) =>
    status !== "completed" && (app === "github-actions" || runs !== "0")
  )
    .map(([app, status]) => `${app}:${status}`);
  const postReady = readyAt === undefined ||
    rows.some(([app, , , created]) => app === "github-actions" && Date.parse(created) > readyAt);
  const created = rows.map(([, , , c]) => Date.parse(c)).filter((t) => !Number.isNaN(t));
  return { running, postReady, latestCreated: created.length > 0 ? Math.max(...created) : undefined };
}

/**
 * Reads the PR's head and the check verdict on `e.sha` in one place, so the wait loop and the per-merge-attempt recheck
 * cannot disagree about what "passed" means. `trigger` is `lastTrigger` for the head, for the wait's settle period.
 */
async function readVerdict(
  ctx: Ctx,
  code: string,
  e: Entry,
  readyAt: number | undefined,
  graceOver: boolean,
  ignore: string[],
) {
  const p = await ctx.pr(code, e.pr, "headRefOid,statusCheckRollup", true);
  if (p.headRefOid !== e.sha) fail(code, `PR #${e.pr} head moved to ${p.headRefOid} while landing ${e.sha}`);
  const suites = await readSuites(ctx, code, e.sha, readyAt);
  const rollup = (p.statusCheckRollup ?? []) as Check[];
  return {
    ...checkVerdict(rollup, suites, readyAt, graceOver, ignore, Date.now(), scaled(120_000) / 1000),
    trigger: lastTrigger(readyAt, suites),
  };
}

/**
 * Waits until the PR's checks on `e.sha` pass, refusing on a failure, a timeout, or no real verdict after the grace
 * period. Returns the verdict it proceeded on, which the merge guard then requires again.
 *
 * With `allowNoChecks`, a head with no checks at all proceeds at once: the caller has said the repo runs no PR checks,
 * and holding every PR for the grace period made a CI-less landing of nine PRs take 18 minutes. Checks that are attached
 * still have to pass, and a check skipped while the PR was a draft still gets the grace period to be replaced by a real
 * run, since that skip is what the draft-skip rule exists to catch.
 *
 * GitHub attaches runs a few seconds after a push, retarget, or ready event, and not all at once, so a pass only counts
 * once `settleSec` have gone by since `settleStart`. An empty rollup is pending until the grace period ends, never an
 * early pass. Reads follow the `backoff` schedule, which starts over when the verdict changes (pending to passing, say),
 * and the sleeps between them are sliced so a stop request is honored within a couple of seconds.
 */
async function waitForChecks(ctx: Ctx, e: Entry, opts: LandOpts): Promise<Verdict> {
  const start = Date.now();
  const readyAt = await readyEventTime(ctx, "E_LAND_READ_READY_EVENT", e.pr);
  const where = `while waiting for checks on PR #${e.pr}, which is pushed and ready but not merged`;
  let last = "";
  let lastVerdict: Verdict | undefined;
  let lastPrinted = 0;
  let polls = 0;
  for (;;) {
    await honorStop(ctx, where);
    const elapsed = (Date.now() - start) / 1000;
    const graceOver = elapsed >= opts.graceSec;
    const { v, detail, trigger } = await readVerdict(ctx, "E_LAND_READ_CHECKS", e, readyAt, graceOver, opts.ignore);
    if (v === "failed") fail("E_LAND_CHECKS_FAILED", `PR #${e.pr} checks failed on ${e.sha}: ${detail}`);
    if (v === "passed" && Date.now() - settleStart(trigger, e.triggeredAt, start) >= opts.settleSec * 1000) {
      console.log(`PR #${e.pr}: checks passed (${detail})`);
      return v;
    }
    if (v === "none" && opts.allowNoChecks) {
      console.log(`PR #${e.pr}: ${detail}; proceeding without a CI verdict (--allow-no-checks)`);
      return v;
    }
    if ((v === "none" || v === "stale-skipped") && graceOver) {
      if (opts.allowNoChecks) {
        console.log(`PR #${e.pr}: ${detail}; proceeding without a CI verdict (--allow-no-checks)`);
        return v;
      }
      fail(
        "E_LAND_NO_CHECKS",
        `PR #${e.pr} has no CI verdict on ${e.sha} after ${opts.graceSec}s (${detail}). Either the repo runs no CI ` +
          `for PRs, or its workflows did not run for this head: a pull_request workflow only fires on the ready event ` +
          `when it lists ready_for_review under types:, so a workflow that skips drafts may never run after the PR was ` +
          `marked ready`,
      );
    }
    if (elapsed >= opts.timeoutSec) {
      fail("E_LAND_CHECKS_TIMEOUT", `PR #${e.pr} checks still not done after ${opts.timeoutSec}s (${detail})`);
    }
    const shown = v === "passed" ? `passing, settling (${detail})` : detail;
    // A changed verdict is always printed; an unchanged one every five minutes, so the output shows the wait is alive.
    if (shown !== last || Date.now() - lastPrinted >= HEARTBEAT_MS) {
      const mins = Math.floor((Date.now() - start) / 60000);
      console.log(`PR #${e.pr}: waiting for checks (${shown})${shown === last ? `, ${mins}m so far` : ""}`);
      lastPrinted = Date.now();
    }
    // Only a change of verdict restarts the backoff: the pending list shrinks with every finished job, and restarting
    // on that would read a busy matrix every second or two.
    if (v !== lastVerdict) polls = 0;
    last = shown;
    lastVerdict = v;
    await sleepHonoringStop(ctx, backoff(polls++), where);
  }
}

/**
 * Sleeps `ms` in slices of at most two seconds, honoring a stop request between them, so that a backoff grown to a
 * minute does not hold up `jjstack stop`. A stop request is a local file check, cheap enough to make often.
 */
async function sleepHonoringStop(ctx: Ctx, ms: number, where: string) {
  const until = Date.now() + ms;
  for (let left = ms; left > 0; left = until - Date.now()) {
    await $.sleep(Math.min(left, scaled(2000)));
    await honorStop(ctx, where);
  }
}

/** Whether commit `a` is an ancestor of (or equal to) `b`; `git merge-base --is-ancestor` answers with exit 0 or 1. */
async function isAncestor(ctx: Ctx, code: string, a: string, b: string): Promise<boolean> {
  const r = await run(code, ctx.sh`git merge-base --is-ancestor ${a} ${b}`);
  if (r.code === 0 || r.code === 1) return r.code === 0;
  fail(code, `git merge-base --is-ancestor ${a} ${b} exited ${r.code}: ${r.stderr.trim()}`);
}

/** Tunables of the CI wait, shared by `ciLandOne` and `waitForChecks`. */
type LandOpts = { timeoutSec: number; graceSec: number; settleSec: number; allowNoChecks: boolean; ignore: string[] };

/** Lands one PR as described in the section header and returns its squash commit. */
async function ciLandOne(ctx: Ctx, e: Entry, opts: LandOpts): Promise<string> {
  await ctx.fetch("E_LAND_FETCH", true);
  const tip = await ctx.resolve("E_LAND_RESOLVE_TIP", ctx.defaultRev);
  const gh = await ctx.pr("E_LAND_READ_PR", e.pr, "state,baseRefName,headRefName,headRefOid");
  if (gh.state !== "OPEN") fail("E_LAND_PR_NOT_OPEN", `PR #${e.pr} is ${gh.state}, not OPEN`);
  if (gh.headRefName !== e.bookmark) {
    fail("E_LAND_HEAD_REF", `PR #${e.pr} head is '${gh.headRefName}', not ${e.bookmark}`);
  }
  if (gh.headRefOid !== e.sha) fail("E_LAND_HEAD_MOVED", `PR #${e.pr} head is ${gh.headRefOid}, expected ${e.sha}`);
  // Retarget before any push, so the CI run the push starts sees the final base.
  if (gh.baseRefName !== ctx.defaultBranch) {
    await retarget(ctx, "E_LAND_RETARGET", e.pr, ctx.defaultBranch);
    e.triggeredAt = Date.now();
  }
  let local = await ctx.resolve("E_LAND_RESOLVE_LOCAL", e.changeId);
  const parent = await exec("E_LAND_LOCAL_PARENT", ctx.sh`git rev-parse ${local + "^"}`);
  // A parent that is already part of the default branch needs no rebase: that is the bottom PR, which GitHub merges
  // onto a moved default branch like any squash. Any other parent is a landed PR's original commit, which the squash
  // never made an ancestor of anything.
  if (!(await isAncestor(ctx, "E_LAND_ANCESTRY", parent, tip))) {
    await exec("E_LAND_REBASE", ctx.sh`jj ${JJ_SAFE} rebase -s ${e.changeId} -d ${tip}`, { write: true });
    const [row] = parseStack(
      "E_LAND_REBASED_PARSE",
      await exec("E_LAND_REBASED_ROW", ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${e.changeId} -T ${STACK_TEMPLATE}`),
    );
    if (row.conflict) {
      fail(
        "E_LAND_REBASE_CONFLICT",
        `PR #${e.pr} (${e.bookmark}) conflicts after rebasing onto ${ctx.defaultBranch} at ${tip}; ` +
          `nothing was pushed for it`,
      );
    }
    if (!row.bookmarks.includes(e.bookmark)) {
      fail("E_LAND_BOOKMARK_LOST", `bookmark ${e.bookmark} did not follow the rebase of PR #${e.pr}`);
    }
    local = row.sha;
  }
  await verifyContent(ctx, "E_LAND_CONTENT_CHANGED", e, local);
  if (local !== gh.headRefOid) {
    await pushBookmark(ctx, "E_LAND_PUSH", e.bookmark, local, e.pr);
    e.triggeredAt = Date.now();
  }
  e.sha = local;
  if (e.isDraft) {
    await exec("E_LAND_READY", ctx.sh`gh pr ready ${e.pr} -R ${ctx.repo}`, { write: true });
    e.isDraft = false;
    e.triggeredAt = Date.now();
    // The issue event the draft-skip rule reads lags the ready call slightly; wait for it so the rule sees it.
    const seen = await pollUntil(
      30,
      async () => await readyEventTime(ctx, "E_LAND_READ_READY_AFTER", e.pr),
      (t) => t !== undefined,
    );
    if (seen === undefined) {
      fail("E_LAND_READY_EVENT_MISSING", `PR #${e.pr} was marked ready but GitHub shows no event`);
    }
  }
  const accepted = await waitForChecks(ctx, e, opts);
  const readyAt = await readyEventTime(ctx, "E_LAND_READ_READY_RECHECK", e.pr);
  const result = await guardedMerge(ctx, e, undefined, async () => {
    const { v, detail } = await readVerdict(ctx, "E_LAND_RECHECK_READ", e, readyAt, true, opts.ignore);
    // A pass, or the same lack of a verdict the wait already accepted under --allow-no-checks; anything else means the
    // checks changed since the wait ended.
    const ok = v === "passed" || v === accepted;
    if (!ok) fail("E_LAND_CHECKS_CHANGED", `PR #${e.pr} checks changed before the merge: ${v} (${detail})`);
  });
  if (result.startsWith("mergeable=")) fail("E_LAND_NOT_MERGEABLE", `PR #${e.pr} is ${result}; refusing to merge`);
  console.log(`JJSTACK_LANDED pr=${e.pr} bookmark=${e.bookmark} head=${e.landedSha} commit=${result} mode=ci`);
  return result;
}

async function ciLand(
  ctx: Ctx,
  args: {
    top: string;
    through?: string;
    expect?: string;
    plan: boolean;
    cleanup: boolean;
    resume: boolean;
    timeoutSec: number;
    allowNoChecks: boolean;
    ignore: string[];
  },
) {
  const { landedBefore, entries, carry, topChange } = await planLanding(ctx, args.top, args.resume);
  if (!args.plan) await clearStaleStop(ctx);
  // `--through` may name a PR the stopped run already landed; then nothing more lands, and the rerun only finishes
  // the restack and cleanup the original command was supposed to do.
  let k = entries.length;
  if (args.through !== undefined) {
    const t = args.through.replace(/^#/, "");
    const named = (e: Entry) => String(e.pr) === t || e.bookmark === t;
    // A PR the stopped run landed may have left the stack; naming it is fine when `--expect` lists it, because
    // `resolveExpect` then proves it merged (it can only sit in the part of `--expect` the plan does not cover).
    const inExpect = args.resume && args.expect !== undefined && /^[0-9]+$/.test(t) &&
      parsePrList("E_USAGE_THROUGH_EXPECT", args.expect).includes(Number(t));
    if (landedBefore.some(named) || (!entries.some(named) && inExpect)) k = 0;
    else {
      k = entries.findIndex(named) + 1;
      if (k === 0) {
        fail(
          "E_LAND_THROUGH_NOT_IN_STACK",
          `--through ${args.through} is not a PR of this stack (pending: ${planOf(entries)}, ` +
            `landed and still in the stack: ${planOf(landedBefore)})`,
        );
      }
    }
  }
  const landing = entries.slice(0, k);
  const remaining = entries.slice(k);
  const landedElsewhere = await resolveExpect(
    ctx,
    { mismatch: "E_LAND_EXPECT_MISMATCH", prefix: "E_LAND_EXPECT_PREFIX" },
    [...landedBefore, ...landing],
    args.expect,
    args.resume,
  );
  console.log(`landing ${ctx.repo} into ${ctx.defaultBranch}, bottom-up, waiting for checks on each PR:`);
  for (const e of [...landedElsewhere, ...landedBefore]) console.log(`  #${e.pr} ${e.bookmark} already landed`);
  for (const e of landing) console.log(`  #${e.pr} ${e.bookmark} ${e.localSha.slice(0, 12)}`);
  if (remaining.length > 0) console.log(`then restacking, not landing: ${remaining.map((e) => `#${e.pr}`).join(" ")}`);
  console.log(
    `JJSTACK_PLAN command=land repo=${ctx.repo} default=${ctx.defaultBranch} prs=${planOf(landing)} ` +
      `landed=${planOf([...landedElsewhere, ...landedBefore])} restack=${planOf(remaining)}`,
  );
  if (args.plan) return;

  for (const e of landing) {
    e.mode = "ci";
    phase = `land #${e.pr}`;
    try {
      await honorStop(ctx, `before starting PR #${e.pr}`);
      await ciLandOne(ctx, e, {
        timeoutSec: args.timeoutSec,
        graceSec: scaled(120_000) / 1000,
        settleSec: scaled(30_000) / 1000,
        allowNoChecks: args.allowNoChecks,
        ignore: args.ignore,
      });
    } catch (err) {
      printStopped(e, [...landedElsewhere, ...landedBefore, ...landing]);
      throw err;
    }
  }
  if (remaining.length > 0) {
    phase = "restack remaining";
    await ctx.fetch("E_LAND_REMAINING_FETCH", true);
    const tip = await ctx.resolve("E_LAND_REMAINING_TIP", ctx.defaultRev);
    const local = await ctx.resolve("E_LAND_REMAINING_RESOLVE", remaining[0].changeId);
    const parent = await exec("E_LAND_REMAINING_PARENT", ctx.sh`git rev-parse ${local + "^"}`);
    if (!(await isAncestor(ctx, "E_LAND_REMAINING_ANCESTRY", parent, tip))) {
      await exec(
        "E_LAND_REMAINING_REBASE",
        ctx.sh`jj ${JJ_SAFE} rebase -s ${remaining[0].changeId} -d ${tip}`,
        { write: true },
      );
    }
    for (const d of remaining) {
      const now = await ctx.resolve("E_LAND_REMAINING_D", d.changeId);
      await verifyContent(ctx, "E_LAND_REMAINING_CONTENT", d, now);
    }
    await submit(ctx, topChange, false, false);
  }
  // With PRs left above, the working copy stays on them; otherwise it follows the landing onto the default branch.
  if (args.cleanup) {
    await cleanup(ctx, [...landedElsewhere, ...landedBefore, ...landing], remaining.length > 0 ? [] : carry);
  }
  phase = "done";
  const now = await ctx.resolve("E_LAND_DONE_TIP", ctx.defaultRev);
  console.log(`landed ${landing.length} PRs; ${ctx.defaultBranch} is at ${now.slice(0, 12)}`);
}

// ---------------------------------------------------------------------------------------------------------------------
// Fast landing (`fast-land`)
// ---------------------------------------------------------------------------------------------------------------------
//
// Lands the whole stack without waiting for CI. Each PR lands in one of two modes, and the switch from the first to the
// second is one-way:
//
// - `github`: retarget the PR to the default branch once its parent is MERGED and squash it as-is. No rebase, no push.
//   This only works while GitHub's three-way merge is clean. A squash commit is never an ancestor of the next PR's
//   head, so the merge base stays at the pre-stack tip for the whole landing, and any later PR that edits a file an
//   earlier PR created or changed conflicts (add/add for created files).
// - `restack`: rebase the PR onto the landed default branch with jj, push only that one bookmark, then squash it. A
//   rebase onto a squash whose tree equals the parent's tree reproduces the PR's own change exactly, so this never
//   needs conflict resolution when the simulation says so. Once one PR is restacked, every PR above it is too: jj has
//   rewritten their local commits, so their GitHub heads no longer match local state.
//
// Before merging anything, the landing is simulated with `git merge-tree` and refused if any PR would need a manual
// conflict resolution. Every merge is then checked against the simulation: the tree GitHub's squash produced must equal
// the predicted tree, which also catches anything else landing on the default branch mid-landing. The simulation is
// what makes skipping CI defensible: no landed tree is content nobody predicted.

/**
 * Predicts each entry's mode and post-squash default-branch tree, starting from `tip` and at index `from`.
 *
 * `github` mode mirrors GitHub's mergeability check: a plain `git merge-tree` of the simulated default branch and the
 * PR head, which finds the same stale merge base GitHub will. `restack` mode mirrors `jj rebase`: a three-way merge
 * with the PR's own parent as the base. Each simulated squash is a real but unreferenced commit object whose parent is
 * the previous one, the same shape GitHub's squash merges give the default branch. `restackFrom` forces restack mode
 * from that index on, for re-simulating after GitHub reports a conflict the prediction missed.
 */
async function simulate(ctx: Ctx, entries: Entry[], from: number, tip: string, restackFrom = Infinity) {
  const mergeTree = (args: string[]) =>
    run("E_SIM_START", ctx.sh`git merge-tree --write-tree --name-only --no-messages ${args}`);
  let sim = tip;
  let mode: Mode = "github";
  for (let i = from; i < entries.length; i++) {
    const e = entries[i];
    if (i >= restackFrom) mode = "restack";
    let tree = "";
    if (mode === "github") {
      const r = await mergeTree([sim, e.sha]);
      if (r.code === 0) tree = r.stdout.trim();
      else if (r.code !== 1) fail("E_SIM_MERGE_TREE", `git merge-tree failed for PR #${e.pr}: ${r.stderr.trim()}`);
      else if (i === 0) {
        fail("E_SIM_BOTTOM_CONFLICT", `bottom PR #${e.pr} conflicts with ${ctx.defaultBranch}: ${conflicts(r.stdout)}`);
      } else mode = "restack";
    }
    if (mode === "restack") {
      const r = await mergeTree(["--merge-base", e.parentSha, sim, e.sha]);
      if (r.code === 1) {
        fail("E_SIM_RESTACK_CONFLICT", `PR #${e.pr} cannot be restacked without resolving: ${conflicts(r.stdout)}`);
      }
      if (r.code !== 0) fail("E_SIM_RESTACK_TREE", `git merge-tree failed for PR #${e.pr}: ${r.stderr.trim()}`);
      tree = r.stdout.trim();
    }
    e.mode = mode;
    e.tree = tree;
    sim = await exec(
      "E_SIM_COMMIT_TREE",
      ctx.sh`git -c user.name=jjstack -c user.email=jjstack@invalid commit-tree ${tree} -p ${sim} \
        -m ${`jjstack simulation of #${e.pr}`}`,
    );
  }
}

/** `git merge-tree --name-only` prints the tree, then the conflicted paths; returns the paths for a message. */
function conflicts(stdout: string): string {
  return stdout.trim().split("\n").slice(1).join(", ");
}

/**
 * Rebases the entry (and with it every jj descendant) onto `tip`, the verified default-branch commit, and pushes only
 * its bookmark, refusing to push unless the rebased tree is the predicted one.
 *
 * Pushing only the PR about to merge is deliberate here. Pushing the whole suffix on every cycle makes a fast landing
 * quadratic in branch updates, and nobody reviews the PRs above during a landing that takes seconds per PR; each gets
 * pushed on its own turn. The push never names a landed bookmark, so a branch GitHub auto-deleted is never recreated.
 */
async function fastRestack(ctx: Ctx, e: Entry, tip: string) {
  await ctx.fetch("E_FAST_FETCH", true);
  await exec("E_FAST_REBASE", ctx.sh`jj ${JJ_SAFE} rebase -s ${e.changeId} -d ${tip}`, { write: true });
  const [row] = parseStack(
    "E_FAST_REBASED_PARSE",
    await exec("E_FAST_REBASED_ROW", ctx.sh`jj ${JJ_SAFE} log --no-graph -r ${e.changeId} -T ${STACK_TEMPLATE}`),
  );
  if (row.conflict) fail("E_FAST_REBASE_CONFLICT", `rebased PR #${e.pr} has conflicts the simulation did not predict`);
  if (!row.bookmarks.includes(e.bookmark)) {
    fail("E_FAST_BOOKMARK_LOST", `bookmark ${e.bookmark} did not follow the rebase of PR #${e.pr}`);
  }
  const tree = await ctx.treeOf("E_FAST_TREE_READ", row.sha);
  if (tree !== e.tree) {
    fail(
      "E_FAST_TREE_MISMATCH",
      `rebased PR #${e.pr} has tree ${tree}, predicted ${e.tree}: the local commit is not the change ` +
        `GitHub shows (unpushed local edits?); nothing was pushed for it`,
    );
  }
  await pushBookmark(ctx, "E_FAST_PUSH", e.bookmark, row.sha, e.pr);
  e.sha = row.sha;
}

/**
 * Lands entry `i` on top of `tip`, the default-branch commit the previous squash produced, and returns the new squash.
 *
 * GitHub's default branch must still be at `tip` before anything happens: a push from elsewhere mid-landing would make
 * every later prediction stale, and stopping before the merge keeps unpredicted content off the default branch. If
 * GitHub reports a conflict the simulation did not predict, this PR and everything above it switch to restack mode,
 * after checking the tip again so a conflict caused by an outside push stops before anything is pushed. The squash is
 * then checked against the simulation. That is the only defense against a push that lands between the last tip check
 * and GitHub executing the merge: such a race can still put one unpredicted squash on the default branch, and the
 * landing stops right after it.
 */
async function fastLandOne(ctx: Ctx, entries: Entry[], i: number, tip: string): Promise<string> {
  const e = entries[i];
  const remoteTip = await ctx.remoteTip("E_FAST_READ_TIP");
  if (remoteTip !== tip) {
    fail("E_FAST_TIP_MOVED", `${ctx.defaultBranch} moved to ${remoteTip} outside this landing; expected ${tip}`);
  }
  if (i > 0 || e.mode === "restack") await retarget(ctx, "E_FAST_RETARGET", e.pr, ctx.defaultBranch);
  if (e.mode === "restack") await fastRestack(ctx, e, tip);
  let result = await guardedMerge(ctx, e, tip);
  if (result === "mergeable=CONFLICTING" && e.mode === "github" && i > 0) {
    const again = await ctx.remoteTip("E_FAST_READ_TIP_CONFLICT");
    if (again !== tip) {
      fail("E_FAST_CONFLICT_TIP_MOVED", `${ctx.defaultBranch} moved to ${again} outside this landing; expected ${tip}`);
    }
    console.log(`PR #${e.pr}: GitHub reports a conflict the simulation missed; restacking from here`);
    await simulate(ctx, entries, i, tip, i);
    await fastRestack(ctx, e, tip);
    result = await guardedMerge(ctx, e, tip);
  }
  if (result.startsWith("mergeable=")) fail("E_FAST_NOT_MERGEABLE", `PR #${e.pr} is ${result}; refusing to merge`);
  const tree = await exec(
    "E_FAST_SQUASH_TREE_READ",
    ctx.sh`gh api ${`repos/${ctx.repo}/git/commits/${result}`} --jq .tree.sha`,
    { retry: true },
  );
  console.log(`JJSTACK_LANDED pr=${e.pr} bookmark=${e.bookmark} head=${e.landedSha} commit=${result} mode=${e.mode}`);
  if (tree !== e.tree) {
    fail(
      "E_FAST_SQUASH_TREE",
      `squash of PR #${e.pr} has tree ${tree}, predicted ${e.tree}: ${ctx.defaultBranch} changed ` +
        `outside this landing or GitHub merged differently`,
    );
  }
  return result;
}

async function fastLand(
  ctx: Ctx,
  args: { top: string; expect?: string; plan: boolean; cleanup: boolean; resume: boolean },
) {
  const { landedBefore, entries, carry } = await planLanding(ctx, args.top, args.resume);
  if (!args.plan) await clearStaleStop(ctx);
  const landedElsewhere = await resolveExpect(
    ctx,
    { mismatch: "E_FAST_EXPECT_MISMATCH", prefix: "E_FAST_EXPECT_PREFIX" },
    [...landedBefore, ...entries],
    args.expect,
    args.resume,
  );
  const start = await ctx.resolve("E_FAST_RESOLVE_START", ctx.defaultRev);
  phase = "simulate";
  await simulate(ctx, entries, 0, start, args.resume ? 0 : Infinity);

  console.log(`landing ${ctx.repo} into ${ctx.defaultBranch} at ${start.slice(0, 12)}, bottom-up, without CI:`);
  for (const e of [...landedElsewhere, ...landedBefore]) console.log(`  #${e.pr} ${e.bookmark} already landed`);
  for (const e of entries) console.log(`  #${e.pr} ${e.bookmark} ${e.sha.slice(0, 12)} ${e.mode}`);
  console.log(
    `JJSTACK_PLAN command=fast-land repo=${ctx.repo} default=${ctx.defaultBranch} prs=${planOf(entries)} ` +
      `landed=${planOf([...landedElsewhere, ...landedBefore])}`,
  );
  if (args.plan) return;

  let tip = start;
  for (const [i, e] of entries.entries()) {
    phase = `land #${e.pr}`;
    try {
      await honorStop(ctx, `before starting PR #${e.pr}`);
      tip = await fastLandOne(ctx, entries, i, tip);
    } catch (err) {
      printStopped(e, [...landedElsewhere, ...landedBefore, ...entries]);
      throw err;
    }
  }
  if (args.cleanup) await cleanup(ctx, [...landedElsewhere, ...landedBefore, ...entries], carry);
  phase = "done";
  const now = await ctx.resolve("E_FAST_DONE_TIP", ctx.defaultRev);
  console.log(`landed ${entries.length} PRs; ${ctx.defaultBranch} is at ${now.slice(0, 12)}`);
}

// ---------------------------------------------------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------------------------------------------------

/**
 * Each command and the options it accepts beyond the shared `--dir`, `--repo`, `--remote`, and `--top`. `paths` marks a
 * command that takes file paths as positional arguments; no other positional argument exists anywhere, so bookmarks and
 * PR numbers are always named by flags.
 */
// deno-fmt-ignore
const COMMANDS = new Map<string, { strings: string[]; booleans: string[]; paths?: boolean }>([
  ["init",      { strings: [],                                                     booleans: [] }],
  ["status",    { strings: [],                                                     booleans: [] }],
  ["submit",    { strings: [],                                                     booleans: ["update-text", "partial"] }],
  ["new-pr",    { strings: ["bookmark", "message-file"],                           booleans: [], paths: true }],
  ["amend",     { strings: ["bookmark", "message-file"],                           booleans: [], paths: true }],
  ["sync",      { strings: [],                                                     booleans: [] }],
  ["publish",   { strings: ["prs"],                                                booleans: [] }],
  ["land",      { strings: ["through", "expect", "check-timeout", "ignore-check"], booleans: ["plan-only", "no-cleanup", "resume", "allow-no-checks"] }],
  ["fast-land", { strings: ["expect"],                                             booleans: ["plan-only", "no-cleanup", "resume"] }],
  ["stop",      { strings: [],                                                     booleans: [] }],
]);

async function main() {
  for (const sig of ["SIGINT", "SIGTERM"] as const) Deno.addSignalListener(sig, () => kill.kill());
  const { command, args } = parseCli(Deno.args);
  commandName = command;
  note(`jjstack pid=${Deno.pid} argv=${Deno.args.map(quoteArg).join(" ")}`);
  // Ledger and narration lines go into the log too, so it reads as one timeline.
  const print = console.log;
  console.log = (...a: unknown[]) => {
    note(`out: ${a.map(String).join(" ")}`);
    print(...a);
  };
  // `stop` must work while a landing holds the checkout and while GitHub is unreachable, so it skips every check.
  if (command === "stop") return await requestStop(args.dir as string);
  if (command === "init") return await init(args as { dir: string; repo?: string; remote: string });
  const ctx = await openCtx(args as { dir: string; repo?: string; remote: string });
  const top = args.top as string;
  if (command === "status") await status(ctx, top);
  else if (command === "submit") await submit(ctx, top, !!args["update-text"], !!args.partial);
  else if (command === "new-pr") {
    if (args.bookmark === undefined) usage("E_USAGE_NEWPR_BOOKMARK", "new-pr needs --bookmark <name>");
    if (args["message-file"] === undefined) usage("E_USAGE_NEWPR_MESSAGE", "new-pr needs --message-file <file>");
    if (top !== "@") usage("E_USAGE_NEWPR_TOP", "new-pr builds on the working copy and takes no --top");
    await newPr(ctx, String(args.bookmark), String(args["message-file"]), args._ as string[]);
  } else if (command === "amend") {
    if (args.bookmark === undefined) usage("E_USAGE_AMEND_BOOKMARK", "amend needs --bookmark <name>");
    if (top !== "@") usage("E_USAGE_AMEND_TOP", "amend takes its changes from the working copy and takes no --top");
    const messageFile = args["message-file"] === undefined ? undefined : String(args["message-file"]);
    await amend(ctx, String(args.bookmark), messageFile, args._ as string[]);
  } else if (command === "sync") await sync(ctx, top);
  else if (command === "publish") await publish(ctx, top, args.prs as string | undefined);
  else if (command === "land") {
    const minutes = args["check-timeout"] === undefined ? 30 : Number(args["check-timeout"]);
    if (!Number.isFinite(minutes) || minutes <= 0) usage("E_USAGE_CHECK_TIMEOUT", "--check-timeout takes minutes > 0");
    await ciLand(ctx, {
      top,
      through: args.through as string | undefined,
      expect: args.expect as string | undefined,
      plan: !!args["plan-only"],
      cleanup: !args["no-cleanup"],
      resume: !!args.resume,
      timeoutSec: minutes * 60,
      allowNoChecks: !!args["allow-no-checks"],
      ignore: args["ignore-check"] === undefined
        ? []
        : String(args["ignore-check"]).split(",").map((n) => n.trim()).filter(Boolean),
    });
  } else {
    await fastLand(ctx, {
      top,
      expect: args.expect as string | undefined,
      plan: !!args["plan-only"],
      cleanup: !args["no-cleanup"],
      resume: !!args.resume,
    });
  }
}

/**
 * Parses the command line strictly: an unknown command, an option the command does not take, a positional argument
 * for a command that takes no paths, or an empty value is a usage error, so a typo never silently runs with defaults.
 */
function parseCli(argv: string[]) {
  const [command, ...rest] = argv;
  const spec = COMMANDS.get(command ?? "");
  if (!spec) usage("E_USAGE_COMMAND", `unknown command '${command ?? ""}'; expected one of: ${[...COMMANDS.keys()]}`);
  const strings = ["dir", "repo", "remote", "top", ...spec.strings];
  const args = parseArgs(rest, {
    // `_` keeps positional paths as strings; otherwise `007` would come back as the number 7.
    string: [...strings, "_"],
    boolean: spec.booleans,
    default: { dir: ".", remote: "origin", top: "@" },
    unknown: (flag) => {
      // parseArgs routes positionals here too; `_` collects them and is checked below.
      if (!flag.startsWith("-")) return true;
      const name = flag.replace(/^--?/, "").replace(/=.*$/, "");
      if (strings.includes(name) || spec.booleans.includes(name)) return true;
      usage("E_USAGE_FLAG", `unknown option ${flag} for ${command}`);
    },
  });
  if (args._.length > 0 && !spec.paths) usage("E_USAGE_POSITIONAL", `unexpected arguments: ${args._.join(" ")}`);
  for (const s of strings) {
    if (typeof args[s] === "string" && args[s] === "") usage("E_USAGE_EMPTY_VALUE", `--${s} needs a value`);
  }
  return { command: command as string, args: args as Record<string, unknown> };
}

// A successful run ends its log with a closing line, so a reader can tell a finished run from a stuck one.
if (import.meta.main) {
  await main().then(() => {
    flushRepeats();
    note("finished ok");
  }).catch(report);
}

// ---------------------------------------------------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------------------------------------------------

/**
 * The error-code contract: an agent runs the printed `grep -n '"<code>"'` and must land on exactly one raising line. A
 * duplicated or reused code would send it to the wrong place, so every quoted `E_` literal in the whole file, tests
 * included, must appear exactly once.
 */
Deno.test("every error code appears exactly once in the file", async () => {
  const src = await Deno.readTextFile(new URL(import.meta.url));
  const seen = new Map<string, number>();
  for (const m of src.matchAll(/"(E_[A-Z0-9_]+)"/g)) seen.set(m[1], (seen.get(m[1]) ?? 0) + 1);
  assertEquals([...seen].filter(([, n]) => n !== 1), []);
});

/**
 * Every jj command must carry `JJ_SAFE`; one bare `jj` call after cleanup's branch deletes would let jj's import
 * abandon landed commits that side work still builds on.
 */
Deno.test("every jj command in the file passes JJ_SAFE", async () => {
  const src = await Deno.readTextFile(new URL(import.meta.url));
  const body = src.slice(0, src.lastIndexOf("// Tests\n"));
  assertEquals([...body.matchAll(/(?:sh|\$|\))`jj \$\{JJ_SAFE\}/g)].length > 5, true);
  const bare = [...body.matchAll(/(?:sh|\$|\))`jj (?!\$\{JJ_SAFE\})/g)].map((m) => body.slice(m.index, m.index + 40));
  assertEquals(bare, []);
});

const row = (sha: string, over: Partial<StackRow> = {}): StackRow => ({
  sha,
  changeId: `c${sha}`,
  empty: false,
  conflict: false,
  parents: ["p"],
  bookmarks: [`b${sha}`],
  ...over,
});

/** A linear chain of rows `1..n`, each the parent of the next, the shape every command expects. */
const chain = (n: number): StackRow[] =>
  Array.from({ length: n }, (_, i) => row(String(i + 1), { parents: [i === 0 ? "base" : String(i)] }));

const TEST_CODE = "E_TEST_ONLY";

/** The parser is the boundary between jj's template output and every guard after it; a shifted field breaks all. */
Deno.test("parseStack reads every field, including empty bookmark and multi-parent lists", () => {
  const out = "s1 c1 nonempty ok p0 pr/a\ns2 c2 empty ok s1 \ns3 c3 nonempty conflict s2,x pr/b,pr/c\n";
  assertEquals(parseStack(TEST_CODE, out), [
    { sha: "s1", changeId: "c1", empty: false, conflict: false, parents: ["p0"], bookmarks: ["pr/a"] },
    { sha: "s2", changeId: "c2", empty: true, conflict: false, parents: ["s1"], bookmarks: [] },
    { sha: "s3", changeId: "c3", empty: false, conflict: true, parents: ["s2", "x"], bookmarks: ["pr/b", "pr/c"] },
  ]);
  assertThrows(() => parseStack(TEST_CODE, "too few fields\n"), JjstackError, "unexpected jj log line");
});

/** Each refusal guards a way the squash-per-PR model would land or review something other than one unit per PR. */
Deno.test("reviewUnits skips the empty working copy and refuses shapes that are not one bookmark per commit", () => {
  const wc = row("3", { empty: true, bookmarks: [], parents: ["2"] });
  assertEquals(reviewUnits([...chain(2), wc]).map((u) => u.bookmark), ["b1", "b2"]);
  assertThrows(() => reviewUnits([row("1", { bookmarks: [] })]), JjstackError, "folded");
  assertThrows(() => reviewUnits([row("1", { bookmarks: ["a", "b"] })]), JjstackError, "several");
  assertThrows(() => reviewUnits([row("1", { parents: ["a", "b"] })]), JjstackError, "2 parents");
  assertThrows(() => reviewUnits([row("1", { conflict: true })]), JjstackError, "conflicts");
  assertThrows(() => reviewUnits([row("1", { empty: true, bookmarks: [] })]), JjstackError, "no bookmarked");
  // Two heads on one base: B and C are siblings, so C must not be treated as the PR above B.
  const siblings = [row("1"), row("2", { parents: ["1"] }), row("3", { parents: ["1"] })];
  assertThrows(() => reviewUnits(siblings), JjstackError, "not one chain");
});

const openPr = (n: number, head: string, base: string, oid: string, fork = false): OpenPr => ({
  number: n,
  headRefName: head,
  baseRefName: base,
  headRefOid: oid,
  isCrossRepository: fork,
  isDraft: true,
});

/** The base chain and head checks are what stop a landing through a stack GitHub sees differently from jj. */
Deno.test("matchPrs requires one same-repo PR per bookmark, a matching base chain, and matching heads", () => {
  const units = reviewUnits(chain(2));
  const ok = [openPr(10, "b1", "main", "1"), openPr(11, "b2", "b1", "2"), openPr(99, "b2", "main", "x", true)];
  assertEquals(matchPrs(units, ok, "main").map((e) => [e.pr, e.plannedSha]), [[10, "1"], [11, "2"]]);
  assertThrows(() => matchPrs(units, [ok[0], openPr(11, "b2", "main", "2")], "main"), JjstackError, "expected 'b1'");
  assertThrows(() => matchPrs(units, [ok[0], openPr(11, "b2", "b1", "old")], "main"), JjstackError, "does not show");
  assertThrows(() => matchPrs(units, [ok[0]], "main"), JjstackError, "got 0");
  // Resuming: GitHub's head is the planned content even though the local commit was rebased.
  const resumed = matchPrs(units, [ok[0], openPr(11, "b2", "b1", "gh2")], "main", []);
  assertEquals(resumed.map((e) => [e.plannedSha, e.localSha, e.mode]), [["1", "1", "restack"], [
    "gh2",
    "2",
    "restack",
  ]]);
});

/** A wrong answer here makes `--resume` skip a PR that still needs landing, or clean up one that does. */
Deno.test("landedAs matches by branch identity, not by head SHA alone", () => {
  const merged: MergedPr[] = [{ number: 2, headRefName: "tmp/one", headRefOid: "h" }];
  assertEquals(landedAs(row("h", { bookmarks: ["tmp/one"] }), merged, [])?.number, 2);
  assertEquals(landedAs(row("h", { bookmarks: [] }), merged, [])?.number, 2);
  assertEquals(landedAs(row("h", { bookmarks: ["pr/one"] }), merged, []), undefined);
  assertEquals(landedAs(row("h", { bookmarks: ["tmp/one"] }), merged, [openPr(1, "tmp/one", "main", "h")]), undefined);
  const twice = [...merged, { number: 3, headRefName: "tmp/two", headRefOid: "h" }];
  assertEquals(landedAs(row("h", { bookmarks: [] }), twice, []), undefined);
});

/** A false positive here is what would let a push or branch deletion land in a repository the guards never read. */
Deno.test("remoteNamesRepo accepts the usual URL forms of one repo and rejects a mismatched push URL", () => {
  const [host, repo] = ["github.com", "scode/repotesting"];
  assertEquals(remoteNamesRepo(["https://github.com/scode/repotesting.git"], host, repo), true);
  assertEquals(
    remoteNamesRepo(["git@github.com:Scode/RepoTesting", "ssh://git@github.com:22/scode/repotesting/"], host, repo),
    true,
  );
  assertEquals(
    remoteNamesRepo(["https://github.com/scode/repotesting", "git@github.com:fork/repotesting.git"], host, repo),
    false,
  );
  // Same owner/name on another host is a different repository; an ssh alias does not name the host at all.
  assertEquals(remoteNamesRepo(["ssh://git@ghe.example/scode/repotesting.git"], host, repo), false);
  assertEquals(remoteNamesRepo(["work:scode/repotesting.git"], host, repo), false);
  assertEquals(remoteNamesRepo(["https://github.com/scode/repotesting-old"], host, repo), false);
  assertEquals(remoteNamesRepo([], host, repo), false);
});

/** `--expect` is the only guard between the announced plan and the landing run; a lax parser weakens it. */
Deno.test("parsePrList accepts comma-separated PR numbers and rejects anything else", () => {
  assertEquals(parsePrList(TEST_CODE, "175, 176,177"), [175, 176, 177]);
  for (const bad of ["175,x", "", "#175"]) {
    assertThrows(() => parsePrList(TEST_CODE, bad), JjstackError, "comma-separated");
  }
});

/**
 * The command line is the agent's whole interface: a flag silently ignored (or a `--no-` flag read as a negation)
 * would run a landing with defaults the agent did not ask for.
 */
Deno.test("parseCli keeps per-command options, including --no-cleanup, and rejects everything else", () => {
  const fast = parseCli(["fast-land", "--dir", "/x", "--no-cleanup", "--expect", "1,2"]);
  assertEquals([fast.command, fast.args.dir, fast.args["no-cleanup"], fast.args.expect], [
    "fast-land",
    "/x",
    true,
    "1,2",
  ]);
  assertEquals(parseCli(["fast-land"]).args["no-cleanup"], false);
  assertEquals(parseCli(["submit", "--update-text"]).args["update-text"], true);
  assertEquals(parseCli(["land", "--through", "#12", "--allow-no-checks"]).args.through, "#12");
  assertThrows(() => parseCli(["submit", "--expect", "1"]), JjstackError, "unknown option");
  assertThrows(() => parseCli(["status", "extra"]), JjstackError, "unexpected arguments");
  assertThrows(() => parseCli(["status", "--top="]), JjstackError, "needs a value");
  assertThrows(() => parseCli(["nope"]), JjstackError, "unknown command");
  assertThrows(() => parseCli([]), JjstackError, "unknown command");
  // Positional arguments are paths, and only commands that take paths accept them, as strings even when numeric.
  const pr = parseCli(["new-pr", "--bookmark", "b", "--message-file", "/m", "src/a.ts", "007", "1e3"]);
  assertEquals([pr.args.bookmark, pr.args["message-file"], pr.args._], ["b", "/m", ["src/a.ts", "007", "1e3"]]);
  assertEquals(parseCli(["new-pr", "--bookmark", "b"]).args._, []);
});

/**
 * `publish` and `ci` act only on PRs GitHub shows as the local stack has them, so this selection decides whether CI can
 * start on code nobody has locally. A PR below the selected ones counts too, a PR GitHub still shows at an old head
 * counts even when the remote branch already moved, and a list naming a PR outside the stack is refused.
 */
Deno.test("selectSynced picks listed or all PRs bottom-up and refuses stale ones up to the topmost selected", () => {
  const step = (n: number, stale: Partial<SubmitStep> = {}, ghHead = `sha${n}`): SubmitStep => ({
    unit: { sha: `sha${n}`, changeId: `c${n}`, parentSha: `sha${n - 1}`, bookmark: `b${n}` },
    base: n === 1 ? "main" : `b${n - 1}`,
    pr: {
      number: n,
      headRefName: `b${n}`,
      baseRefName: n === 1 ? "main" : `b${n - 1}`,
      headRefOid: ghHead,
      isCrossRepository: false,
      isDraft: true,
    },
    title: "t",
    body: "",
    retarget: false,
    push: false,
    create: false,
    retext: false,
    ...stale,
  });
  const codes = { list: "E_TEST_SELECT_LIST", missing: "E_TEST_SELECT_MISSING", unsynced: "E_TEST_SELECT_UNSYNCED" };
  const pick = (steps: SubmitStep[], prs?: string) => selectSynced(codes, steps, prs).map((st) => st.pr!.number);
  assertEquals(pick([step(1), step(2), step(3)]), [1, 2, 3]);
  assertEquals(pick([step(1), step(2), step(3)], "3,1"), [1, 3]);
  // Stale above the topmost selected PR does not matter; stale at or below it does.
  assertEquals(pick([step(1), step(2), step(3, { push: true })], "2"), [2]);
  assertThrows(() => pick([step(1, { retarget: true }), step(2)], "2"), JjstackError, "run submit first");
  assertThrows(() => pick([step(1), step(2, {}, "old")], "2"), JjstackError, "run submit first");
  assertThrows(() => pick([step(1), step(2, { pr: undefined, create: true })]), JjstackError, "run submit first");
  assertThrows(() => pick([step(1)], "1,9"), JjstackError, "#9");
});

/** The log is only as useful as its command lines are readable and copy-pasteable. */
Deno.test("renderCommand shows interpolated values as shell words, quoting only where needed", () => {
  const sh = shellIn("/tmp");
  const b = sh`gh pr merge ${12} --subject ${"feat: x (#12)"} ${["--squash", "a'b"]}`;
  assertEquals(commandText.get(b), `gh pr merge 12 --subject 'feat: x (#12)' --squash 'a'\\''b'`);
});

/** Resets the run log's module state, so each log test starts from nothing and leaves nothing behind. */
function resetLog() {
  flushRepeats();
  early.length = 0;
  earlyDropped = 0;
  logPath = undefined;
  logBroken = false;
  logBytes = 0;
  logMovedFrom = undefined;
  lastReads.clear();
}

/**
 * The run log is how an agent watches a long landing: it must stream from the first line, keep earlier lines, and stay
 * readable during long waits, so identical polls collapse into a count, with when they happened, once the result
 * changes.
 */
Deno.test("the run log streams and compacts repeated polls into a count", async () => {
  resetLog();
  const dir = await Deno.makeTempDir();
  try {
    note("before the file exists");
    const path = openLog(dir, "land")!;
    const file = `${dir}/state`;
    const sh = shellIn(dir);
    const poll = async () => await run(TEST_CODE, sh`cat ${file}`, { poll: true });
    await Deno.writeTextFile(file, "pending\n");
    for (let i = 0; i < 4; i++) await poll();
    await Deno.writeTextFile(file, "passed\n");
    await poll();
    const lines = (await Deno.readTextFile(path)).trim().split("\n");
    assertEquals(lines[0].endsWith("before the file exists"), true);
    const polls = lines.filter((l) => l.includes(`cat ${file}`));
    // The first poll, a count for the three identical ones after it, then the changed one.
    assertEquals(polls.length, 3);
    assertEquals(/repeated 3 more times .* to .*, during/.test(polls[1]), true);
    assertEquals(finalLog(), path);
  } finally {
    resetLog();
    await Deno.remove(dir, { recursive: true });
  }
});

/**
 * Compaction must never hide a change of state: only reads marked as polls compact, and a write or a failure ends a
 * poll sequence so the next read after it is logged in full, with any pending count flushed first.
 */
Deno.test("only polls compact, and writes, failures, and stops end a poll sequence", async () => {
  resetLog();
  const dir = await Deno.makeTempDir();
  try {
    const path = openLog(dir, "land")!;
    const sh = shellIn(dir);
    await Deno.writeTextFile(`${dir}/state`, "x\n");
    const read = async (poll: boolean) => await run(TEST_CODE, sh`cat ${`${dir}/state`}`, { poll });
    await read(false);
    await read(false);
    await read(true);
    await read(true);
    await run(TEST_CODE, sh`cat ${`${dir}/missing`}`, { poll: true });
    await read(true);
    await read(true);
    flushRepeats();
    const text = await Deno.readTextFile(path);
    const full = text.split("\n").filter((l) => /exit=0 .*cat .*state/.test(l));
    // Two plain reads, the first poll, and the first poll after the failure are logged in full.
    assertEquals(full.length, 4);
    assertEquals((text.match(/repeated 1 more times/g) ?? []).length, 2);
    assertEquals(/exit=1 .*cat .*missing/.test(text), true);
  } finally {
    resetLog();
    await Deno.remove(dir, { recursive: true });
  }
});

/**
 * Concurrent runs in one checkout must not share, truncate, or delete each other's logs: names are unique even within
 * a millisecond, and pruning keeps any log modified in the last hour on top of the 20 newest. An unwritable directory
 * costs the file log, never the run.
 */
Deno.test("log files are unique, live logs survive pruning, and an unwritable directory is not fatal", async () => {
  resetLog();
  const dir = await Deno.makeTempDir();
  try {
    const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000);
    for (let i = 0; i < 25; i++) {
      const f = `${dir}/2000-01-01-${String(i).padStart(2, "0")}.log`;
      await Deno.writeTextFile(f, "old");
      await Deno.utime(f, twoHoursAgo, twoHoursAgo);
    }
    // The oldest name, but still being written: a landing that started long before the others.
    await Deno.writeTextFile(`${dir}/1999-12-31-live.log`, "live");
    const a = openLog(dir, "status")!;
    resetLog();
    const b = openLog(dir, "status")!;
    assertEquals(a !== b, true);
    const names = [...Deno.readDirSync(dir)].map((f) => f.name);
    assertEquals(names.includes("1999-12-31-live.log"), true);
    assertEquals(names.filter((n) => n.startsWith("2000-")).length, 18);
    resetLog();
    assertEquals(openLog("/proc/forbidden/jjstack", "land"), undefined);
    note("kept in memory");
    const fallback = finalLog()!;
    assertEquals((await Deno.readTextFile(fallback)).includes("kept in memory"), true);
    await Deno.remove(fallback);
  } finally {
    resetLog();
    await Deno.remove(dir, { recursive: true });
  }
});

/**
 * A stop request is only honored by the landing it was meant for: a leftover one is cleared at the start, a fresh one
 * stops the landing at the next safe point exactly once.
 */
Deno.test("stop requests are cleared when stale and consumed when honored", async () => {
  const dir = await Deno.makeTempDir();
  try {
    const ctx = new Ctx(dir, "o/r", "origin", "main", `${dir}/jjstack-stop`);
    await Deno.writeTextFile(ctx.stopPath, "old\n");
    await clearStaleStop(ctx);
    assertEquals(await stopRequested(ctx.stopPath), false);
    await honorStop(ctx, "before starting PR #1");
    await Deno.writeTextFile(ctx.stopPath, "new\n");
    await assertRejects(() => honorStop(ctx, "before starting PR #2"), JjstackError, "stopped on request");
    assertEquals(await stopRequested(ctx.stopPath), false);
  } finally {
    await Deno.remove(dir, { recursive: true });
  }
});

/** `submit` decides what to push from this parse; a misread remote target means a skipped or needless push. */
Deno.test("parseBookmarks separates local and chosen-remote views and ignores other remotes", () => {
  const out = "a - untracked ok 111\na git tracked ok 111\na origin tracked ok 222\n" +
    "b - untracked conflict -\nc origin untracked ok 333\n";
  const refs = parseBookmarks(out, "origin");
  assertEquals(refs.get("a"), { local: "111", remote: "222", tracked: true, conflict: false });
  assertEquals(refs.get("b"), { local: undefined, tracked: false, conflict: true });
  assertEquals(refs.get("c"), { remote: "333", tracked: false, conflict: false });
  assertThrows(() => parseBookmarks("a b\n", "origin"), JjstackError, "unexpected jj bookmark line");
});

/** PR text comes from commit descriptions; a body that keeps the title or loses paragraphs misstates the change. */
Deno.test("splitDescription takes the first line as title and the rest after blank lines as body", () => {
  assertEquals(splitDescription("feat: x\n\nwhy one\n\nwhy two\n"), { title: "feat: x", body: "why one\n\nwhy two" });
  assertEquals(splitDescription("feat: x\n"), { title: "feat: x", body: "" });
  assertEquals(splitDescription(""), { title: "", body: "" });
});

/**
 * The check verdict is what a CI-gated landing merges on. Every misclassification here is either a merge without a
 * real verdict (the draft-skipped trap, a half-attached rollup) or a landing that never finishes (superseded runs).
 */
Deno.test("checkVerdict separates pass, fail, pending, no verdict, and runs skipped while the PR was a draft", () => {
  const at = (s: number) => new Date(Date.UTC(2026, 9, 17, 0, 0, s)).toISOString();
  const run = (name: string, conclusion: string, started = 10, status = "COMPLETED"): Check => ({
    __typename: "CheckRun",
    workflowName: "PR",
    name,
    status,
    conclusion,
    startedAt: at(started),
    completedAt: status === "COMPLETED" ? at(started + 1) : undefined,
  });
  // Far past every fixture timestamp, so recent-cancellation handling only applies where a test asks for it.
  const late = Date.parse(at(10_000));
  const v = (rollup: Check[], readyAt?: number, grace = false, running: string[] = [], postReady = true) =>
    checkVerdict(rollup, { running, postReady }, readyAt, grace, [], late).v;
  const readyAt = Date.parse(at(20));
  assertEquals(v([]), "none");
  assertEquals(v([run("a", "SUCCESS"), run("b", "SKIPPED")]), "passed");
  assertEquals(v([run("a", "SUCCESS"), run("b", "FAILURE")]), "failed");
  assertEquals(v([run("a", "", 10, "IN_PROGRESS"), run("b", "FAILURE")]), "failed");
  assertEquals(v([run("a", "", 10, "QUEUED")]), "pending");
  assertEquals(v([run("a", "SKIPPED"), run("b", "SKIPPED")], undefined, true), "none");
  // A suite still working on a `needs:` job keeps an all-green rollup pending.
  assertEquals(v([run("build", "SUCCESS")], undefined, false, ["github-actions:in_progress"]), "pending");
  // Skipped before the ready event: pending during the grace period, then a refusal-worthy verdict.
  assertEquals(v([run("lint", "SUCCESS"), run("test", "SKIPPED")], readyAt, false), "pending");
  assertEquals(v([run("lint", "SUCCESS"), run("test", "SKIPPED")], readyAt, true), "stale-skipped");
  // Skipped after the ready event is a real decision of the workflow, not a draft leftover...
  assertEquals(v([run("lint", "SUCCESS"), run("test", "SKIPPED", 30)], readyAt, false), "passed");
  // ...unless no Actions suite was created after the ready event: then it ran on a draft-era payload, just late.
  assertEquals(v([run("lint", "SUCCESS"), run("test", "SKIPPED", 30)], readyAt, true, [], false), "stale-skipped");
  // Superseded runs: the newest run of each check decides, whichever way the old one went.
  assertEquals(v([run("test", "SKIPPED", 5), run("test", "SUCCESS", 30)], readyAt, true), "passed");
  assertEquals(v([run("test", "FAILURE", 5), run("test", "SUCCESS", 30)]), "passed");
  assertEquals(v([run("test", "CANCELLED", 5), run("test", "", 30, "IN_PROGRESS")]), "pending");
  // A cancellation with no replacement yet is pending for two minutes after it ended, then a failure.
  const cancelled = [run("lint", "SUCCESS"), run("test", "CANCELLED", 40)];
  const verdictAt = (s: number) =>
    checkVerdict(cancelled, { running: [], postReady: true }, undefined, false, [], Date.parse(at(s))).v;
  assertEquals(verdictAt(60), "pending");
  assertEquals(verdictAt(200), "failed");
  assertEquals(v([run("test", "SUCCESS", 30), run("test", "", 5, "QUEUED")]), "pending");
  // Two apps' checks with the same name are independent verdicts: a later success must not hide a failure.
  const app = (conclusion: string, started: number): Check => ({
    ...run("test", conclusion, started),
    workflowName: "",
  });
  assertEquals(v([app("FAILURE", 5), app("SUCCESS", 30)]), "failed");
  // A check the user declared optional does not block; everything else still does.
  assertEquals(
    checkVerdict([run("lint", "SUCCESS"), run("exp", "FAILURE")], { running: [], postReady: true }, undefined, false, [
      "exp",
    ]).v,
    "passed",
  );
  const status = (state: string): Check => ({ __typename: "StatusContext", context: "ci/legacy", state });
  assertEquals(v([status("PENDING")]), "pending");
  assertEquals(v([status("ERROR")]), "failed");
  assertEquals(v([status("SUCCESS")]), "passed");
});

/**
 * Every poll and retry waits on this schedule. Fixed intervals made fast states slow to notice and slow states (a long
 * CI run) polled needlessly often; the schedule starts at one second and never polls more than once a minute.
 */
Deno.test("backoff starts at one second, grows, and caps at one poll a minute", () => {
  assertEquals([0, 1, 2, 3, 4, 5].map((n) => backoff(n) / TIME_SCALE), [1000, 2000, 3000, 5000, 7000, 10000]);
  const tail = [10, 11, 50, 1000].map((n) => backoff(n) / TIME_SCALE);
  assertEquals(tail, [60000, 60000, 60000, 60000]);
  for (let n = 1; n < 20; n++) assert(backoff(n) >= backoff(n - 1), `backoff(${n}) shrank`);
});

/**
 * The settle period is measured from `lastTrigger`, so it must name the latest event that can attach new runs: a
 * pass long after the last push or ready event then counts at once, and a fresh one still waits for stragglers.
 */
Deno.test("lastTrigger takes the later of the ready event and the newest check suite", () => {
  const suites = (latestCreated?: number): Suites => ({ running: [], postReady: true, latestCreated });
  assertEquals(lastTrigger(undefined, suites()), undefined);
  assertEquals(lastTrigger(100, suites()), 100);
  assertEquals(lastTrigger(undefined, suites(200)), 200);
  assertEquals(lastTrigger(300, suites(200)), 300);
  assertEquals(lastTrigger(100, suites(200)), 200);
  assertEquals(lastTrigger(undefined, suites(NaN)), undefined);
});

/**
 * The settle period must never start before this run's own push or ready call: right after a push, before GitHub has
 * created a suite for the new head, the newest trigger GitHub shows can be a ready event from days ago, and measuring
 * from it would let a fast commit status pass before slower CI posts anything.
 */
Deno.test("settleStart takes the later of GitHub's trigger and this run's own, else the start of the wait", () => {
  assertEquals(settleStart(undefined, undefined, 50), 50);
  assertEquals(settleStart(10, undefined, 50), 10);
  assertEquals(settleStart(undefined, 40, 50), 40);
  assertEquals(settleStart(10, 40, 50), 40);
  assertEquals(settleStart(45, 40, 50), 45);
});

/**
 * The simulation decides whether a fast landing may start at all, so it is tested against real git: the postmortem's
 * shape (a later PR appending to a file an earlier PR created) must switch to restack at that PR and predict the
 * top-of-stack tree, and a PR whose own diff collides with the default branch must be refused before anything merges.
 * `verifyContent` is tested in the same repo: it is the check that keeps a landing from pushing unreviewed content.
 */
Deno.test("simulate predicts the restack switch point; verifyContent accepts rebases and rejects edits", async () => {
  const dir = await Deno.makeTempDir();
  try {
    const g = (args: string[]) => $`git ${args}`.cwd(dir).env({ GIT_AUTHOR_NAME: "t", GIT_COMMITTER_NAME: "t" });
    await g(["init", "-q", "-b", "main"]);
    await g(["config", "user.email", "t@t"]);
    const commit = async (files: Record<string, string>) => {
      for (const [p, c] of Object.entries(files)) await Deno.writeTextFile(`${dir}/${p}`, c);
      await g(["add", "-A"]);
      await g(["commit", "-q", "-m", "x"]);
      return await g(["rev-parse", "HEAD"]).text();
    };
    const base = await commit({ "readme": "r\n" });
    const c1 = await commit({ "a": "a\n" });
    const c2 = await commit({ "log": "1\n" });
    const c3 = await commit({ "log": "1\n3\n" });
    const c4 = await commit({ "b": "b\n" });
    const ctx = new Ctx(dir, "o/r", "origin", "main");
    const mk = (pr: number, sha: string, parentSha: string): Entry => ({
      pr,
      bookmark: `b${pr}`,
      changeId: "",
      plannedSha: sha,
      sha,
      localSha: sha,
      parentSha,
      isDraft: true,
      mode: "github",
      tree: "",
    });
    const entries = [mk(1, c1, base), mk(2, c2, c1), mk(3, c3, c2), mk(4, c4, c3)];
    await simulate(ctx, entries, 0, base);
    assertEquals(entries.map((e) => e.mode), ["github", "github", "restack", "restack"]);
    assertEquals(entries[3].tree, await ctx.treeOf(TEST_CODE, c4));

    // The default branch rewrote the line PR 3 appends after, so neither GitHub's merge nor a rebase can be clean.
    await g(["checkout", "-q", base]);
    const moved = await commit({ "readme": "r\n", "log": "other\n" });
    const fresh = [mk(1, c1, base), mk(2, c2, c1)];
    await assertRejects(() => simulate(ctx, fresh, 0, moved), JjstackError, "cannot be restacked");

    // A faithful rebase of PR 1 onto `moved` passes; the same commit re-indented (equal under `patch-id --stable`)
    // does not.
    const rebased = await commit({ "a": "a\n" });
    await verifyContent(ctx, TEST_CODE, mk(1, c1, base), rebased);
    await g(["checkout", "-q", moved]);
    const reindented = await commit({ "a": "  a\n" });
    await assertRejects(
      () => verifyContent(ctx, TEST_CODE, mk(1, c1, base), reindented),
      JjstackError,
      "not the change",
    );
  } finally {
    await Deno.remove(dir, { recursive: true });
  }
});
