Deno.test("the review cap escalates right after the last 'changes' verdict, with the review's path", async () => {
  const plan = { ...testPlan(1), limits: { reviewRounds: 2 } };
  const w = fakeWorld(plan, { worker: () => done(1), reviews: [changes(), changes()] });
  const e = escalationOf(await w.run());
  assertEq(e.reason, "review-rounds-exhausted");
  assertIncludes(e.detail, "/run/items/p1/review-2/review.json");
  assertEq(w.calls.filter((c) => c.startsWith("worker")), ["worker p1#1", "worker p1#2"]);
});

Deno.test("a reviewer 'approve' with a blocking finding counts as changes", () => {
  const r = parseReview(JSON.stringify({ verdict: "approve", findings: JSON.parse(changes()).findings }));
  assertEq(r?.verdict, "changes");
});

Deno.test("unparseable reviewer output is retried once, in its own directory, then escalates", async () => {
  const plan = testPlan(1);
  const dirs: string[] = [];
  const w = fakeWorld(plan, { worker: () => done(1), reviews: [undefined, "nope"] });
  const real = w.ops.runReviewer;
  w.ops.runReviewer = (a) => (dirs.push(a.dir), real(a));
  assertEq(escalationOf(await w.run()).reason, "reviewer-failed");
  assertEq(dirs, ["/run/items/p1/review-1", "/run/items/p1/review-1-attempt-2"]);
});

Deno.test("the session cap escalates, and resuming after it grants the item a fresh budget", async () => {
  const plan = { ...testPlan(1), limits: { sessionsPerItem: 2 } };
  let ok = false;
  const w = fakeWorld(plan, { worker: () => ok ? done(1) : undefined, reviews: [approve] });
  const e = escalationOf(await w.run());
  assertEq(e.reason, "sessions-exhausted");
  prepareResume(w.state, e);
  assertEq(w.state.items[0].escalations, 1);
  ok = true;
  assertEq(await w.run(), { done: true });
  assertEq(w.state.items[0].sessions, 3);
});

Deno.test("resume re-verifies an item caught mid-review and forgets the dead runner's session", () => {
  const plan = testPlan(2);
  const state: State = {
    version: 1,
    nonce: "x",
    current: { item: "p1", session: 2 },
    workerPid: 4242,
    items: plan.items.map((i) => emptyItem(i.id)),
  };
  state.items[0].phase = "reviewing";
  prepareResume(state, undefined);
  assertEq([state.items[0].phase, state.current, state.workerPid, state.items[0].escalations], [
    "verifying",
    undefined,
    undefined,
    0,
  ]);
});

Deno.test("reconcile keeps approved history fixed and lets the rest follow the plan", () => {
  const plan = testPlan(3);
  const state: State = { version: 1, nonce: "x", items: plan.items.map((i) => emptyItem(i.id)) };
  state.items[0].phase = "approved", state.items[0].approvedSpec = specHash("s1");
  const edited = { ...plan, items: [plan.items[0], { id: "new", title: "n", spec: "n" }, plan.items[2]] };
  const ok = reconcile(edited, state);
  if ("error" in ok) throw new Error(ok.error);
  assertEq(ok.items.map((i) => i.id), ["p1", "new", "p3"]);
  const moved = reconcile({ ...plan, items: [plan.items[1], plan.items[0]] }, state);
  if (!("error" in moved)) throw new Error("reordering an approved item must be refused");
  const respec = reconcile({ ...plan, items: [{ ...plan.items[0], spec: "changed" }, ...plan.items.slice(1)] }, state);
  if (!("error" in respec)) throw new Error("changing an approved spec must be refused");
});

/** A plan's policy fields, filled in, as a goal file's supervisor would supply them, over a three-item stack. */
function policyPlan(): Plan {
  const plan = testPlan(3);
  plan.reviewCharter = "Check correctness, and whether a simpler shape would do. Report findings to /tmp/f.md.";
  plan.workerRules = ["Do not add code a later PR deletes; restructure instead."];
  plan.items[1].checks = ["cargo test -p ui"];
  return plan;
}

/** A PR for the reviewer-prompt tests. */
function testPr(): PrInfo {
  return {
    url: url(1),
    number: 1,
    repo: "o/r",
    state: "OPEN",
    isDraft: true,
    headRef: "b1",
    head: "sha1",
    baseRef: "main",
  };
}

Deno.test("a plan without the policy fields gets exactly the prompts it got before they existed", () => {
  // Direct shepherd runs must not change because goal-file runs can supply policy. The whole default judging section
  // is pinned, not a prefix, so that dropping a sentence from it fails here.
  const plan = testPlan(1);
  const states = plan.items.map((i) => emptyItem(i.id));
  const review = reviewerPrompt({ plan, index: 0, states, pr: testPr(), baseSha: "base" });
  if (!review.endsWith(`\n\n${DEFAULT_REVIEW_SECTION}\n`)) {
    throw new Error(`default review section changed:\n${review}`);
  }
  assertEq(
    DEFAULT_REVIEW_SECTION,
    `## What to report\n\nJudge the diff against what this item must do and against ordinary code quality: ` +
      `correctness, missing or wrong tests, behavior the spec asks for that is absent, work that belongs to other ` +
      `items, and documentation the change makes wrong. A finding is "blocking" when the PR should not stand without ` +
      `the fix, "minor" otherwise. Do not raise style preferences the repository does not already follow. Return ` +
      `verdict "changes" exactly when there is at least one blocking finding.`,
  );
  const work = workerPrompt({ plan, runDir: "/run", index: 0, states, nonce: "n", reportPath: "/r" });
  assertIncludes(work, `the PR diff before the next item starts. ${REVIEW_RULE}\n\n## The supervisor channel`);
  assertEq(itemChecks(plan, 0), ["make test"]);
});

Deno.test("a review charter replaces only the general judging text; scope, reporting, and the verdict stay the runner's", () => {
  // A goal file's charter knows nothing about this item's spec, and tells its reviewer to write findings to a file;
  // without the runner's own sections, scope drift would go unflagged and file-only findings would read as approval.
  const plan = policyPlan();
  const states = plan.items.map((i) => emptyItem(i.id));
  const review = reviewerPrompt({ plan, index: 0, states, pr: testPr(), baseSha: "base" });
  assertIncludes(review, "## What this review must cover\n\nJudge the diff against what this item must do");
  assertIncludes(review, "work that belongs to other items");
  assertIncludes(review, "## How to review\n\nCheck correctness, and whether a simpler shape would do.");
  assertIncludes(review, "Every finding goes in the `findings` array of your final message");
  assertIncludes(review, VERDICT_RULE);
  if (review.includes(DEFAULT_REVIEW_SECTION)) throw new Error("the default judging section must give way");
});

Deno.test("a review that says changes but reports no blocking finding is not taken as approval", () => {
  // Its findings went somewhere the runner does not read; approving on the empty list would wave the PR through.
  assertEq(parseReview(JSON.stringify({ verdict: "changes", findings: [] })), undefined);
  assertEq(
    parseReview(
      JSON.stringify({ verdict: "changes", findings: [{ severity: "minor", location: "a", problem: "p", fix: "f" }] }),
    ),
    undefined,
  );
  assertEq(parseReview(JSON.stringify({ verdict: "approve", findings: [] }))?.verdict, "approve");
});

Deno.test("worker rules reach the worker under the runner's precedence, and item checks accumulate up the stack", async () => {
  // Item checks accumulate because a later PR is stacked on the earlier ones and could break their targeted tests.
  const plan = policyPlan();
  const w = fakeWorld(plan, { worker: (item) => done(Number(item.slice(1))), reviews: [approve, approve, approve] });
  assertEq(await w.run(), { done: true });
  const p1 = w.files.get("prompt:p1#1")!;
  assertIncludes(p1, "the rule above wins, and you report replan instead:\n  - Do not add code a later PR deletes");
  if (p1.includes("cargo test -p ui")) throw new Error("item 2's checks leaked to item 1");
  assertIncludes(w.files.get("prompt:p3#1"), "  - `cargo test -p ui`");
  assertEq(w.checkLists, [["make test"], ["make test", "cargo test -p ui"], ["make test", "cargo test -p ui"]]);
});

Deno.test("plan validation checks the policy fields", () => {
  // Bad policy fields must be refused up front: a malformed or misspelled one would otherwise be silently ignored,
  // and an item's targeted tests would never run.
  const bad = { ...testPlan(1), reviewCharter: " ", workerRules: ["ok", "two\n## Finishing"] } as Plan;
  bad.items[0].checks = [""];
  (bad.items[0] as Record<string, unknown>).check = ["typo"];
  const got = planProblems(bad);
  for (const want of ["reviewCharter", "workerRules", "items[0].checks", "unknown key check"]) {
    if (!got.some((g) => g.includes(want))) throw new Error(`missing ${want} in ${got}`);
  }
  assertEq(planProblems(policyPlan()), []);
});

Deno.test("plan validation reports every problem", () => {
  const bad = {
    version: 1,
    goal: "",
    repo: "rel",
    trunk: "main",
    workflow: "w",
    context: "c",
    checks: [],
    items: [{ id: "A!", title: "t", spec: "s" }],
    limits: { bogus: 1 },
  };
  const got = planProblems(bad);
  for (const want of ["goal", "absolute", "items[0].id", "unknown limit bogus"]) {
    if (!got.some((g) => g.includes(want))) throw new Error(`missing ${want} in ${got}`);
  }
  assertEq(planProblems(testPlan()), []);
});

Deno.test("hook: inbox messages are delivered together with the nonce prefix; Stop is refused until the report parses, up to the cap", () => {
  const base = { nonce: "abc", blocksSoFar: 0, cap: 2, inbox: [] as string[] };
  const post = hookReply({ hook_event_name: "PostToolUse" }, { ...base, inbox: ["do X\n", "do Y"] });
  assertEq(post.consumeInbox, true);
  assertEq(
    (post.reply as { hookSpecificOutput: { additionalContext: string } }).hookSpecificOutput.additionalContext,
    "SUPERVISOR abc: do X\n\nSUPERVISOR abc: do Y",
  );
  assertEq(hookReply({ hook_event_name: "PostToolUse" }, base), {});
  const stop = hookReply({ hook_event_name: "Stop" }, base);
  if (!(stop.reply as { reason: string }).reason.startsWith("SUPERVISOR abc: ")) {
    throw new Error("stop reason must carry the prefix");
  }
  assertEq(hookReply({ hook_event_name: "Stop" }, { ...base, blocksSoFar: 2 }), {});
  assertEq(hookReply({ hook_event_name: "Stop" }, { ...base, report: done(1) }), {});
});

Deno.test("hook: events from other threads (sub agents) get no reply and consume nothing", () => {
  const x = { nonce: "abc", blocksSoFar: 0, cap: 2, inbox: ["do X"], mainThread: "main" };
  assertEq(hookReply({ hook_event_name: "PostToolUse", session_id: "sub" }, x), {});
  assertEq(hookReply({ hook_event_name: "Stop", session_id: "sub" }, x), {});
  assertEq(hookReply({ hook_event_name: "PostToolUse", session_id: "main" }, x).consumeInbox, true);
});

Deno.test("codexUsage takes the last turn.completed, which is the thread's running total", () => {
  const ev = [
    JSON.stringify({ type: "turn.completed", usage: { input_tokens: 5, cached_input_tokens: 1, output_tokens: 2 } }),
    JSON.stringify({ type: "turn.completed", usage: { input_tokens: 9, cached_input_tokens: 3, output_tokens: 4 } }),
    '{"type":"turn.compl',
  ].join("\n");
  assertEq(codexUsage(ev), { input: 9, cachedInput: 3, output: 4 });
});

/**
 * A scripted headless supervisor. `nexts` is what each turn leaves in next.json (undefined: nothing); `answers` is
 * consumed by the answerer (undefined: nobody can answer). Every supervisor message is kept in `messages`, and every
 * saved `pending` in `saved`, so tests can pin that each step was persisted before it was acted on.
 */
function fakeDrive(nexts: (string | undefined)[], answers: (string | undefined)[] = []) {
  const messages: string[] = [], calls: string[] = [], saved: (Pending | undefined)[] = [];
  const queue = [...nexts], aq = [...answers];
  const ds: DriverState = {
    version: 1,
    repo: "/repo",
    model: "m",
    effort: "e",
    turns: 0,
    maxTurns: DEFAULT_MAX_TURNS,
    pending: { kind: "turn", message: "go" },
    usage: { input: 0, cachedInput: 0, output: 0 },
  };
  const ops: DriverOps = {
    supervisorTurn(message, thread, turn) {
      messages.push(message);
      calls.push(thread === undefined ? "start" : "resume");
      return Promise.resolve({
        thread: "t1",
        code: 0,
        timedOut: false,
        usage: { input: turn * 100, cachedInput: 0, output: turn },
      });
    },
    takeNext: () => Promise.resolve(queue.shift()),
    async runRunner(started, markStarted) {
      calls.push(started === undefined ? "runner" : `runner after ${started}`);
      await markStarted();
      return { summary: "The runner exited with code 10.", status: "1. p1 [working]" };
    },
    answer(q) {
      calls.push(`answer ${q}`);
      return Promise.resolve({ answer: aq.shift() });
    },
  };
  const save = () => {
    saved.push(structuredClone(ds.pending));
    return Promise.resolve();
  };
  return { ds, ops, messages, calls, saved, drive: () => driveLoop(ds, ops, save) };
}

const nx = (o: unknown) => JSON.stringify(o);

Deno.test("drive: a question is answered, the runner's exit is reported back, and done ends the drive", async () => {
  const d = fakeDrive(
    [nx({ action: "ask", question: "approve?" }), nx({ action: "run" }), nx({ action: "done", report: "R" })],
    ["yes"],
  );
  assertEq(await d.drive(), { code: 0, message: "R" });
  assertEq(d.calls, ["start", "answer approve?", "resume", "runner", "resume"]);
  assertIncludes(d.messages[1], "yes");
  assertIncludes(d.messages[2], "exited with code 10");
  assertIncludes(d.messages[2], "1. p1 [working]");
  assertEq([d.ds.thread, d.ds.turns, d.ds.usage.input, d.ds.pending], ["t1", 3, 300, undefined]);
});

Deno.test("drive: every step is saved as pending before the driver acts on it", async () => {
  const d = fakeDrive([nx({ action: "run" }), nx({ action: "done", report: "R" })]);
  await d.drive();
  const kinds = d.saved.map((p) =>
    p === undefined ? "none" : p.kind === "runner" && p.started ? "runner-started" : p.kind
  );
  // The turn is saved (turn count) before it runs; the runner is saved as pending, then as started just before it
  // launches; its result is saved as the next turn's message before that turn runs.
  assertEq(kinds, ["turn", "turn", "runner", "runner-started", "turn", "turn", "turn", "none"]);
});

Deno.test("drive: a restarted driver with a started runner hands its start time to the runner", async () => {
  const d = fakeDrive([nx({ action: "done", report: "R" })]);
  d.ds.pending = { kind: "runner", started: "2026-11-05T00:00:00.000Z" };
  d.ds.thread = "t1";
  assertEq(await d.drive(), { code: 0, message: "R" });
  assertEq(d.calls, ["runner after 2026-11-05T00:00:00.000Z", "resume"]);
});

Deno.test("drive: a question nobody can answer stops the drive with the question pending", async () => {
  const d = fakeDrive([nx({ action: "ask", question: "which crate?" })], [undefined]);
  assertEq(await d.drive(), { code: DRIVE_WAITING, message: "which crate?" });
  assertEq(d.ds.pending, { kind: "answer", question: "which crate?" });
});

Deno.test("drive: an answerer that fails says so, and the question stays pending", async () => {
  const d = fakeDrive([nx({ action: "ask", question: "q?" })]);
  d.ops.answer = () => Promise.resolve({ error: "/bin/answer exited 2" });
  const out = await d.drive();
  assertEq(out.code, DRIVE_WAITING);
  assertIncludes(out.message, "/bin/answer exited 2");
  assertEq(d.ds.pending, { kind: "answer", question: "q?" });
});

Deno.test("drive: a missing next.json gets one nudge; two in a row end the drive with the nudge still pending", async () => {
  const ok = fakeDrive([undefined, nx({ action: "done", report: "R" })]);
  assertEq(await ok.drive(), { code: 0, message: "R" });
  assertIncludes(ok.messages[1], "next.json does not exist");
  const bad = fakeDrive([undefined, "{not json"]);
  assertEq((await bad.drive()).code, DRIVE_PROTOCOL);
  assertEq(bad.ds.pending?.kind, "turn");
});

Deno.test("drive: stop ends the drive with the supervisor's reason", async () => {
  const d = fakeDrive([nx({ action: "stop", reason: "goal is contradictory" })]);
  assertEq(await d.drive(), { code: DRIVE_STOPPED, message: "goal is contradictory" });
});

Deno.test("drive: the turn cap stops before a turn, keeps what is pending, and a raised cap continues", async () => {
  const d = fakeDrive([nx({ action: "run" }), nx({ action: "done", report: "R" })]);
  d.ds.maxTurns = 1;
  assertEq((await d.drive()).code, DRIVE_PROTOCOL);
  // The runner's result was not thrown away: it is the pending turn.
  assertEq(d.ds.pending?.kind, "turn");
  assertIncludes((d.ds.pending as { message: string }).message, "exited with code 10");
  d.ds.maxTurns = 5;
  assertEq(await d.drive(), { code: 0, message: "R" });
});

Deno.test("drive: a turn that records no usage keeps the earlier total, and a failed codex is named", async () => {
  const d = fakeDrive([undefined, undefined]);
  let n = 0;
  d.ops.supervisorTurn = () =>
    Promise.resolve(
      ++n === 1
        ? { thread: "t1", code: 0, timedOut: false, usage: { input: 500, cachedInput: 0, output: 5 } }
        : { thread: "t1", code: 1, timedOut: false },
    );
  const out = await d.drive();
  assertEq(d.ds.usage.input, 500);
  assertIncludes(out.message, "codex exited 1");
});

Deno.test("drive: a supervisor that never starts leaves the first message pending for a restart", async () => {
  const d = fakeDrive([undefined]);
  d.ops.supervisorTurn = () => Promise.resolve({ code: 1, timedOut: false });
  const out = await d.drive();
  assertEq(out.code, DRIVE_PROTOCOL);
  assertEq(d.ds.pending, { kind: "turn", message: "go" });
});

Deno.test("parseNext accepts the four actions and explains anything else, inherited keys included", () => {
  assertEq(parseNext(nx({ action: "run" })), { action: "run" });
  assertEq(parseNext(nx({ action: "ask", question: "q" })), { action: "ask", question: "q" });
  assertIncludes(parseNext(nx({ action: "ask" })) as string, '"question"');
  assertIncludes(parseNext(nx({ action: "wait" })) as string, "must be");
  assertIncludes(parseNext(nx({ action: "toString" })) as string, "must be");
});

Deno.test("a short-lived resource shortage only delays the next launch", async () => {
  // Builds and test runs fill disks and then clean up; a shortage that passes must cost minutes, not the run.
  const plan = testPlan(1);
  const w = fakeWorld(plan, { worker: () => done(1), reviews: [approve], resources: ["low disk", "low disk"] });
  assertEq(await w.run(), { done: true });
  assertEq(w.sleeps(), 2);
  assertEq(w.state.items[0].sessions, 1);
});

Deno.test("a lasting shortage escalates before the worker starts, without spending a session", async () => {
  // The supervisor is asleep, so the runner must stop launching and say why. The wait is bounded by
  // resourceWaitMinutes (one reading a minute), and counting the session would leave the item with less budget when
  // the supervisor runs it again after freeing space.
  const plan = { ...testPlan(1), limits: { resourceWaitMinutes: 3 } };
  const w = fakeWorld(plan, { worker: () => done(1), resources: Array(10).fill("2.0 GiB free on /") });
  const e = escalationOf(await w.run());
  assertEq([e.reason, e.detail], ["resources-low", "2.0 GiB free on /"]);
  assertEq(w.sleeps(), 3);
  assertEq(w.state.items[0].sessions, 0);
  assertEq(w.calls, []);
});

Deno.test("resources are checked before the checks and before the review too", async () => {
  // Checks and reviews are launches like any other: a full suite or a reviewer on a full disk fails for nothing.
  const plan = { ...testPlan(1), limits: { resourceWaitMinutes: 1 } };
  const beforeChecks = fakeWorld(plan, { worker: () => done(1), resources: [undefined, "low", "low"] });
  assertEq(escalationOf(await beforeChecks.run()).reason, "resources-low");
  assertEq(beforeChecks.calls, ["worker p1#1", "tree sha1"]);
  const beforeReview = fakeWorld(plan, { worker: () => done(1), resources: [undefined, undefined, "low", "low"] });
  assertEq(escalationOf(await beforeReview.run()).reason, "resources-low");
  assertEq(beforeReview.calls, ["worker p1#1", "tree sha1", "checks sha1"]);
});

Deno.test("resourceWaitMinutes 0 turns the guard off, and only that limit may be 0", async () => {
  // The off switch is for a machine whose readings are wrong or whose shortage is structural; with it set, no reading
  // may delay or stop anything.
  const plan = { ...testPlan(1), limits: { resourceWaitMinutes: 0 } };
  const w = fakeWorld(plan, { worker: () => done(1), reviews: [approve], resources: Array(10).fill("low") });
  assertEq(await w.run(), { done: true });
  assertEq(w.sleeps(), 0);
  assertEq(planProblems(plan), []);
  assertIncludes(planProblems({ ...testPlan(1), limits: { resourceWaitMinutes: -1 } }).join("\n"), "non-negative");
  assertIncludes(planProblems({ ...testPlan(1), limits: { sessionsPerItem: 0 } }).join("\n"), "positive");
});

Deno.test("a worker session killed for resources escalates and costs the item no budget", async () => {
  // The kill is the runner's doing, not the worker's failure. With one session per item, counting it would leave the
  // item nothing to resume with once the supervisor frees space. Nor is it a crash: a crash, a kill, and a crash are
  // not two crashes in a row.
  const plan = { ...testPlan(1), limits: { sessionsPerItem: 1 } };
  const w = fakeWorld(plan, { worker: () => done(1), reviews: [approve], kill: { worker: "0.5 GiB free on /" } });
  w.state.items[0].crashes = 1;
  const e = escalationOf(await w.run());
  assertEq(w.state.items[0].crashes, 0);
  assertEq(e.reason, "resources-low");
  assertIncludes(e.detail, "0.5 GiB free on /");
  prepareResume(w.state, e);
  assertEq(w.state.items[0].escalations, 0);
  assertEq(await w.run(), { done: true });
  assertEq(w.calls, ["worker p1#1", "worker p1#2", "tree sha1", "checks sha1", "review"]);
  // The fresh session hears why its predecessor stopped instead of starting the item over blind.
  assertIncludes(w.files.get("prompt:p1#2")!, "stopped by the runner");
});

Deno.test("a killed session's successor still gets the feedback the killed one was given", async () => {
  // The killed session may never have acted on a failing-check report; dropping it would make the next session redo
  // work the runner already knows is broken.
  const w = fakeWorld(testPlan(1), {
    worker: () => done(1),
    reviews: [approve],
    checksOk: () => w.calls.filter((c) => c.startsWith("checks")).length > 1,
    killWorkerSession: 2,
  });
  const e = escalationOf(await w.run());
  assertEq(e.reason, "resources-low");
  prepareResume(w.state, e);
  assertEq(await w.run(), { done: true });
  const third = w.files.get("prompt:p1#3")!;
  assertIncludes(third, "stopped by the runner");
  assertIncludes(third, "`make test` fails");
});

Deno.test("checks or a review killed for resources escalate instead of reaching the worker or the verdict", async () => {
  // A killed check run did not fail on the PR's merits, so feeding it to the worker as a failure would send it chasing
  // a bug that does not exist; a killed review likewise is neither a verdict nor a reviewer failure.
  const checks = fakeWorld(testPlan(1), { worker: () => done(1), kill: { checks: "0.5 GiB free on /tmp" } });
  const ce = escalationOf(await checks.run());
  assertEq(ce.reason, "resources-low");
  assertIncludes(ce.detail, "make test");
  assertEq(checks.state.items[0].pending, undefined);
  const review = fakeWorld(testPlan(1), { worker: () => done(1), reviews: [approve], kill: { review: "low memory" } });
  assertEq(escalationOf(await review.run()).reason, "resources-low");
  assertEq(review.calls, ["worker p1#1", "tree sha1", "checks sha1", "review"]);
  assertEq(review.state.items[0].reviewRounds, 0);
});

Deno.test("resuming after resources-low neither refills the budget nor counts an escalation", () => {
  // A full disk says nothing about how the item is going. Refilling would let repeated disk trouble hide a stuck item
  // from the session cap, and counting it would push the item toward the ask-the-user threshold for the machine's
  // sake.
  const state: State = { version: 1, nonce: "n", items: [{ ...emptyItem("p1"), sessions: 3, reviewRounds: 1 }] };
  prepareResume(state, { reason: "resources-low", item: "p1", detail: "d", at: "t" });
  assertEq([state.items[0].sessionsBase, state.items[0].reviewBase, state.items[0].escalations], [0, 0, 0]);
  prepareResume(state, { reason: "blocked", item: "p1", detail: "d", at: "t" });
  assertEq([state.items[0].sessionsBase, state.items[0].reviewBase, state.items[0].escalations], [3, 1, 1]);
});

Deno.test("resourceShortfall: soft limits for launches, hard limits for running steps", () => {
  // The percentage rules are capped by absolute amounts so a large, mostly full disk with plenty left is not short,
  // and the absolute floors scale down so a small filesystem (a tmpfs /tmp) is not short just for being small.
  const gib = 1024 * 1024;
  const disk = (totalGib: number, availGib: number, level?: "soft" | "hard") =>
    resourceShortfall(
      [{ mount: "/", paths: ["/d", "/e"], totalKb: totalGib * gib, availKb: availGib * gib }],
      undefined,
      level,
    );
  const mem = (totalGib: number, availGib: number, level?: "soft" | "hard") =>
    resourceShortfall([], { totalKb: totalGib * gib, availKb: availGib * gib }, level);
  assertEq(disk(100, 20), undefined);
  assertEq(disk(100, 4.99), "4.9 GiB free of 100.0 GiB on / (holding /d, /e)"); // rounded down, one line per mount
  assertIncludes(disk(100, 9)!, "/d"); // under 10% and under the 20 GiB cap
  assertEq(disk(1000, 90), undefined); // under 10%, but above the cap
  assertIncludes(disk(1000, 19)!, "/d");
  assertEq(disk(4, 2), undefined); // a 4 GiB tmpfs half full: the 5 GiB floor scales down to a quarter
  assertIncludes(disk(4, 0.9)!, "/d");
  assertEq(mem(64, 4), undefined); // under 10%, but not under 4 GiB
  assertIncludes(mem(64, 3)!, "memory");
  assertEq(mem(512, 40), undefined);
  assertEq(disk(100, 2, "hard"), undefined);
  assertIncludes(disk(100, 0.5, "hard")!, "/d");
  assertEq(disk(4, 0.5, "hard"), undefined); // the 1 GiB floor scales down to 5% of a small filesystem
  assertIncludes(disk(4, 0.1, "hard")!, "/d");
  assertEq(mem(64, 1.5, "hard"), undefined);
  assertIncludes(mem(64, 0.5, "hard")!, "memory");
  assertEq(mem(16, 0.9, "hard"), undefined); // under 1 GiB, but not under 3% of 16 GiB
});

Deno.test("parseDf, parseMeminfo, and parseCgroupMemory read the fields the guard needs", () => {
  // Misreading any of these silently turns the guard into a no-op or a permanent stop, so the edge cases are pinned.
  const header = "Filesystem     1024-blocks      Used Available Capacity Mounted on\n";
  assertEq(parseDf(header + "/dev/sda1  1258291200 970000000 245000000      80% /\n"), {
    totalKb: 1258291200,
    availKb: 245000000,
    mount: "/",
  });
  assertEq(parseDf(header + "//nas/my share  1000 600 400  60% /mnt/my share\n"), {
    totalKb: 1000,
    availKb: 400,
    mount: "/mnt/my share",
  });
  // Filled past the reserve, GNU df prints a negative Available; that is the fullest disk there is, not garbage.
  assertEq(parseDf(header + "/dev/sdb1 1000 1100 -100 100% /data\n"), { totalKb: 1000, availKb: 0, mount: "/data" });
  assertEq(parseDf(header + "tmpfs 0 0 0 - /x\n"), undefined);
  assertEq(parseDf(header), undefined);
  assertEq(parseDf("garbage"), undefined);
  assertEq(parseMeminfo("MemTotal:       98000000 kB\nMemFree: 1 kB\nMemAvailable:   56000000 kB\n"), {
    totalKb: 98000000,
    availKb: 56000000,
  });
  assertEq(parseMeminfo("MemTotal: 98000000 kB\n"), undefined);
  const g = 1024 * 1024 * 1024;
  assertEq(parseCgroupMemory("max\n", "123\n", ""), undefined);
  assertEq(parseCgroupMemory(`${8 * g}\n`, `${4 * g}\n`, "anon 1\n"), {
    totalKb: 8 * 1024 * 1024,
    availKb: 4 * 1024 * 1024,
  });
  assertEq(parseCgroupMemory("1024\n", "4096\n", ""), { totalKb: 1, availKb: 0 });
  // After a build, page cache fills the cgroup up to its limit. The inactive part is reclaimable and is not short.
  assertEq(
    parseCgroupMemory(`${8 * g}\n`, `${7.8 * g}\n`, `anon ${g}\nfile ${6.5 * g}\ninactive_file ${6 * g}\n`),
    { totalKb: 8 * 1024 * 1024, availKb: 6.2 * 1024 * 1024 },
  );
});

Deno.test("cgroupDirs lists this process's cgroup and every ancestor up to the mount root", () => {
  // A limit on any ancestor (a systemd slice) caps this process too; reading only the mount root, which on a host has
  // no memory.max at all, would never see a limit.
  assertEq(cgroupDirs("0::/user.slice/app.slice/x.scope\n", "/cg"), [
    "/cg/user.slice/app.slice/x.scope",
    "/cg/user.slice/app.slice",
    "/cg/user.slice",
    "/cg",
  ]);
  assertEq(cgroupDirs("0::/\n", "/cg"), ["/cg"]); // inside a container's cgroup namespace
  assertEq(cgroupDirs("12:memory:/x\n", "/cg"), []); // cgroup v1 only
  assertEq(cgroupDirs("", "/cg"), []);
});

Deno.test("status reports a resource wait in progress, and only while it lasts", () => {
  // A runner holding off on a full disk otherwise looks just like one with a busy worker.
  const ev = (event: string, detail?: string) => JSON.stringify({ t: "T", item: "p1", event, detail });
  assertEq(resourceWait([ev("worker-end"), ev("resources-low", "low disk")].join("\n")), "since T: low disk");
  assertEq(
    resourceWait([ev("resources-low", "low disk"), ev("resources-unreadable", "/x")].join("\n")),
    "since T: low disk",
  );
  assertEq(resourceWait([ev("resources-low", "low disk"), ev("resources-ok")].join("\n")), undefined);
  assertEq(resourceWait([ev("resources-low", "low disk"), ev("escalate")].join("\n")), undefined);
  assertEq(resourceWait(""), undefined);
  const plan = testPlan(1);
  const state: State = { version: 1, nonce: "n", items: [emptyItem("p1")] };
  assertIncludes(
    statusText(plan, state, undefined, undefined, "since T: low disk"),
    "waiting for disk or memory since T",
  );
  assertEq(statusText(plan, state, undefined).includes("waiting"), false);
});
