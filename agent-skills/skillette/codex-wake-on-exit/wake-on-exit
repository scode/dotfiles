/** A supported queue can still reject delivery; retain that actual outcome without retrying or claiming a wake. */
Deno.test("enqueue rejection records queue-failed with diagnostics and no retry", async () => {
  const { directory, watcher, context } = await fixture();
  const dir = join(directory, "run");
  await Deno.writeTextFile(
    context.queue.at(-1)!,
    String.raw`
if (Deno.args.includes("--help")) console.log("--thread --message");
else {
  Deno.writeTextFileSync(${JSON.stringify(join(directory, "attempts.log"))}, "attempt\n", { append: true });
  console.error("queue rejected sentinel");
  Deno.exit(9);
}
`,
  );
  try {
    await start(dir, [Deno.execPath(), "run", "-A", watcher, "250", "0"], context);
    const state = await until(() => {
      const current = owned(dir, context.thread).state;
      return current.phase === "queue-failed" ? current : undefined;
    });
    assertEquals(state.result?.code, 0);
    assertEquals(state.delivery?.code, 9);
    assertEquals(state.delivery?.stderr, "queue rejected sentinel\n");
    assertEquals(Deno.readTextFileSync(join(directory, "attempts.log")), "attempt\n");
    assertEquals(exists(join(directory, "queued.json")), false);
  } finally {
    if (exists(join(dir, "state.json"))) await stop(dir, context.thread);
    Deno.removeSync(directory, { recursive: true });
  }
});

