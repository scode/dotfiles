/**
 * Supersession must stop a live foreign watcher through its own runner, so the old
 * thread is never queued a wake for a flow it no longer runs.
 */
Deno.test("supersede cancels a live foreign watcher without queueing its owner", async () => {
  const { directory, watcher, context } = await fixture();
