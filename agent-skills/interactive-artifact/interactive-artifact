#!/bin/sh
# Agents run this entrypoint on development hosts and on copied skill trees alike. It runs the compiled helper built by
# `dotfiles build-helpers` when one exists for this platform, and otherwise the TypeScript source with Deno. The
# selection stays outside Deno so that a host with the compiled helper needs no Deno installed. The rules match the
# persistent-review launcher; see "Optional Compiled Skill Helpers" in the repository's SPEC.md.
case "$0" in
    */*) helper_dir=${0%/*} ;;
    *) helper_dir=. ;;
esac
helper_dir=$(CDPATH= cd -P "$helper_dir" && pwd) || {
    echo 'interactive-artifact: could not resolve the skill directory; no command was executed.' >&2
    exit 2
}

platform=
platform_info=$(uname -sm) || {
    echo 'interactive-artifact: could not determine the helper platform; no command was executed.' >&2
    exit 2
}
case "$platform_info" in
    'Linux x86_64') platform=linux-x64 ;;
    'Linux aarch64'|'Linux arm64') platform=linux-arm64 ;;
    'Darwin x86_64') platform=darwin-x64 ;;
    'Darwin arm64') platform=darwin-arm64 ;;
esac

if [ -n "$platform" ]; then
    binary=$helper_dir/bin/$platform/interactive-artifact
    # Links below the resolved skill root could make the binary validate another
    # tree's source. Installed skill-directory links are already resolved above.
    for path in "$helper_dir/bin" "$helper_dir/bin/$platform" "$binary"; do
        if [ -L "$path" ]; then
            echo "interactive-artifact: compiled helper paths must not be symlinks: $path. Rebuild helpers before syncing this skill." >&2
            exit 2
        fi
    done
    # Symlinks were rejected above. A missing execute bit or corrupt executable is a deployment
    # failure. Falling back here would hide it and could rerun a partially completed command.
    if [ -e "$binary" ]; then
        exec "$binary" "$@"
        exit 1
    fi
fi

if ! command -v deno >/dev/null 2>&1; then
    echo 'interactive-artifact: no matching compiled helper and Deno is unavailable. Build helpers before syncing this skill.' >&2
    exit 2
fi
exec deno run --no-config --no-lock -A "$helper_dir/interactive-artifact.ts" "$@"
