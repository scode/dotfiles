#!/bin/bash
set -euo pipefail

USER_CONTEXT=""
if [ $# -gt 0 ]; then
    USER_CONTEXT="

Additional context from the user:
$*"
fi

DIFF_FILE=$(mktemp /tmp/gemini-review-XXXXXX.diff)
trap 'rm -f "$DIFF_FILE"' EXIT

git diff HEAD > "$DIFF_FILE"

if [ ! -s "$DIFF_FILE" ]; then
    if git diff main...HEAD > "$DIFF_FILE" 2>/dev/null && [ -s "$DIFF_FILE" ]; then
        : # success with main
    elif git diff master...HEAD > "$DIFF_FILE" 2>/dev/null && [ -s "$DIFF_FILE" ]; then
        : # success with master
    else
        echo "No changes to review (no uncommitted changes and no branch diff against main/master)."
        exit 0
    fi
fi

gemini -s -p "Review the diff in $DIFF_FILE for:
- Bugs and correctness issues (logic errors, edge cases, resource leaks)
- Consistency with the rest of the codebase (read related files if needed for context)
- Idiomatic usage for the language
- Clarity of intent
- Places where comments are needed to explain non-obvious behavior

Be specific about any issues found, including file and location.$USER_CONTEXT" --allowed-tools "read_file,read_many_files,glob,search_file_content"
