+    #[test]
+    fn test_tampered_ciphertext() {
+        let mut payload = small_payload(b"pw", b"secret");
+        *payload.last_mut().unwrap() ^= 0x01;
+        let err = decrypt(b"pw", &payload).expect_err("expected authentication failure");
